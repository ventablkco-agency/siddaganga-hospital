---
import IconSlideButton from './ui/IconSlideButton.astro';
import RetroGrid from './ui/RetroGrid.astro';
import Icon from './icons/Icon.astro';
const appointmentUrl = 'https://wa.me/919591799099';
const phoneUrl = 'tel:+919591799099';
const secondPhoneUrl = 'tel:+919620513688';
const emailUrl = 'mailto:siddagangahospitalrnr@gmail.com';
const mapsUrl = 'https://www.google.com/maps/search/?api=1&query=D.K.+Siddappa+Building,+Mruthyunjaya+Nagar,+Ranebennur,+Karnataka';
---
<footer class="site-footer" id="contact">
  <section class="footer-cta" aria-labelledby="footer-title">
    <RetroGrid className="footer-retro-grid" angle={65} cellSize={60} opacity={0.62} lightLineColor="rgba(23, 100, 245, 0.14)" />
    <span class="footer-kicker">SIDDAGANGA HOSPITAL · RANEBENNUR</span>
    <h2 id="footer-title">Expert care. <strong>Built around people.</strong></h2>
    <p>24×7 hospital care, specialist consultation and advanced diagnostics — with every patient treated with attention and respect.</p>
    <IconSlideButton href={appointmentUrl} label="Make an appointment" newTab={true} variant="blue" />
  </section>

  <section class="footer-blue" aria-label="Siddaganga Hospital footer navigation">
    <div class="footer-top">
      <div class="footer-brand">
        <a class="brand-lockup" href="/" aria-label="Siddaganga Hospital home"><span class="brand-mark">SGH</span><span class="brand-name">Siddaganga<br /><small>Hospital</small></span></a>
        <p>Specialist care in<br />Ranebennur, Karnataka.</p>
        <div class="contact-orbit" aria-label="Hospital contact and social links">
          <a href={phoneUrl} aria-label="Call Siddaganga Hospital" title="Call"><Icon name="phone" size={15} strokeWidth={1.8} /></a>
          <a href={appointmentUrl} target="_blank" rel="noreferrer" aria-label="WhatsApp Siddaganga Hospital" title="WhatsApp"><span class="whatsapp-mark">WA</span></a>
          <a href={emailUrl} aria-label="Email Siddaganga Hospital" title="Email"><Icon name="email" size={15} strokeWidth={1.8} /></a>
          <a href={mapsUrl} target="_blank" rel="noreferrer" aria-label="Siddaganga Hospital location" title="Location"><Icon name="location" size={15} strokeWidth={1.8} /></a>
          <span class="social-placeholder" aria-label="Instagram social link will be connected when the hospital account URL is provided" title="Instagram"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="4" /><circle cx="12" cy="12" r="3.5" /><circle cx="17.2" cy="6.8" r="1" class="fill" /></svg></span>
          <span class="social-placeholder" aria-label="Facebook social link will be connected when the hospital account URL is provided" title="Facebook"><svg viewBox="0 0 24 24" aria-hidden="true"><path class="fill" d="M13.5 21v-8h2.7l.4-3h-3.1V8.1c0-.9.3-1.6 1.7-1.6h1.8V3.8c-.3 0-1.4-.1-2.6-.1-2.6 0-4.3 1.6-4.3 4.4V10H7.4v3h2.7v8h3.4Z" /></svg></span>
        </div>
        <span class="social-note">Instagram &amp; Facebook links can be connected when the hospital account URLs are provided.</span>
      </div>

      <nav class="footer-column" aria-label="Care links">
        <h3>Care</h3>
        <a href="#services">Our services</a><a href="#services">Why choose us</a><a href="#doctors">Our doctors</a><a href="#reviews">Patient reviews</a><a href="#contact">Emergency care</a>
      </nav>

      <nav class="footer-column" aria-label="Hospital links">
        <h3>Hospital</h3>
        <a href="#services">About SGH</a><a href="#services">Facilities</a><a href="#doctors">Specialists</a><a href="#contact">Contact</a><a href="#contact">Book an appointment</a><a href="/careers">Careers</a>
      </nav>

      <div class="footer-contact">
        <h3>Get in touch</h3>
        <a href={phoneUrl}><Icon name="phone" size={15} strokeWidth={1.8} />95917 99099</a>
        <a href={secondPhoneUrl}><Icon name="phone" size={15} strokeWidth={1.8} />96205 13688</a>
        <a href={emailUrl}><Icon name="email" size={15} strokeWidth={1.8} />siddagangahospitalrnr@gmail.com</a>
        <a href={mapsUrl} target="_blank" rel="noreferrer"><Icon name="location" size={15} strokeWidth={1.8} />Ranebennur, Karnataka</a>
      </div>
    </div>

    <div class="footer-bottom">
      <div class="footer-wordmark" aria-hidden="true">Siddaganga</div>
      <div class="footer-meta">
        <span>© {new Date().getFullYear()} Siddaganga Hospital. All rights reserved.</span>
        <span>Designed &amp; developed by <a href="https://ventablk.co" target="_blank" rel="noreferrer">ventablk.co</a></span>
      </div>
    </div>
  </section>
</footer>

<style>
.site-footer{--blue:#1764f5;--ink:#101a2b;position:relative;z-index:0;background:#f7f9fc;overflow:hidden}.footer-cta{position:relative;z-index:2;min-height:42svh;box-sizing:border-box;padding:clamp(62px,8vw,105px) 24px 70px;display:flex;flex-direction:column;align-items:center;text-align:center;background:#f7f9fc;isolation:isolate;overflow:hidden}.footer-retro-grid{inset:4% 0 0;z-index:0;opacity:.62;mask-image:linear-gradient(to bottom,transparent 0%,rgba(0,0,0,.35) 16%,#000 42%,transparent 92%);-webkit-mask-image:linear-gradient(to bottom,transparent 0%,rgba(0,0,0,.35) 16%,#000 42%,transparent 92%)}.footer-kicker,.footer-cta h2,.footer-cta p,.footer-cta :global(.icon-slide-button){position:relative;z-index:2}.footer-kicker{display:inline-flex;padding:5px 10px;border-radius:999px;background:#fff;color:#7b8799;font-size:10px;letter-spacing:.06em;box-shadow:0 3px 12px rgba(30,54,90,.05)}.footer-cta h2{max-width:820px;margin:18px 0 15px;color:var(--ink);font-family:var(--font-display);font-size:clamp(48px,5.6vw,84px);line-height:.94;letter-spacing:-.065em;font-weight:700}.footer-cta h2 strong{font-weight:400}.footer-cta p{margin:0 0 25px;max-width:680px;color:#59687c;font-size:14px;line-height:1.5}
.footer-blue{position:relative;z-index:1;padding:clamp(52px,5vw,78px) clamp(28px,5vw,76px) 28px;box-sizing:border-box;color:#fff;overflow:hidden;background:radial-gradient(circle at 50% 0%,rgba(132,180,255,.72) 0,rgba(65,126,255,.32) 23%,rgba(23,100,245,0) 48%),linear-gradient(180deg,#2f7bf8 0%,#1764f5 40%,#0e59ee 100%);border-radius:44px 44px 0 0}.footer-blue:before{content:'';position:absolute;left:0;right:0;top:-170px;height:280px;background:radial-gradient(ellipse at center,rgba(255,255,255,.56),rgba(255,255,255,0) 68%);filter:blur(22px);pointer-events:none}.footer-top{position:relative;z-index:2;display:grid;grid-template-columns:1.45fr .8fr .8fr 1.15fr;gap:clamp(26px,4vw,72px);max-width:1420px;margin:0 auto}.footer-brand{min-width:0}.brand-lockup{display:inline-flex;align-items:center;gap:10px;color:#fff;text-decoration:none}.brand-mark{width:30px;height:30px;border-radius:8px;display:grid;place-items:center;background:#fff;color:var(--blue);font-size:7px;font-weight:800;box-shadow:0 5px 18px rgba(4,44,130,.12)}.brand-name{font-size:28px;line-height:.78;font-weight:700;letter-spacing:-.045em}.brand-name small{font-size:10px;letter-spacing:.13em;font-weight:600}.footer-brand>p{margin:16px 0 21px;color:rgba(255,255,255,.82);font-size:13px;line-height:1.3}.contact-orbit{display:flex;gap:9px;flex-wrap:wrap}.contact-orbit a,.social-placeholder{width:36px;height:36px;border:1px solid rgba(255,255,255,.34);border-radius:50%;display:grid;place-items:center;color:#fff;text-decoration:none;background:rgba(255,255,255,.06);transition:transform .2s ease,background .2s ease}.contact-orbit a:hover{transform:translateY(-2px);background:rgba(255,255,255,.14)}.contact-orbit svg,.footer-contact svg{width:15px;height:15px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}.social-placeholder{opacity:.62;cursor:default}.social-placeholder svg{stroke:currentColor}.social-placeholder .fill{fill:currentColor;stroke:none}.whatsapp-mark{font-size:8px;font-weight:800;letter-spacing:-.04em}.social-note{display:block;margin-top:9px;max-width:285px;color:rgba(255,255,255,.46);font-size:8px;line-height:1.35}.footer-column,.footer-contact{display:flex;flex-direction:column;align-items:flex-start;gap:11px}.footer-column h3,.footer-contact h3{margin:0 0 7px;color:rgba(255,255,255,.98);font-size:13px;font-weight:700}.footer-column a,.footer-contact a{color:rgba(255,255,255,.78);text-decoration:none;font-size:12px;line-height:1.3;transition:color .2s ease}.footer-column a:hover,.footer-contact a:hover{color:#fff}.footer-contact a{display:flex;align-items:center;gap:8px;font-size:13px}.footer-contact svg{flex:0 0 15px;opacity:.86}.footer-bottom{position:relative;z-index:2;max-width:1420px;margin:clamp(70px,9vw,130px) auto 0;overflow:visible}.footer-wordmark{width:100%;color:#fff;font-family:var(--font-display);font-size:clamp(90px,15.2vw,230px);line-height:.78;letter-spacing:-.09em;font-weight:700;white-space:nowrap;overflow:visible}.footer-meta{display:flex;justify-content:space-between;align-items:center;gap:24px;margin-top:28px;padding:18px 0 4px;border-top:1px solid rgba(255,255,255,.18);color:rgba(255,255,255,.62);font-size:11px;line-height:1.4}.footer-meta a{color:#fff;text-decoration:none;font-weight:600}.footer-meta a:hover{text-decoration:underline}
@media(max-width:1050px){.footer-top{grid-template-columns:1.2fr 1fr 1fr;gap:40px}.footer-contact{grid-column:2/-1}.footer-wordmark{font-size:clamp(82px,14vw,180px)}}
@media(max-width:700px){.footer-cta{min-height:46svh;padding:58px 22px 66px}.footer-cta h2{font-size:clamp(44px,10vw,60px)}.footer-cta p{font-size:13px;max-width:540px}.footer-blue{padding:40px 22px 22px;border-radius:28px 28px 0 0}.footer-top{grid-template-columns:1fr 1fr;gap:34px 24px}.footer-brand{grid-column:1/-1}.footer-contact{grid-column:1/-1}.brand-name{font-size:25px}.footer-column,.footer-contact{gap:10px}.footer-column a,.footer-contact a{font-size:12px}.footer-bottom{margin-top:72px}.footer-wordmark{font-size:clamp(56px,17vw,110px);line-height:.82;white-space:nowrap;letter-spacing:-.085em}.footer-meta{margin-top:24px;flex-direction:column;align-items:flex-start;gap:8px;font-size:10px}.social-note{max-width:100%;font-size:8px}}
@media(max-width:380px){.footer-cta{padding-inline:18px}.footer-blue{padding-inline:18px}.footer-top{gap:28px 18px}.footer-column a,.footer-contact a{font-size:11px}.footer-wordmark{font-size:16.5vw}.footer-meta{font-size:9px}.contact-orbit{gap:7px}.contact-orbit a,.social-placeholder{width:34px;height:34px}}
</style>
