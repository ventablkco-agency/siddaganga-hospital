---
import IconSlideButton from '../ui/IconSlideButton.astro';
---

<div class="hero-body">
  <div class="hero-body__copy">
    <p class="eyebrow">SIDDAGANGA HOSPITAL · RANEBENNUR</p>

    <h1>
      <span>Heart &amp;</span>
      <span><em>Diabetes</em>, in <strong>Sync</strong></span>
    </h1>

    <p class="intro">
      Specialist care, advanced diagnostics and a team that listens carefully to every patient.
    </p>

    <IconSlideButton
      href="https://wa.me/919591799099"
      label="Book Appointment"
      newTab={true}
      variant="blue"
    />
  </div>

  <div class="hero-body__right-copy">
    <h2>With Specialist<br />Technology</h2>
    <p>
      The latest diagnostic equipment, paired with a team that never rushes a conversation — because every patient deserves both.
    </p>
  </div>

  <div class="hero-body__hands" aria-hidden="true">
    <div class="hero-body__hand-glow"></div>
    <img class="hand hand--clinician" src="/assets/hero/clinician-hand.png" alt="" />
    <img class="hand hand--patient" src="/assets/hero/patient-hand.png" alt="" />
  </div>

  <aside class="care-panel" aria-label="Siddaganga Hospital care highlights">
    <div class="care-panel__media" aria-hidden="true">
      <div class="care-panel__image-slot">
        <span class="care-panel__media-kicker">SIDDAGANGA</span>
        <strong>Hospital</strong>
        <span class="care-panel__media-meta">Ranebennur · Karnataka</span>
        <img src="/assets/brand/siddaganga-hospital.svg" alt="" />
        <span class="care-panel__media-mark"></span>
      </div>
    </div>

    <div class="care-panel__content">
      <div class="care-panel__topline">
        <span>care highlights</span>
        <i aria-hidden="true"></i>
      </div>

      <div class="care-highlights">
        <div class="care-highlight">
          <strong>24×7</strong>
          <span>Emergency</span>
        </div>
        <div class="care-highlight">
          <strong>Lab</strong>
          <span>On-site diagnostics</span>
        </div>
        <div class="care-highlight">
          <strong>2D Echo</strong>
          <span>ECG support</span>
        </div>
      </div>
    </div>
  </aside>

  <div class="service-pills" aria-label="Hospital highlights">
    <span><b>♧</b>24×7 Emergency</span>
    <span><b>⌬</b>On-site Lab</span>
    <span><b>♙</b>Family Care</span>
  </div>

  <div class="feedback" aria-hidden="true">
    <p>We appreciate every feedback<br />because it inspires us to<br />become better.</p>
    <div class="feedback__avatars">
      <span></span><span></span><span></span>
    </div>
  </div>

  <div class="hero-arrow" aria-hidden="true">→</div>
</div>

<style>
.hero-body{
  position:relative;
  width:calc(100% - clamp(20px, 2.4vw, 36px));
  margin:clamp(10px, 1.2vw, 18px) auto;
  min-height:calc(100svh - clamp(20px, 2.4vw, 36px));
  overflow:hidden;
  isolation:isolate;
  border-radius:clamp(28px, 2.8vw, 44px);
  background:
    radial-gradient(ellipse at 68% 18%,rgba(255,255,255,.25) 0%,rgba(255,255,255,.10) 27%,transparent 56%),
    radial-gradient(ellipse at 88% 80%,rgba(255,255,255,.08),transparent 42%),
    var(--color-brand);
}

/* One hero surface only. The white field is painted directly inside the
   hero-body; there is deliberately no second white/blue card. */
.hero-body::before{
  content:"";
  position:absolute;
  z-index:0;
  inset:-8% auto -8% -5%;
  width:62%;
  background:var(--color-white);
  clip-path:ellipse(78% 70% at 16% 50%);
  pointer-events:none;
}

.hero-body__copy{
  position:absolute;
  z-index:10;
  left:clamp(28px, 3.6vw, 56px);
  top:clamp(150px, 23vh, 230px);
  width:min(52vw, 720px);
}

.eyebrow{
  margin:0 0 clamp(16px, 1.6vw, 24px);
  color:var(--text-secondary);
  font-size:clamp(9px,.7vw,11px);
  line-height:1;
  font-weight:500;
  letter-spacing:.17em;
  text-transform:uppercase;
}

h1{
  margin:0;
  width:100%;
  color:var(--color-ink);
  font-family:var(--font-display);
  font-size:clamp(3.5rem, 6.2vw, 5.5rem);
  line-height:.9;
  letter-spacing:var(--track-display);
  font-weight:800;
}

h1 span{display:block}
h1 em{font-style:normal;color:var(--color-brand)}
h1 strong{font-weight:800;color:var(--color-ink)}

.intro{
  max-width:clamp(300px, 30vw, 420px);
  margin:clamp(20px, 2.2vw, 32px) 0 clamp(20px, 2.2vw, 32px);
  color:var(--text-secondary);
  font-size:clamp(12px, .9vw, 14px);
  line-height:1.55;
}

.hero-body__right-copy{
  position:absolute;
  z-index:10;
  left:clamp(57%, 58vw, 62%);
  top:clamp(190px, 23vh, 250px);
  width:min(32vw, 480px);
  color:var(--color-white);
}

.hero-body__right-copy h2{
  margin:0 0 clamp(22px, 2.1vw, 32px);
  font-family:var(--font-display);
  font-size:clamp(2.25rem, 3.65vw, 3.4rem);
  line-height:.9;
  letter-spacing:var(--track-display);
  font-weight:700;
}

.hero-body__right-copy p{
  margin:0;
  width:100%;
  font-size:clamp(13px, 1.35vw, 21px);
  line-height:1.08;
  color:var(--color-white);
}

.hero-body__hands{
  position:absolute;
  z-index:7;
  inset:0;
  pointer-events:none;
}

.hero-body__hand-glow{
  position:absolute;
  z-index:0;
  right:3%;
  top:7%;
  width:58%;
  height:58%;
  border-radius:50%;
  background:radial-gradient(circle,var(--brand-22) 0%,rgba(255,255,255,.18) 40%,transparent 72%);
}

.hand{
  position:absolute;
  display:block;
  max-width:none;
  object-fit:contain;
  filter:none;
  will-change:transform;
}

.hand--clinician{
  z-index:4;
  width:clamp(48%, 61vw, 68%);
  right:clamp(-9%, -5vw, -2%);
  top:clamp(20%, 24vh, 29%);
  animation:clinicianFloat 7s ease-in-out infinite;
}

.hand--patient{
  z-index:6;
  width:clamp(48%, 61vw, 69%);
  left:clamp(-10%, -5vw, -2%);
  top:clamp(31%, 34vh, 40%);
  animation:patientFloat 7s ease-in-out -1s infinite;
}

.care-panel{
  position:absolute;
  z-index:20;
  left:clamp(24px, 3.2vw, 52px);
  bottom:clamp(14px, 1.8vw, 28px);
  display:flex;
  align-items:stretch;
  width:min(clamp(430px, 39vw, 600px), calc(100% - 48px));
  min-height:clamp(132px, 10vw, 158px);
  padding:clamp(9px, .85vw, 14px);
  gap:clamp(16px, 1.8vw, 26px);
  border:1px solid rgba(11,10,10,.06);
  border-radius:clamp(16px, 1.4vw, 22px);
  background:var(--color-white);
  box-shadow:var(--shadow-md);
}

.care-panel__media{
  position:relative;
  width:clamp(130px, 11.5vw, 174px);
  min-height:clamp(110px, 8.6vw, 132px);
  flex:0 0 auto;
  overflow:hidden;
  border-radius:var(--radius-sm);
  background:var(--color-bg);
}

.care-panel__image-slot{
  position:absolute;
  inset:0;
  display:flex;
  flex-direction:column;
  justify-content:flex-end;
  padding:clamp(12px, 1.1vw, 18px);
  overflow:hidden;
  background:
    radial-gradient(circle at 76% 22%,var(--brand-22),transparent 28%),
    linear-gradient(145deg,var(--color-bg),var(--brand-06));
  color:var(--color-ink);
}

.care-panel__image-slot::before{
  content:"";
  position:absolute;
  inset:10%;
  border:1px solid var(--brand-12);
  border-radius:28% 72% 72% 28% / 35% 35% 65% 65%;
}

.care-panel__image-slot img{
  position:absolute;
  top:14px;
  right:14px;
  width:clamp(58px, 5vw, 78px);
  height:auto;
  opacity:.12;
  filter:grayscale(1);
}

.care-panel__media-kicker,
.care-panel__media-meta{
  position:relative;
  z-index:2;
  font-size:clamp(7px,.58vw,9px);
  line-height:1.25;
  letter-spacing:.12em;
  text-transform:uppercase;
}

.care-panel__media-kicker{color:var(--color-brand);font-weight:700}
.care-panel__media strong{position:relative;z-index:2;margin-top:2px;font-family:var(--font-display);font-size:clamp(22px,2vw,30px);line-height:.95;letter-spacing:-.04em}
.care-panel__media-meta{margin-top:5px;color:var(--text-secondary);letter-spacing:.02em;text-transform:none}
.care-panel__media-mark{position:absolute;right:12px;bottom:12px;width:8px;height:8px;border-radius:50%;background:var(--color-brand);box-shadow:0 0 0 6px var(--brand-12)}

.care-panel__content{display:flex;flex:1;min-width:0;flex-direction:column;justify-content:center;padding-right:clamp(4px, .6vw, 10px)}

.care-panel__topline{display:flex;align-items:center;justify-content:space-between;gap:14px;margin-bottom:clamp(16px, 1.4vw, 22px);color:var(--color-ink);font-size:clamp(9px,.72vw,11px);font-weight:500;white-space:nowrap}
.care-panel__topline i{display:block;width:28px;height:6px;flex:0 0 auto;border-radius:var(--radius-pill);background:var(--brand-12)}
.care-panel__topline i::after{content:"";display:block;width:14px;height:6px;border-radius:inherit;background:var(--color-brand)}

.care-highlights{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(12px,1.4vw,24px)}
.care-highlight{position:relative;min-width:0}
.care-highlight:not(:first-child)::before{content:"";position:absolute;left:clamp(-13px,-.9vw,-8px);top:0;width:1px;height:48px;background:var(--line)}
.care-highlight strong{display:block;margin:0 0 5px;color:var(--color-brand);font-family:var(--font-display);font-size:clamp(20px,1.9vw,30px);line-height:1;font-weight:700;letter-spacing:-.04em}
.care-highlight span{display:block;color:var(--color-ink);font-size:clamp(8px,.67vw,10px);line-height:1.2}

.service-pills{
  position:absolute;
  z-index:18;
  right:clamp(7%, 8vw, 11%);
  bottom:clamp(42px, 5.6vw, 70px);
  display:flex;
  gap:clamp(8px, .9vw, 14px);
}

.service-pills span{
  display:inline-flex;
  align-items:center;
  gap:9px;
  padding:clamp(11px,1vw,15px) clamp(17px,1.5vw,23px);
  border:1px solid rgba(255,255,255,.4);
  border-radius:var(--radius-pill);
  background:rgba(255,255,255,.13);
  color:var(--color-white);
  font-size:clamp(9px,.72vw,11px);
  white-space:nowrap;
  backdrop-filter:blur(12px);
}

.service-pills b{font-size:14px;font-weight:400;color:var(--color-white)}

.feedback{position:absolute;z-index:18;right:clamp(24px,3vw,48px);bottom:clamp(12px,1.7vw,24px);color:var(--color-white);text-align:right}
.feedback p{margin:0 0 10px;font-size:clamp(7px,.6vw,9px);line-height:1.35}
.feedback__avatars{display:flex;justify-content:flex-end}
.feedback__avatars span{width:clamp(24px,2vw,31px);height:clamp(24px,2vw,31px);margin-left:-7px;border:2px solid rgba(255,255,255,.86);border-radius:50%;background:var(--color-bg)}
.feedback__avatars span:nth-child(2){background:var(--brand-12)}
.feedback__avatars span:nth-child(3){background:var(--brand-22)}
.hero-arrow{position:absolute;z-index:18;right:clamp(120px,13vw,190px);bottom:clamp(22px,2.2vw,34px);color:var(--color-white);font-size:clamp(22px,2vw,28px);font-weight:300}

@keyframes clinicianFloat{0%,100%{transform:translate3d(0,0,0)}50%{transform:translate3d(-7px,6px,0)}}
@keyframes patientFloat{0%,100%{transform:translate3d(0,0,0)}50%{transform:translate3d(7px,-5px,0)}}

@media (max-width:1100px){
  .hero-body__copy{width:min(50vw,620px)}
  .hero-body__right-copy{left:57%;width:35%}
  .service-pills{right:5%;transform:scale(.9);transform-origin:right bottom}
  .feedback{display:none}
  .care-panel{width:min(520px,calc(100% - 40px))}
}

@media (max-width:860px){
  .hero-body{min-height:calc(100svh - 16px);border-radius:28px}
  .hero-body::before{inset:-8% auto -8% -15%;width:90%;clip-path:ellipse(82% 66% at 12% 50%)}
  .hero-body__copy{top:18%;left:28px;width:calc(100% - 56px)}
  h1{font-size:clamp(3rem,10vw,4.8rem)}
  .intro{max-width:420px}
  .hero-body__right-copy{left:28px;top:auto;bottom:36%;width:calc(100% - 56px);max-width:520px}
  .hero-body__right-copy h2{font-size:clamp(2rem,7vw,3rem)}
  .hero-body__right-copy p{font-size:clamp(12px,2vw,15px);max-width:480px}
  .hand--clinician{width:72%;right:-12%;top:43%}
  .hand--patient{width:78%;left:-20%;top:52%}
  .care-panel{left:20px;right:20px;bottom:18px;width:auto;min-height:128px}
  .care-panel__media{width:112px;min-height:100px}
  .care-highlights{gap:12px}
  .care-highlight:not(:first-child)::before{left:-7px}
  .service-pills{display:none}
  .hero-arrow{display:none}
}

@media (max-width:600px){
  .hero-body{width:calc(100% - 20px);margin:10px auto;border-radius:22px}
  .hero-body::before{inset:-8% auto -8% -24%;width:120%;clip-path:ellipse(74% 58% at 14% 50%)}
  .hero-body__copy{top:15%;left:22px;width:calc(100% - 44px)}
  .eyebrow{margin-bottom:14px;font-size:8px;letter-spacing:.13em}
  h1{font-size:clamp(2.75rem,13vw,4rem);line-height:.92}
  .intro{margin:18px 0 20px;font-size:12px}
  .hero-body__right-copy{left:22px;bottom:39%;width:calc(100% - 44px)}
  .hero-body__right-copy h2{margin-bottom:14px;font-size:clamp(1.9rem,8.5vw,2.6rem)}
  .hero-body__right-copy p{font-size:12px;line-height:1.2}
  .hand--clinician{width:82%;right:-28%;top:43%}
  .hand--patient{width:90%;left:-34%;top:54%}
  .care-panel{left:16px;right:16px;bottom:16px;padding:8px;gap:10px;min-height:112px;border-radius:16px}
  .care-panel__media{width:88px;min-height:96px;border-radius:10px}
  .care-panel__image-slot{padding:10px}
  .care-panel__media strong{font-size:19px}
  .care-panel__media-meta{font-size:7px}
  .care-panel__image-slot img{top:9px;right:9px;width:44px}
  .care-panel__topline{margin-bottom:12px;font-size:8px}
  .care-highlights{gap:8px}
  .care-highlight strong{font-size:17px}
  .care-highlight span{font-size:7px}
  .care-highlight:not(:first-child)::before{height:42px;left:-5px}
}

@media (prefers-reduced-motion:reduce){.hand--clinician,.hand--patient{animation:none}}
</style>
