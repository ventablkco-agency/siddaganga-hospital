---
import { Ambulance, ArrowRight, FlaskConical, HeartHandshake, PhoneCall, Star } from 'lucide-astro';
---

<div class="hero-body">
  <div class="hero-blue" aria-hidden="true"></div>
  <svg class="hero-white hero-white--desktop" viewBox="0 0 1440 720" preserveAspectRatio="none" aria-hidden="true"><path d="M0 0H516C690 172 690 548 516 720H0Z" fill="#fff"/></svg>
  <svg class="hero-white hero-white--laptop" viewBox="0 0 1024 720" preserveAspectRatio="none" aria-hidden="true"><path d="M0 0H458C620 172 620 548 458 720H0Z" fill="#fff"/></svg>
  <svg class="hero-white hero-white--tablet" viewBox="0 0 820 650" preserveAspectRatio="none" aria-hidden="true"><path d="M0 0H820V350C820 505 553 612 0 650Z" fill="#fff"/></svg>
  <svg class="hero-white hero-white--mobile-wide" viewBox="0 0 425 675" preserveAspectRatio="none" aria-hidden="true"><path d="M0 0H425V445C425 561 280 624 0 647Z" fill="#fff"/></svg>
  <svg class="hero-white hero-white--mobile-narrow" viewBox="0 0 375 675" preserveAspectRatio="none" aria-hidden="true"><path d="M0 0H375V464C375 585 247 651 0 675Z" fill="#fff"/></svg>
  <svg class="hero-white hero-white--mobile-320" viewBox="0 0 320 675" preserveAspectRatio="none" aria-hidden="true"><path d="M0 0H320V464C320 585 211 651 0 675Z" fill="#fff"/></svg>

  <div class="hero-copy">
    <p class="hero-eyebrow">SIDDAGANGA HOSPITAL · RANEBENNUR</p>
    <h1>Heart &amp;<br/><em>Diabetes</em>, <span class="mobile-sync">in Sync</span></h1>
    <p class="intro">Specialist care, advanced diagnostics and a team that listens carefully to every patient.</p>
    <a class="hero-cta" href="https://wa.me/919591799099" target="_blank" rel="noreferrer"><span>Book Appointment</span><i><ArrowRight size={19} strokeWidth={1.8}/></i></a>
  </div>

  <div class="hero-right-copy">
    <h2>With Specialist<br/>Technology</h2>
    <p>The latest diagnostic equipment, paired with a team that never rushes a conversation — because every patient deserves both.</p>
  </div>

  <div class="hero-hands" aria-hidden="true">
    <img class="patient-hand" src="/assets/hero/patient-hand.png" alt=""/>
    <img class="clinician-hand" src="/assets/hero/clinician-hand.png" alt=""/>
  </div>

  <div class="service-pills" aria-label="Hospital services">
    <span><Ambulance size={14}/>24×7 Emergency</span>
    <span><FlaskConical size={14}/>On-site Lab</span>
    <span><HeartHandshake size={14}/>Family Care</span>
  </div>

  <aside class="care-panel" aria-label="Hospital assistance and care highlights">
    <a class="assistance" href="tel:+919591799099">
      <i><PhoneCall size={19}/></i>
      <span class="assistance-copy"><small>Need medical assistance?</small><strong>Call our hospital</strong><b>+91 95917 99099</b></span>
      <span class="assistance-dot"></span>
    </a>
    <div class="care-data">
      <div class="care-heading"><span>care highlights</span><i></i></div>
      <div class="metrics">
        <div><strong>15+</strong><span>Years of<br/>experience</span></div>
        <div><strong>6+</strong><span>Medical<br/>specialities</span></div>
        <div><strong><Star size={15} fill="currentColor"/> 4.5</strong><span>Google<br/>rating</span></div>
      </div>
    </div>
  </aside>

  <a class="feedback" href="https://www.google.com/maps/search/?api=1&amp;query=Siddaganga+Hospital+Ranebennur+Karnataka" target="_blank" rel="noreferrer" aria-label="Read patient feedback on Google">
    <p>Read patient feedback on Google</p>
    <span class="feedback-arrow"><ArrowRight size={20}/></span>
  </a>
</div>

<script>
  import '../../scripts/hero-hands-motion';
</script>

<style>
.hero-body{position:relative;width:100%;height:720px;min-height:0;overflow:hidden;isolation:isolate;border-radius:inherit;background:#246afe;color:#fff;font-family:var(--font-body,Inter,Arial,sans-serif)}
.hero-blue{position:absolute;inset:0;background:radial-gradient(ellipse at 76% 17%,rgba(255,255,255,.2),transparent 38%),linear-gradient(135deg,#3478ff 0%,#246afe 58%,#1760f5 100%);z-index:0}
.hero-white{position:absolute;inset:0;width:100%;height:100%;z-index:1;display:none}
.hero-copy,.hero-right-copy,.hero-hands,.care-panel,.service-pills,.feedback{position:absolute}
.hero-copy{z-index:5;left:4.17%;top:19%;width:43%}
.hero-eyebrow{margin:0 0 24px;color:#777;font-size:10px;line-height:1.2;font-weight:500;letter-spacing:.06em}
.hero-copy h1{margin:0;color:#090909;font-family:var(--font-display,Manrope,sans-serif);font-size:clamp(52px,4.9vw,70px);font-weight:750;line-height:1.06;letter-spacing:-.055em}
.hero-copy h1 em{font-style:normal;color:#286cff}.mobile-sync{display:inline}
.intro{max-width:405px;margin:22px 0 26px;color:#858585;font-size:16px;line-height:1.5}
.hero-cta{display:flex;align-items:center;justify-content:space-between;width:212px;height:56px;padding:4px 5px 4px 20px;border:1px solid transparent;border-radius:40px;background:#286cff;color:#fff;text-decoration:none;font-size:13px;font-weight:500;transition:background-color .22s ease,box-shadow .22s ease,transform .22s ease}
.hero-cta i{display:grid;place-items:center;width:44px;height:44px;border-radius:50%;background:#fff;color:#286cff;font-style:normal;transition:transform .22s ease,background-color .22s ease}
.hero-cta:hover{background:#1458e8;box-shadow:0 9px 22px rgba(16,67,177,.24);transform:translateY(-2px)}
.hero-cta:hover i{transform:translateX(3px)}
.hero-cta:focus-visible{outline:3px solid rgba(40,108,255,.35);outline-offset:4px}
@media(prefers-reduced-motion:reduce){.hero-cta,.hero-cta i{transition:none}}
.hero-right-copy{z-index:5;left:64%;top:12.5%;width:29%;color:#fff}
.hero-right-copy h2{margin:0 0 13px;font-family:var(--font-display,Manrope,sans-serif);font-size:clamp(34px,3.35vw,48px);font-weight:400;line-height:.98;letter-spacing:-.035em}
.hero-right-copy p{max-width:390px;margin:0;font-size:16px;line-height:1.5}
.hero-hands{z-index:3;inset:0;pointer-events:none}
.hero-hands img{position:absolute;display:block;height:auto;max-width:none;object-fit:contain}
.patient-hand{left:0;top:35.3%;width:58.5%}
.clinician-hand{left:41.7%;top:18%;width:59%}
.care-panel{z-index:6;left:4.85%;bottom:5.2%;width:330px;min-height:120px;display:grid;grid-template-columns:116px 1fr;gap:9px;padding:8px;border-radius:14px;background:#fff;color:#111;box-shadow:0 12px 35px rgba(13,38,91,.09)}
.assistance{position:relative;display:flex;align-items:center;gap:9px;min-width:0;padding:10px 7px;border-radius:12px;background:#edf2ff;color:#101010;text-decoration:none}
.assistance>i{display:grid;place-items:center;flex:0 0 28px;width:28px;height:28px;border-radius:50%;background:#286cff;color:#fff;font-style:normal}
.assistance-copy{display:flex;flex-direction:column;min-width:0;gap:4px}
.assistance-copy small{color:#286cff;font-size:8px;line-height:1.2}
.assistance-copy strong{font-size:10px;line-height:1.15}
.assistance-copy b{font-size:8px;font-weight:400;color:#888;white-space:nowrap}
.assistance-dot{position:absolute;right:8px;top:50%;width:7px;height:7px;transform:translateY(-50%);border-radius:50%;background:#286cff}
.care-data{min-width:0;display:flex;flex-direction:column;justify-content:center;padding:2px 5px}
.care-heading{display:flex;align-items:center;justify-content:space-between;margin-bottom:9px;font-size:10px;font-weight:600}
.care-heading i{width:27px;height:5px;border-radius:8px;background:#dce6ff}
.care-heading i:after{content:"";display:block;width:45%;height:100%;border-radius:8px;background:#286cff}
.metrics{display:grid;grid-template-columns:repeat(3,1fr)}
.metrics>div{display:flex;flex-direction:column;gap:5px;padding:0 7px;border-left:1px solid #e6e6e6}
.metrics>div:first-child{padding-left:0;border:0}
.metrics strong{display:flex;align-items:center;gap:3px;color:#286cff;font-size:18px;line-height:1.1;white-space:nowrap}
.metrics strong svg{width:13px;height:13px}
.metrics span{color:#161616;font-size:8px;line-height:1.25}
.service-pills{z-index:6;left:50%;bottom:5.2%;display:flex;gap:8px}
.service-pills span{display:flex;align-items:center;gap:7px;min-height:36px;padding:0 12px;border:1px solid rgba(255,255,255,.35);border-radius:30px;background:rgba(255,255,255,.15);color:#fff;font-size:10px;white-space:nowrap}
.service-pills svg{width:13px;height:13px}
.feedback{z-index:6;right:3.5%;bottom:7%;width:160px;display:grid;grid-template-columns:18px 1fr;align-items:center;gap:8px;color:#fff;text-decoration:none}
.feedback p{grid-column:1/3;margin:0;font-size:11px;line-height:1.4}
.feedback-arrow{grid-column:1;width:18px;display:flex}
.feedback-arrow{color:#fff;transition:transform .2s ease}
.feedback:hover .feedback-arrow{transform:translateX(4px)}
@media(min-width:1280px){
 .hero-white--desktop{display:block}
 .hero-copy{left:4.17%;top:19%;width:42%}
 .hero-right-copy{left:64%;top:14%;width:470px}
 .patient-hand{left:0;top:35.3%;width:58.5%}
 .clinician-hand{left:41.7%;top:18%;width:59%}
 .care-panel{left:4.85%;bottom:6.25%}
 .service-pills{left:50%;bottom:6.2%}.service-pills span{min-height:42px;height:42px}.service-pills span:nth-child(1){min-width:149px}.service-pills span:nth-child(2),.service-pills span:nth-child(3){min-width:117px}
 .feedback{right:3.5%;bottom:7%}
}
@media(min-width:901px) and (max-width:1279px){
 .hero-white--laptop{display:block}
 .hero-copy{left:3.9%;top:19.5%;width:48%}
 .hero-copy h1{font-size:58px;line-height:1.02}
 .intro{max-width:400px;margin:22px 0 26px;font-size:15px}
 .hero-right-copy{left:64.8%;top:17.5%;width:31%}
 .hero-right-copy h2{font-size:36px}
 .hero-right-copy p{font-size:14px}
 .patient-hand{left:0;top:300px;width:600px}
 .clinician-hand{left:420px;top:220px;width:604px}
 .care-panel{left:28px;right:auto;top:524px;bottom:auto;width:378px;height:168px;min-height:168px;grid-template-columns:116px 1fr;border-radius:20px}
 .assistance{flex-direction:column;align-items:flex-start;padding:10px}
 .assistance>i{width:28px;height:28px}
 .assistance-copy small{font-size:9px}
 .assistance-copy strong{font-size:14px}
 .assistance-copy b{font-size:9px}
 .metrics strong{font-size:20px}
 .metrics span{font-size:10px}
 .service-pills{left:550px;right:auto;top:650px;bottom:auto;gap:8px}
 .service-pills span{min-height:40px;height:40px;font-size:12px;padding:0 12px}
 .feedback{left:auto;right:3.5%;top:532px;bottom:auto;width:190px;grid-template-columns:18px minmax(0,1fr);gap:12px}
 .feedback p{font-size:11px;line-height:1.4}
}
@media(min-width:700px) and (max-width:900px){
 .hero-body{height:1040px}
 .hero-white--laptop{display:none}
 .hero-white--tablet{display:block;height:650px}
 .hero-copy{left:4.9%;top:17%;width:88%}
 .hero-copy h1{font-size:58px;line-height:1.06}
 .intro{max-width:400px;font-size:16px;margin:24px 0}
 .hero-right-copy{left:5%;right:5%;top:64%;width:auto;display:grid;grid-template-columns:42% 1fr;gap:25px;align-items:start}
 .hero-right-copy h2{font-size:36px;line-height:1.02}
 .hero-right-copy p{font-size:14px}
 .service-pills{left:5%;right:auto;top:75%;bottom:auto;flex-wrap:wrap;width:90%}
 .care-panel{left:4%;bottom:2.3%;width:58.5%;min-height:168px;grid-template-columns:136px 1fr;border-radius:20px}
 .assistance{flex-direction:column;align-items:flex-start;padding:10px}
 .assistance-copy small{font-size:9px}
 .assistance-copy strong{font-size:14px}
 .assistance-copy b{font-size:9px}
 .metrics strong{font-size:20px}
 .metrics span{font-size:10px}
 .feedback{left:auto;right:4%;top:884px;bottom:auto;width:24%;grid-template-columns:18px minmax(0,1fr);gap:12px}
 .feedback p{font-size:11px;line-height:1.4}
}
@media(min-width:700px) and (max-width:799px){
 .patient-hand{left:0;top:397px;width:470px}
 .clinician-hand{left:300px;top:325px;width:468px}
}
@media(min-width:800px) and (max-width:900px){
 .patient-hand{left:0;top:379px;width:502px}
 .clinician-hand{left:320px;top:325px;width:500px}
}
@media(max-width:699px){
 .hero-body{height:1360px;border-radius:22px}
 .hero-blue{background:radial-gradient(ellipse at 80% 70%,rgba(255,255,255,.08),transparent 42%),linear-gradient(145deg,#3478ff,#246afe 62%,#1760f5)}
 .hero-white--mobile-wide{display:block;height:675px}
 .hero-copy{left:24px;right:24px;top:145px;width:auto}
 .hero-hands{top:430px;left:0;right:0;bottom:auto;height:240px;overflow:hidden}
 .hero-eyebrow{font-size:9px;margin-bottom:17px}
 .hero-copy h1{font-size:46px;line-height:1.06;letter-spacing:-.05em}.mobile-sync{display:block}
 .intro{max-width:92%;font-size:15px;line-height:1.5;margin:16px 0 18px}
 .hero-cta{width:212px;height:56px;padding-left:19px}
 .hero-cta i{width:44px;height:44px}
 .hero-right-copy{left:24px;right:24px;top:694px;width:auto}
 .hero-right-copy h2{font-size:34px;line-height:1.04;margin-bottom:14px}
 .hero-right-copy p{font-size:14px;line-height:1.5}
 .patient-hand{left:-20.5%;top:62px;width:90.8%}
 .clinician-hand{left:44.1%;top:10px;width:91.5%}
 .service-pills{left:24px;right:24px;top:885px;bottom:auto;display:flex;flex-wrap:wrap;gap:8px}
 .service-pills span{min-height:40px;padding:0 12px;font-size:10px}.service-pills span:nth-child(1){min-width:148px}.service-pills span:nth-child(2),.service-pills span:nth-child(3){min-width:116px}
 .care-panel{left:24px;right:24px;top:996px;bottom:auto;width:auto;min-height:236px;grid-template-columns:1fr;gap:8px;padding:7px;border-radius:18px}
 .assistance{min-height:88px;padding:10px 12px;gap:10px}
 .assistance>i{width:28px;height:28px;flex-basis:28px}
 .assistance-copy small{font-size:10px}.assistance-copy strong{font-size:15px}.assistance-copy b{font-size:10px}
 .care-data{padding:4px 10px 7px}
 .care-heading{font-size:10px;margin-bottom:9px}
 .metrics>div{padding:0 7px;gap:4px}
 .metrics strong{font-size:18px}
 .metrics span{font-size:9px}
 .feedback{left:24px;right:24px;top:1250px;bottom:auto;width:auto;display:flex;gap:8px}
 .feedback p{flex:1;font-size:11px;max-width:none}
 .feedback-arrow{flex:0 0 18px}

}
@media(min-width:380px) and (max-width:699px){
 .hero-white--mobile-wide{display:block}
}
@media(min-width:340px) and (max-width:379px){
 .hero-white--mobile-wide{display:none}
 .hero-white--mobile-narrow{display:block;height:675px}
 .hero-copy{top:145px}
 .hero-right-copy{top:694px}
 .hero-hands{top:450px;height:240px}.patient-hand{top:62px;width:90.8%}
 .clinician-hand{top:10px;left:44.1%;width:91.5%}
 .service-pills{top:65%}
 .care-panel{top:73%}
 .feedback{top:92.5%}
}
@media(max-width:339px){
 :global(.hero__frame){height:1399px}
 .hero-body{height:1399px}
 .hero-white--mobile-wide,.hero-white--mobile-narrow{display:none}
 .hero-white--mobile-320{display:block;height:675px}
 .hero-copy{left:20px;right:20px;top:10.5%;width:auto}
 .hero-eyebrow{font-size:8px;margin-bottom:17px}
 .hero-copy h1{font-size:46px;line-height:1.06}
 .intro{font-size:14px;max-width:100%;margin:17px 0 18px}
 .hero-cta{width:212px}
 .patient-hand{left:-20.5%;top:62px;width:90.8%}
 .hero-hands{top:470px;height:240px}.clinician-hand{left:44.1%;top:10px;width:91.5%}
 .hero-right-copy{left:20px;right:20px;top:720px;width:auto}
 .hero-right-copy h2{font-size:34px}
 .hero-right-copy p{font-size:14px}
 .service-pills{left:20px;right:20px;top:923px;gap:7px}
 .service-pills span{min-height:40px;padding:0 10px;font-size:10px}
 .care-panel{left:20px;right:20px;top:1035px;min-height:236px;padding:7px}
 .assistance{min-height:88px}
 .care-data{padding:3px 9px 7px}
 .feedback{left:20px;right:20px;top:1305px}
 .feedback p{font-size:11px}
}
:global(.hero){height:auto;min-height:0;padding:20px;box-sizing:border-box;background:#ebf0fe;overflow:hidden}
:global(.hero__frame){height:720px;min-height:0;border-radius:34px;box-shadow:none}
@media(min-width:1280px){
 :global(.hero){height:100svh!important;padding:20px!important}
 :global(.hero__frame){height:100%!important;border-radius:34px!important}
 .hero-body{height:100%!important}
}
@media(min-width:901px) and (max-width:1279px){
 :global(.hero){padding:14px!important}
 :global(.hero__frame){height:720px;border-radius:30px}
}
@media(min-width:700px) and (max-width:900px){
 :global(.hero){height:auto!important;padding:12px!important}
 :global(.hero__frame){height:1040px;border-radius:28px}
}
@media(max-width:699px){
 :global(.hero){height:auto!important;padding:10px!important}
 :global(.hero__frame){height:1360px;border-radius:22px}
}
</style>