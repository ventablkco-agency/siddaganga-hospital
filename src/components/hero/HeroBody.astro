---
import { Ambulance, ArrowRight, FlaskConical, HeartHandshake } from 'lucide-astro';
import IconSlideButton from '../ui/IconSlideButton.astro';
---

<div class="hero-body">
  <div class="hero-body__copy">
    <p class="eyebrow">SIDDAGANGA HOSPITAL · RANEBENNUR</p>
    <h1><span>Heart &amp;</span><span><em>Diabetes</em>, in <strong>Sync</strong></span></h1>
    <p class="intro">Specialist care, advanced diagnostics and a team that listens carefully to every patient.</p>
    <IconSlideButton
      href="https://wa.me/919591799099"
      label="Book Appointment"
      newTab={true}
      background="var(--color-brand)"
      backgroundHover="var(--color-ink)"
      textColor="var(--color-white)"
      textHover="var(--color-white)"
      fillColor="var(--color-white)"
      iconColor="var(--color-brand)"
      iconHoverFill="var(--color-ink)"
    />
  </div>

  <div class="hero-body__right-copy">
    <h2>With Specialist<br />Technology</h2>
    <p>The latest diagnostic equipment, paired with a team that never rushes a conversation — because every patient deserves both.</p>
  </div>

  <div class="hero-body__hands" aria-hidden="true">
    <div class="hero-body__hand-glow"></div>
    <img class="hand hand--clinician" src="/assets/hero/clinician-hand.png" alt="" />
    <img class="hand hand--patient" src="/assets/hero/patient-hand.png" alt="" />
  </div>

  <aside class="care-panel" aria-label="Siddaganga Hospital care highlights">
    <div class="care-panel__media" aria-hidden="true">
      <div class="care-panel__image-slot">
        <span class="care-panel__media-kicker">SIDDAGANGA</span>
        <strong>Hospital</strong>
        <span class="care-panel__media-meta">Ranebennur · Karnataka</span>
        <img src="/assets/brand/siddaganga-hospital.svg" alt="" />
        <span class="care-panel__media-mark"></span>
      </div>
    </div>
    <div class="care-panel__content">
      <div class="care-panel__topline"><span>care highlights</span><i aria-hidden="true"></i></div>
      <div class="care-highlights">
        <div class="care-highlight"><strong>24×7</strong><span>Emergency</span></div>
        <div class="care-highlight"><strong>Lab</strong><span>On-site diagnostics</span></div>
        <div class="care-highlight"><strong>2D Echo</strong><span>ECG support</span></div>
      </div>
    </div>
  </aside>

  <div class="service-pills" aria-label="Hospital highlights">
    <span><Ambulance size={14} strokeWidth={1.8} aria-hidden="true" />24×7 Emergency</span>
    <span><FlaskConical size={14} strokeWidth={1.8} aria-hidden="true" />On-site Lab</span>
    <span><HeartHandshake size={14} strokeWidth={1.8} aria-hidden="true" />Family Care</span>
  </div>

  <div class="feedback" aria-label="Patient feedback">
    <p>We appreciate every feedback<br />because it inspires us to<br />become better.</p>
    <div class="feedback__avatars">
      <span><img src="https://images.pexels.com/photos/19963126/pexels-photo-19963126.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=160&amp;h=160&amp;fit=crop&amp;facepad=2" alt="Healthcare professional" /></span>
      <span><img src="https://images.pexels.com/photos/19438560/pexels-photo-19438560.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=160&amp;h=160&amp;fit=crop&amp;facepad=2" alt="Healthcare professional" /></span>
      <span><img src="https://images.pexels.com/photos/6749781/pexels-photo-6749781.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=160&amp;h=160&amp;fit=crop&amp;facepad=2" alt="Healthcare professional" /></span>
    </div>
  </div>

  <div class="hero-arrow" aria-hidden="true"><ArrowRight size={24} strokeWidth={1.7} /></div>
</div>

<style>
.hero-body{position:relative;display:flex;flex-direction:column;width:100%;min-height:inherit;margin:0;overflow:hidden;isolation:isolate;border-radius:inherit;background:radial-gradient(ellipse at 72% 30%,rgba(255,255,255,.22) 0%,rgba(255,255,255,.08) 30%,transparent 58%),var(--color-brand)}
.hero-body::before{display:none}
.hero-body__copy{order:1;position:relative;z-index:10;background:var(--color-white);padding:clamp(104px,26vw,150px) clamp(20px,5vw,40px) clamp(32px,7vw,48px);border-bottom-right-radius:clamp(72px,26vw,220px)}
.eyebrow{margin:0 0 clamp(14px,3vw,20px);color:var(--text-secondary);font-size:clamp(9px,2.3vw,11px);line-height:1;font-weight:500;letter-spacing:.15em;text-transform:uppercase}
h1{margin:0;color:var(--color-ink);font-family:var(--font-display);font-size:clamp(2.7rem,12.5vw,5rem);line-height:.92;letter-spacing:var(--track-display);font-weight:800}
h1 span{display:block}h1 em{font-style:normal;color:var(--color-brand)}h1 strong{font-weight:800;color:var(--color-ink)}
.intro{max-width:440px;margin:clamp(16px,3.5vw,24px) 0 clamp(20px,4vw,28px);color:var(--text-secondary);font-size:clamp(14px,3.6vw,16px);line-height:1.55}
.hero-body__hands{order:2;position:relative;z-index:7;width:100%;max-width:780px;margin:calc(-1 * clamp(8px,3vw,24px)) auto 0;aspect-ratio:16/9;pointer-events:none}
.hero-body__hand-glow{position:absolute;z-index:0;left:20%;top:0;width:60%;height:100%;border-radius:50%;background:radial-gradient(circle,rgba(255,255,255,.28) 0%,rgba(255,255,255,.1) 45%,transparent 72%)}
.hand{position:absolute;display:block;width:80%;height:auto;max-width:none;object-fit:contain;will-change:transform}
.hand--patient{--hand-x:0%;--hand-y:0%;z-index:6;left:-10%;top:10%;transform:translate(var(--hand-x),var(--hand-y));animation:patientFloat 7s ease-in-out -1s infinite}
.hand--clinician{--hand-x:0%;--hand-y:0%;z-index:4;right:-10%;top:0;transform:translate(var(--hand-x),var(--hand-y));animation:clinicianFloat 7s ease-in-out infinite}
.hero-body__right-copy{order:3;position:relative;z-index:10;padding:clamp(4px,2vw,12px) clamp(20px,5vw,40px) 0;color:var(--color-white)}
.hero-body__right-copy h2{margin:0 0 clamp(12px,3vw,18px);font-family:var(--font-display);font-size:clamp(2rem,9vw,3.2rem);line-height:.95;letter-spacing:var(--track-display);font-weight:700}
.hero-body__right-copy p{margin:0;max-width:460px;color:var(--color-white);font-size:clamp(14px,3.7vw,17px);line-height:1.5}
.service-pills{order:4;position:relative;z-index:18;display:flex;flex-wrap:wrap;gap:8px;padding:clamp(18px,4vw,26px) clamp(20px,5vw,40px) 0}
.service-pills span{display:inline-flex;align-items:center;gap:8px;padding:10px 16px;border:1px solid rgba(255,255,255,.4);border-radius:var(--radius-pill);background:rgba(255,255,255,.13);color:var(--color-white);font-size:11px;white-space:nowrap;backdrop-filter:blur(12px)}
.service-pills svg{flex:0 0 auto}
.care-panel{order:5;position:relative;z-index:20;display:flex;align-items:stretch;gap:clamp(10px,2.5vw,22px);margin:clamp(20px,4vw,28px) clamp(12px,4vw,32px) clamp(12px,4vw,32px);padding:clamp(8px,2vw,12px);border:1px solid rgba(11,10,10,.06);border-radius:clamp(16px,3vw,22px);background:var(--color-white);box-shadow:var(--shadow-md)}
.care-panel__media{position:relative;flex:0 0 clamp(88px,22vw,150px);min-height:96px;overflow:hidden;border-radius:var(--radius-sm);background:var(--color-bg)}
.care-panel__image-slot{position:absolute;inset:0;display:flex;flex-direction:column;justify-content:flex-end;padding:clamp(10px,2.4vw,16px);overflow:hidden;background:radial-gradient(circle at 76% 22%,var(--brand-22),transparent 28%),linear-gradient(145deg,var(--color-bg),var(--brand-06));color:var(--color-ink)}
.care-panel__image-slot::before{content:'';position:absolute;inset:10%;border:1px solid var(--brand-12);border-radius:28% 72% 72% 28% / 35% 35% 65% 65%}
.care-panel__image-slot img{position:absolute;top:12px;right:12px;width:clamp(44px,10vw,70px);height:auto;opacity:.12;filter:grayscale(1)}
.care-panel__media-kicker,.care-panel__media-meta{position:relative;z-index:2;font-size:clamp(7px,1.8vw,9px);line-height:1.25;letter-spacing:.1em;text-transform:uppercase}
.care-panel__media-kicker{color:var(--color-brand);font-weight:700}
.care-panel__media strong{position:relative;z-index:2;margin-top:2px;font-family:var(--font-display);font-size:clamp(18px,4.6vw,28px);line-height:.95;letter-spacing:-.04em}
.care-panel__media-meta{margin-top:5px;color:var(--text-secondary);letter-spacing:.02em;text-transform:none}
.care-panel__media-mark{position:absolute;right:10px;bottom:10px;width:8px;height:8px;border-radius:50%;background:var(--color-brand);box-shadow:0 0 0 6px var(--brand-12)}
.care-panel__content{display:flex;flex:1;min-width:0;flex-direction:column;justify-content:center;padding-right:4px}
.care-panel__topline{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:clamp(12px,3vw,18px);color:var(--color-ink);font-size:clamp(10px,2.4vw,11px);font-weight:500;white-space:nowrap}
.care-panel__topline i{display:block;width:28px;height:6px;flex:0 0 auto;border-radius:var(--radius-pill);background:var(--brand-12)}
.care-panel__topline i::after{content:'';display:block;width:14px;height:6px;border-radius:inherit;background:var(--color-brand)}
.care-highlights{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(14px,3vw,24px)}
.care-highlight{position:relative;min-width:0}
.care-highlight:not(:first-child)::before{content:'';position:absolute;left:clamp(-12px,-1.6vw,-7px);top:0;width:1px;height:42px;background:var(--line)}
.care-highlight strong{display:block;margin:0 0 4px;color:var(--color-brand);font-family:var(--font-display);font-size:clamp(17px,4.8vw,28px);line-height:1;font-weight:700;letter-spacing:-.04em;white-space:nowrap}
.care-highlight span{display:block;color:var(--color-ink);font-size:clamp(8px,2vw,10px);line-height:1.25}
.feedback,.hero-arrow{display:none}
.feedback{position:absolute;z-index:18;color:var(--color-white);text-align:left}
.feedback p{margin:0 0 10px;font-size:9px;line-height:1.35}
.feedback__avatars{display:flex;justify-content:flex-end}
.feedback__avatars span{display:block;width:clamp(26px,2.15vw,34px);height:clamp(26px,2.15vw,34px);margin-left:-7px;border:2px solid rgba(255,255,255,.9);border-radius:50%;overflow:hidden;background:var(--color-white);box-shadow:0 3px 12px rgba(11,10,10,.12)}
.feedback__avatars img{display:block;width:100%;height:100%;object-fit:cover;object-position:center top}
@keyframes clinicianFloat{0%,100%{transform:translate(var(--hand-x),var(--hand-y))}50%{transform:translate(calc(var(--hand-x) + .2%),calc(var(--hand-y) + .35%))}}
@keyframes patientFloat{0%,100%{transform:translate(var(--hand-x),var(--hand-y))}50%{transform:translate(calc(var(--hand-x) - .2%),calc(var(--hand-y) - .35%))}}

/* =========================================================
   MOBILE ART-DIRECTED COMPOSITION
   The reference is a designed canvas, not a stacked document.
   Every layer is anchored to the same proportional canvas so the
   white ellipse, specialist copy, hands, CTA and lower cards scale together.
   ========================================================= */
@media (max-width:1023px){
  .hero-body{
    display:block;
    position:relative;
    width:100%;
    height:max(100svh,223vw);
    min-height:0;
    overflow:hidden;
    background:
      radial-gradient(circle at 83% 39%,rgba(255,255,255,.16) 0%,rgba(255,255,255,.07) 25%,transparent 48%),
      linear-gradient(180deg,#3a78f7 0%,#246AFE 100%);
  }

  .hero-body::before{
    display:block;
    content:'';
    position:absolute;
    z-index:1;
    inset:0;
    width:100%;
    height:100%;
    background:#fff;
    clip-path:ellipse(75% 61% at 0% 43%);
    -webkit-clip-path:ellipse(75% 61% at 0% 43%);
    pointer-events:none;
  }

  .hero-body__copy{
    position:absolute;
    z-index:12;
    top:16.2%;
    left:7.8%;
    width:53.5%;
    padding:0;
    margin:0;
    background:transparent;
    border-radius:0;
  }

  .eyebrow{
    margin:0 0 clamp(16px,3.8vw,22px);
    color:#737983;
    font-size:clamp(9px,2.2vw,11px);
    line-height:1;
    letter-spacing:.16em;
    white-space:nowrap;
  }

  h1{
    margin:0;
    font-size:clamp(48px,14vw,68px);
    line-height:.9;
    letter-spacing:-.065em;
    font-weight:800;
  }

  h1 span{display:block}

  .intro{
    width:100%;
    max-width:100%;
    margin:clamp(18px,4vw,28px) 0 0;
    color:#777d87;
    font-size:clamp(15px,3.8vw,18px);
    line-height:1.48;
  }

  .hero-body__copy > a{
    position:absolute;
    z-index:30;
    left:0;
    top:clamp(300px,42vw,390px);
    width:clamp(210px,49vw,370px);
    max-width:none;
  }

  .hero-body__right-copy{
    position:absolute;
    z-index:14;
    top:16.7%;
    left:61.8%;
    width:30%;
    padding:0;
    margin:0;
    color:#fff;
  }

  .hero-body__right-copy h2{
    margin:0 0 clamp(13px,3.2vw,22px);
    color:#fff;
    font-size:clamp(28px,7.6vw,43px);
    line-height:.92;
    letter-spacing:-.055em;
  }

  .hero-body__right-copy p{
    margin:0;
    max-width:none;
    color:#fff;
    font-size:clamp(13px,3.25vw,17px);
    line-height:1.45;
  }

  .hero-body__hands{
    position:absolute;
    z-index:22;
    left:0;
    top:42.5%;
    width:100%;
    height:25%;
    max-width:none;
    margin:0;
    aspect-ratio:auto;
    pointer-events:none;
  }

  .hero-body__hand-glow{
    left:46%;
    top:-4%;
    width:42%;
    height:108%;
    background:radial-gradient(circle,rgba(255,255,255,.18) 0%,rgba(255,255,255,.08) 40%,transparent 74%);
  }

  .hero-body__hands .hand{
    position:absolute;
    display:block;
    height:auto;
    max-width:none;
    object-fit:contain;
    animation:none;
    will-change:auto;
  }

  /* Hand coordinates are deliberately isolated here. Adjust only these two
     blocks when matching the reference fingertip gap. */
  .hero-body__hands .hand--patient{
    width:66%;
    left:-5%;
    top:25%;
    right:auto;
    transform:none;
    z-index:3;
  }

  .hero-body__hands .hand--clinician{
    width:70%;
    right:-8%;
    left:auto;
    top:0;
    transform:none;
    z-index:4;
  }

  .care-panel{
    position:absolute;
    z-index:40;
    left:4.5%;
    right:4.5%;
    top:65.5%;
    bottom:auto;
    width:auto;
    min-height:0;
    height:14.3%;
    margin:0;
    padding:8px;
    gap:clamp(8px,2.2vw,14px);
    border-radius:clamp(18px,4vw,26px);
    background:#fff;
    box-shadow:0 14px 38px rgba(15,35,70,.16);
  }

  .care-panel__media{
    display:block;
    flex:0 0 31%;
    min-height:0;
    height:100%;
    border-radius:clamp(12px,3vw,18px);
  }

  .care-panel__image-slot{padding:clamp(9px,2.3vw,14px)}
  .care-panel__image-slot img{top:9px;right:9px;width:30%;}
  .care-panel__media-kicker,.care-panel__media-meta{font-size:clamp(6px,1.8vw,9px)}
  .care-panel__media strong{font-size:clamp(20px,5.2vw,31px)}
  .care-panel__media-meta{margin-top:4px}
  .care-panel__media-mark{right:8px;bottom:8px;width:8px;height:8px}

  .care-panel__content{padding:0 2px 0 0}
  .care-panel__topline{margin-bottom:clamp(10px,2.5vw,16px);font-size:clamp(9px,2.2vw,11px)}
  .care-panel__topline i{width:30px;height:6px}
  .care-panel__topline i::after{width:15px;height:6px}
  .care-highlights{gap:clamp(8px,2.3vw,18px)}
  .care-highlight strong{font-size:clamp(18px,5.2vw,31px)}
  .care-highlight span{font-size:clamp(8px,2vw,11px)}
  .care-highlight:not(:first-child)::before{height:44px}

  .service-pills{
    position:absolute;
    z-index:42;
    left:4.5%;
    right:4.5%;
    top:81.5%;
    bottom:auto;
    display:grid;
    grid-template-columns:repeat(3,minmax(0,1fr));
    gap:clamp(7px,1.8vw,12px);
    padding:0;
  }

  .service-pills span{
    display:flex;
    align-items:center;
    justify-content:center;
    gap:clamp(4px,1.2vw,8px);
    min-width:0;
    min-height:clamp(44px,7vw,62px);
    padding:8px 5px;
    border:1px solid rgba(255,255,255,.48);
    border-radius:999px;
    background:rgba(255,255,255,.9);
    color:var(--color-brand);
    font-size:clamp(8px,2.1vw,11px);
    line-height:1.05;
    white-space:normal;
    text-align:center;
    backdrop-filter:blur(12px);
  }

  .service-pills svg{width:14px;height:14px;flex:0 0 auto}

  .feedback{
    display:flex;
    position:absolute;
    z-index:8;
    left:7%;
    right:7%;
    bottom:0;
    height:14%;
    align-items:center;
    justify-content:space-between;
    gap:12px;
    color:#fff;
    text-align:left;
  }

  .feedback p{
    margin:0;
    max-width:55%;
    font-size:clamp(13px,3.4vw,18px);
    line-height:1.28;
  }

  .feedback__avatars{display:flex;justify-content:flex-end;align-items:center}
  .feedback__avatars span{
    width:clamp(38px,10vw,58px);
    height:clamp(38px,10vw,58px);
    margin-left:-9px;
    border-width:2px;
  }

  .hero-arrow{
    position:absolute;
    z-index:10;
    left:7%;
    bottom:2.8%;
    display:grid;
    place-items:center;
    color:#fff;
  }

  /* Keep the reference proportions on very small phones; never remove the
     hospital media tile because it is part of the intended composition. */
  @media (max-width:360px){
    .hero-body__copy{left:8%;width:54%}
    .hero-body__right-copy{left:62%;width:30.5%}
    .hero-body__right-copy h2{font-size:clamp(25px,7.5vw,31px)}
    .hero-body__right-copy p{font-size:clamp(11px,3.15vw,14px)}
    .hero-body__copy > a{top:42vw;width:49vw}
    .care-panel{height:14.5%;padding:6px;gap:6px}
    .care-panel__media{flex-basis:30%}
    .care-panel__media strong{font-size:clamp(17px,5.3vw,23px)}
    .care-highlight strong{font-size:clamp(16px,5vw,23px)}
    .care-highlight span{font-size:8px}
    .service-pills span{font-size:8px;gap:3px}
    .feedback p{font-size:12px}
  }

  /* Tablet gets more breathing room while retaining the same composition. */
  @media (min-width:700px) and (max-width:1023px){
    .hero-body{height:clamp(900px,125vw,1150px)}
    .hero-body__copy{top:18%;left:6.5%;width:53%}
    h1{font-size:clamp(58px,8.2vw,82px)}
    .hero-body__right-copy{top:18.5%;left:62%;width:31%}
    .hero-body__right-copy h2{font-size:clamp(34px,5vw,50px)}
    .hero-body__right-copy p{font-size:clamp(14px,2vw,18px)}
    .hero-body__hands{top:43%;height:25%}
    .care-panel{top:66%;height:14.5%;left:5%;right:5%}
    .service-pills{top:82%;left:5%;right:5%}
  }
}

/* =========================================================
   DESKTOP (>=1024px): original composition remains unchanged
   ========================================================= */
@media (min-width:1024px){
  .hero-body{display:block;background:radial-gradient(ellipse at 72% 18%,rgba(255,255,255,.22) 0%,rgba(255,255,255,.08) 28%,transparent 55%),radial-gradient(ellipse at 90% 78%,rgba(255,255,255,.08),transparent 42%),var(--color-brand)}
  .hero-body::before{display:block;content:'';position:absolute;z-index:0;inset:0 auto 0 0;width:61%;background:var(--color-white);clip-path:ellipse(100% 82% at 0% 50%);pointer-events:none}
  .hero-body__copy{position:absolute;left:clamp(28px,3.6vw,56px);top:clamp(126px,19vh,190px);width:min(52vw,720px);padding:0;background:none;border-radius:0}
  .eyebrow{margin-bottom:clamp(16px,1.6vw,24px);font-size:clamp(9px,.7vw,11px);letter-spacing:.17em}
  h1{font-size:clamp(3.5rem,6.2vw,5.5rem);line-height:.9}
  .intro{max-width:clamp(300px,30vw,420px);margin:clamp(20px,2.2vw,32px) 0;font-size:clamp(12px,.9vw,14px)}
  .hero-body__right-copy{position:absolute;left:63%;top:clamp(145px,18.5vh,195px);width:min(31vw,460px);padding:0}
  .hero-body__right-copy h2{margin-bottom:clamp(18px,1.8vw,27px);font-size:clamp(2.2rem,3.55vw,3.35rem);line-height:.9}
  .hero-body__right-copy p{max-width:440px;font-size:clamp(13px,1.25vw,20px);line-height:1.1}
  .hero-body__hands{position:absolute;inset:0;max-width:none;margin:0;aspect-ratio:auto}
  .hero-body__hand-glow{left:auto;right:3%;top:4%;width:58%;height:58%;background:radial-gradient(circle,var(--brand-22) 0%,rgba(255,255,255,.18) 40%,transparent 72%)}
