---
import IconSlideButton from '../ui/IconSlideButton.astro';
---

<div class="hero-body">
  <div class="hero-body__grid" aria-hidden="true"></div>
  <div class="hero-body__blue-panel" aria-hidden="true"></div>

  <div class="hero-body__copy">
    <p class="eyebrow">SIDDAGANGA HOSPITAL · RANEBENNUR</p>

    <h1>
      <span>Heart &amp;</span>
      <span><em>Diabetes</em>, in <strong>Sync</strong></span>
    </h1>

    <p class="intro">
      Specialist care, advanced diagnostics and a team that listens carefully to every patient.
    </p>

    <IconSlideButton
      href="https://wa.me/919591799099"
      label="Book Appointment"
      newTab={true}
      variant="blue"
    />
  </div>

  <div class="hero-body__right-copy">
    <h2>With Specialist<br />Technology</h2>
    <p>
      The latest diagnostic equipment, paired with a team that never rushes a conversation — because every patient deserves both.
    </p>
  </div>

  <div class="hero-body__hands" aria-hidden="true">
    <div class="hero-body__hand-glow"></div>
    <img class="hand hand--clinician" src="/assets/hero/clinician-hand.png" alt="" />
    <img class="hand hand--patient" src="/assets/hero/patient-hand.png" alt="" />
  </div>

  <aside class="care-panel">
    <div class="care-panel__media">
      <img src="/assets/hero/hospital-700.webp" alt="Siddaganga Hospital exterior" />
      <span class="care-panel__play" aria-hidden="true">▶</span>
      <span class="care-panel__caption">Virtual tour</span>
      <span class="care-panel__dot" aria-hidden="true"></span>
    </div>

    <div class="care-panel__content">
      <div class="care-panel__label">our care in numbers</div>
      <div class="care-panel__rule" aria-hidden="true"><i></i></div>

      <div class="stats">
        <div class="stat">
          <strong>15+</strong>
          <span>year of<br />experience</span>
        </div>
        <div class="stat">
          <strong>20+</strong>
          <span>highly qualified<br />doctors</span>
        </div>
        <div class="stat">
          <strong>100%</strong>
          <span>advanced<br />diagnostics</span>
        </div>
      </div>
    </div>
  </aside>

  <div class="service-pills" aria-label="Hospital highlights">
    <span><b>♧</b>24×7 Emergency</span>
    <span><b>⌬</b>On-site Lab</span>
    <span><b>♙</b>Family Care</span>
  </div>

  <div class="feedback" aria-hidden="true">
    <p>We appreciate every feedback<br />because it inspires us to<br />become better.</p>
    <div class="feedback__avatars">
      <span></span><span></span><span></span>
    </div>
  </div>

  <div class="hero-arrow" aria-hidden="true">→</div>
</div>

<style>
.hero-body{
  position:relative;
  width:100%;
  min-height:100%;
  height:calc(100svh - 32px);
  overflow:hidden;
  isolation:isolate;
  background:#fff;
}
.hero-body::before{
  content:"";
  position:absolute;
  left:20px;right:20px;top:26px;bottom:24px;
  border-radius:20px;
  background:#f0f9fd;
  z-index:0;
}
.hero-body__grid{
  position:absolute;inset:0;z-index:1;pointer-events:none;opacity:.8;
  background:
    linear-gradient(rgba(16,42,72,.026) 1px,transparent 1px),
    linear-gradient(90deg,rgba(16,42,72,.026) 1px,transparent 1px);
  background-size:100% 128px,128px 100%;
}
.hero-body__blue-panel{
  position:absolute;z-index:2;left:calc(33.33% + 69px);right:18px;top:24px;bottom:25px;
  background:linear-gradient(165deg,#2a7ff3 0%,#1769e7 55%,#2b7ff0 100%);
  clip-path:polygon(0% 0,100% 0,100% 100%,0 100%);
}
.hero-body__blue-panel::before{
  content:"";position:absolute;inset:0;
  background:
    radial-gradient(circle at 46% 12%,rgba(255,255,255,.15),transparent 19%),
    radial-gradient(circle at 22% 62%,rgba(255,255,255,.08),transparent 28%);
}
.hero-body__copy{
  position:absolute;z-index:10;left:40px;top:201px;width:670px;
}
.eyebrow{
  margin:0 0 22px;color:#66758a;font-size:10px;line-height:1;
  font-weight:500;letter-spacing:.17em;text-transform:uppercase;
}
h1{
  margin:0;width:670px;color:#050505;font-family:var(--font-display);
  font-size:88.303px;line-height:.9;letter-spacing:-5.298px;font-weight:800;
}
h1 span{display:block}
h1 em{font-style:normal;background:linear-gradient(90deg,#166af4,#0d3e8e);-webkit-background-clip:text;background-clip:text;color:transparent}
h1 strong{font-weight:800;color:#050505}
.intro{max-width:390px;margin:28px 0 25px;color:#617089;font-size:13px;line-height:1.55}
.hero-body__right-copy{
  position:absolute;z-index:10;left:calc(58.33% + 16px);top:201px;width:460px;color:#fff;
}
.hero-body__right-copy h2{
  margin:0 0 31px;font-family:var(--font-display);font-size:51.773px;
  line-height:.9;letter-spacing:-3.106px;font-weight:700;
}
.hero-body__right-copy p{margin:0;width:460px;font-size:21.572px;line-height:1;color:rgba(255,255,255,.96)}
.hero-body__hands{position:absolute;z-index:5;inset:0;pointer-events:none}
.hero-body__hand-glow{
  position:absolute;z-index:0;right:5%;top:10%;width:55%;height:55%;border-radius:50%;
  background:radial-gradient(circle,rgba(255,255,255,.78) 0%,rgba(238,248,255,.25) 48%,transparent 72%);
}
.hand{position:absolute;object-fit:contain;filter:none;will-change:transform}
.hand--clinician{
  z-index:4;width:66%;right:-6.5%;top:19%;animation:clinicianFloat 7s ease-in-out infinite;
}
.hand--patient{
  z-index:6;width:67%;left:-7.2%;top:28.35%;animation:patientFloat 7s ease-in-out -1s infinite;
}
.care-panel{
  position:absolute;z-index:12;left:40px;top:707px;
  display:flex;align-items:center;width:558.54px;height:165.75px;
  padding:11.889px 31px 11.889px 11.889px;gap:31px;border-radius:15.012px;background:#fff;
  box-shadow:0 12px 30px rgba(35,69,104,.08);
}
.care-panel__media{
  position:relative;width:165.44px;height:141.97px;flex:0 0 auto;border-radius:10.03px;overflow:hidden;
}
.care-panel__media img{width:100%;height:100%;display:block;object-fit:cover}
.care-panel__play{
  position:absolute;top:12px;right:-1px;width:36px;height:36px;border-radius:50%;
  display:grid;place-items:center;background:#fff;color:#0c63ce;font-size:11px;line-height:1;
  box-shadow:0 5px 16px rgba(25,65,110,.12);
}
.care-panel__caption{position:absolute;left:13px;bottom:11px;color:#fff;font-size:10px;text-shadow:0 1px 8px rgba(0,0,0,.28)}
.care-panel__dot{position:absolute;right:10px;bottom:8px;width:7px;height:7px;border-radius:50%;background:#111}
.care-panel__content{position:relative;flex:1;min-width:0}
.care-panel__label{position:absolute;left:0;top:-20px;color:#111;font-size:12.785px;font-weight:500;white-space:nowrap}
.care-panel__rule{position:absolute;right:0;top:-25px;width:28px;height:6px;border-radius:99px;background:#e2edfb}
.care-panel__rule i{display:block;width:14px;height:6px;border-radius:inherit;background:#267bef}
.stats{display:flex;align-items:flex-start;gap:35px;margin-top:20px}
.stat{position:relative;min-width:0}
.stat:not(:first-child)::before{
  content:"";position:absolute;left:-18px;top:0;width:1px;height:61px;background:rgba(16,40,65,.12)
}
.stat strong{display:block;margin:0 0 5px;color:#0b5be8;font-family:var(--font-body);font-size:38.356px;line-height:1;font-weight:500;letter-spacing:-1.1px}
.stat span{display:block;color:#111;font-size:12.785px;line-height:1.18}
.service-pills{
  position:absolute;z-index:12;right:calc(20.8% - 130px);bottom:70px;display:flex;gap:13px;
}
.service-pills span{
  display:inline-flex;align-items:center;gap:10px;padding:14px 22px;border:1px solid rgba(255,255,255,.4);
  border-radius:999px;background:rgba(255,255,255,.22);color:#fff;font-size:11px;white-space:nowrap;
  backdrop-filter:blur(12px)
}
.service-pills b{font-size:15px;font-weight:400;color:#fff}
.feedback{position:absolute;z-index:12;right:45px;bottom:28px;color:rgba(255,255,255,.92);text-align:right}
.feedback p{margin:0 0 10px;font-size:9px;line-height:1.35}
.feedback__avatars{display:flex;justify-content:flex-end}
.feedback__avatars span{width:31px;height:31px;margin-left:-7px;border:2px solid rgba(255,255,255,.86);border-radius:50%;background:linear-gradient(135deg,#dbe9f7,#7e9ec0)}
.feedback__avatars span:nth-child(2){background:linear-gradient(135deg,#f3d8c6,#b48b72)}
.feedback__avatars span:nth-child(3){background:linear-gradient(135deg,#b6d6ef,#416f99)}
.hero-arrow{position:absolute;z-index:12;right:190px;bottom:38px;color:#fff;font-size:28px;font-weight:300}
@keyframes clinicianFloat{0%,100%{transform:translate3d(0,0,0)}50%{transform:translate3d(-7px,6px,0)}}
@keyframes patientFloat{0%,100%{transform:translate3d(0,0,0)}50%{transform:translate3d(7px,-5px,0)}}
@media (max-width:1200px){
  .hero-body__copy{width:52%}.hero-body__blue-panel{left:38%;}.hero-body__right-copy{left:auto;right:44px;width:35%}
  h1{font-size:clamp(64px,6.15vw,88.3px);letter-spacing:-.075em}.hero-body__right-copy h2{font-size:clamp(34px,3.6vw,51.77px)}
  .hero-body__right-copy p{width:auto;font-size:clamp(13px,1.5vw,21.57px)}.care-panel{transform:scale(.86);transform-origin:left bottom}
  .service-pills{right:7vw}
}
@media (max-width:900px){
  .hero-body__copy{width:55%;top:170px}.hero-body__blue-panel{left:34%;}.hero-body__right-copy{top:175px;right:28px;width:30%}
  h1{font-size:clamp(52px,7.7vw,72px)}.hand--clinician{width:59%;top:36%}.hand--patient{width:62%;top:45%}
  .care-panel{transform:scale(.7);transform-origin:left bottom}.service-pills{right:2vw;bottom:28px;transform:scale(.72);transform-origin:right bottom}.feedback{display:none}
}
@media (max-width:760px){
  .hero-body{height:auto;min-height:760px}.hero-body::before{left:8px;right:8px;top:8px;bottom:8px;border-radius:22px}
  .hero-body__blue-panel{left:8px;right:8px;top:42%;bottom:8px;width:auto;clip-path:polygon(0 10%,100% 0,100% 100%,0 100%)}
  .hero-body__copy{left:24px;top:110px;width:auto;right:24px}.eyebrow{margin-bottom:20px;font-size:8px}
  h1{width:auto;font-size:clamp(50px,13vw,72px);letter-spacing:-.065em}.intro{max-width:310px;font-size:11px}
  .hero-body__right-copy{left:24px;right:24px;top:auto;bottom:270px;width:auto}.hero-body__right-copy h2{font-size:28px;letter-spacing:-1.5px}
  .hero-body__right-copy p{width:auto;font-size:11px;line-height:1.35}.hero-body__hand-glow{width:90%;height:45%;right:-7%;top:38%}
  .hand--clinician{width:85%;right:-15%;top:49%}.hand--patient{width:88%;left:-5%;top:57%}
  .care-panel{left:18px;right:18px;top:auto;bottom:18px;width:auto;height:120px;transform:none;padding:7px 10px 7px 7px;gap:12px;border-radius:20px}
  .care-panel__media{width:110px;height:106px}.care-panel__content{padding:0}.care-panel__label{top:-2px;left:0;font-size:8px}
  .care-panel__rule{top:-4px;right:0;transform:scale(.75);transform-origin:right}.stats{gap:10px;margin-top:25px}
  .stat:not(:first-child)::before{left:-6px;height:49px}.stat strong{font-size:21px}.stat span{font-size:7px}
  .service-pills,.feedback,.hero-arrow{display:none}
}
@media (prefers-reduced-motion:reduce){.hand--clinician,.hand--patient{animation:none}}
</style>
