---
import { Ambulance, ArrowRight, FlaskConical, HeartHandshake } from 'lucide-astro';
import IconSlideButton from '../ui/IconSlideButton.astro';
---

<script is:inline>
  // Hide animated layers until GSAP starts (no flash). Skipped for reduced-motion users.
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('hero-anim');
</script>

<div class="hero-body">
  <div class="hero-body__white" aria-hidden="true"></div>

  <div class="hero-body__copy">
    <p class="eyebrow" data-in>SIDDAGANGA HOSPITAL · RANEBENNUR</p>
    <h1><span data-in>Heart &amp;</span><span data-in><em>Diabetes</em>, in <strong>Sync</strong></span></h1>
    <p class="intro" data-in>Specialist care, advanced diagnostics and a team that listens carefully to every patient.</p>
    <div class="hero-body__cta" data-in>
      <IconSlideButton
        href="https://wa.me/919591799099"
        label="Book Appointment"
        newTab={true}
        background="var(--color-brand)"
        backgroundHover="var(--color-ink)"
        textColor="var(--color-white)"
        textHover="var(--color-white)"
        fillColor="var(--color-white)"
        iconColor="var(--color-brand)"
        iconHoverFill="var(--color-ink)"
      />
    </div>
  </div>

  <div class="hero-body__right-copy">
    <h2 data-in>With Specialist<br />Technology</h2>
    <p data-in>The latest diagnostic equipment, paired with a team that never rushes a conversation — because every patient deserves both.</p>
  </div>

  <div class="hero-body__hands" aria-hidden="true">
    <div class="hero-body__hand-glow"></div>
    <div class="hero-hand hero-hand--patient"><img src="/assets/hero/patient-hand.png" alt="" /></div>
    <div class="hero-hand hero-hand--clinician"><img src="/assets/hero/clinician-hand.png" alt="" /></div>
  </div>

  <aside class="care-panel" aria-label="Siddaganga Hospital care highlights">
    <div class="care-panel__media" aria-hidden="true">
      <span class="care-panel__media-kicker">SIDDAGANGA</span>
      <strong>Hospital</strong>
      <span class="care-panel__media-meta">Ranebennur · Karnataka</span>
      <img src="/assets/brand/siddaganga-hospital.svg" alt="" />
      <span class="care-panel__media-mark"></span>
    </div>
    <div class="care-panel__content">
      <div class="care-panel__topline"><span>care highlights</span><i aria-hidden="true"></i></div>
      <div class="care-highlights">
        <div class="care-highlight"><strong>24×7</strong><span>Emergency</span></div>
        <div class="care-highlight"><strong>Lab</strong><span>On-site diagnostics</span></div>
        <div class="care-highlight"><strong>2D Echo</strong><span>ECG support</span></div>
      </div>
    </div>
  </aside>

  <div class="service-pills" aria-label="Hospital highlights">
    <span><Ambulance size={14} strokeWidth={1.8} aria-hidden="true" />24×7 Emergency</span>
    <span><FlaskConical size={14} strokeWidth={1.8} aria-hidden="true" />On-site Lab</span>
    <span><HeartHandshake size={14} strokeWidth={1.8} aria-hidden="true" />Family Care</span>
  </div>

  <div class="feedback" aria-label="Patient feedback">
    <p>We appreciate every feedback because it inspires us to become better.</p>
    <div class="feedback__avatars">
      <span><img src="https://images.pexels.com/photos/19963126/pexels-photo-19963126.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=160&amp;h=160&amp;fit=crop&amp;facepad=2" alt="Healthcare professional" /></span>
      <span><img src="https://images.pexels.com/photos/19438560/pexels-photo-19438560.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=160&amp;h=160&amp;fit=crop&amp;facepad=2" alt="Healthcare professional" /></span>
      <span><img src="https://images.pexels.com/photos/6749781/pexels-photo-6749781.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=160&amp;h=160&amp;fit=crop&amp;facepad=2" alt="Healthcare professional" /></span>
    </div>
  </div>

  <div class="hero-arrow" aria-hidden="true"><ArrowRight size={24} strokeWidth={1.7} /></div>
</div>

<style>
/* Layout system: .hero-body is a size container, so every layer is placed in cqw/cqh and
   scales as one piece. Hands: --wn = hand width in cqw, --L = how far each hand bleeds off its
   edge. L is solved so the two fingertips always end ~4cqw apart at any width. */
.hero-body{
  position:relative;width:100%;overflow:hidden;isolation:isolate;border-radius:inherit;
  container-type:size;
  height:max(calc(100svh - 16px),272vw);
  --wn:100;--w:calc(var(--wn)*1cqw);
  --L:max(0cqw,calc((1.576*var(--wn) - 96)*.5cqw));
  --ty:118cqw;--ty2:115cqw;
  background:radial-gradient(ellipse at 72% 30%,rgba(255,255,255,.22) 0%,rgba(255,255,255,.08) 30%,transparent 58%),var(--color-brand);
}
.hero-body::before{display:none}
.hero-body__white{position:absolute;inset:0;z-index:0;background:var(--color-white);clip-path:ellipse(62cqw 104cqw at 0 36cqw);pointer-events:none}

.hero-body__copy{position:absolute;z-index:20;left:7cqw;top:24cqw;width:86cqw}
.eyebrow{margin:0 0 4cqw;color:var(--text-secondary);font-size:clamp(9px,2.4cqw,11px);line-height:1;font-weight:500;letter-spacing:.16em;text-transform:uppercase}
h1{margin:0;color:var(--color-ink);font-family:var(--font-display);font-size:10cqw;line-height:.92;letter-spacing:var(--track-display);font-weight:800}
h1 span{display:block;white-space:nowrap}
h1 em{font-style:normal;color:var(--color-brand)}
h1 strong{font-weight:800;color:var(--color-ink)}
.intro{max-width:80cqw;margin:4cqw 0 5cqw;color:var(--text-secondary);font-size:4cqw;line-height:1.5}
.hero-body__cta{display:inline-block}

.hero-body__right-copy{position:absolute;z-index:20;left:7cqw;top:160cqw;width:86cqw;color:var(--color-white)}
.hero-body__right-copy h2{margin:0 0 3cqw;font-family:var(--font-display);font-size:7.4cqw;line-height:.95;letter-spacing:var(--track-display);font-weight:700}
.hero-body__right-copy p{margin:0;font-size:3.9cqw;line-height:1.45}

.hero-body__hands{position:absolute;inset:0;z-index:10;pointer-events:none}
.hero-body__hand-glow{position:absolute;z-index:0;left:50%;top:var(--ty);width:50cqw;height:50cqw;margin:-25cqw 0 0 -25cqw;border-radius:50%;background:radial-gradient(circle,rgba(255,255,255,.5),rgba(255,255,255,.1) 45%,transparent 70%)}
.hero-hand{position:absolute;width:var(--w);aspect-ratio:1671/941}
.hero-hand img{display:block;width:100%;height:100%;max-width:none;object-fit:contain;will-change:transform}
.hero-hand--patient{z-index:2;left:calc(-1*var(--L));top:calc(var(--ty) - var(--w)*.1588)}
.hero-hand--clinician{z-index:1;right:calc(-1*var(--L));top:calc(var(--ty2) - var(--w)*.2816)}

.care-panel{position:absolute;z-index:25;left:4cqw;right:4cqw;top:204cqw;display:flex;gap:3cqw;padding:2.5cqw;border:1px solid rgba(11,10,10,.06);border-radius:5cqw;background:var(--color-white);box-shadow:var(--shadow-md)}
.care-panel__media{position:relative;flex:0 0 30cqw;min-height:24cqw;overflow:hidden;padding:2.5cqw;display:flex;flex-direction:column;justify-content:flex-end;border-radius:3.5cqw;background:linear-gradient(145deg,var(--color-bg),var(--brand-06));color:var(--color-ink)}
.care-panel__media img{position:absolute;top:2.5cqw;right:2.5cqw;width:30%;height:auto;opacity:.12;filter:grayscale(1)}
.care-panel__media-kicker,.care-panel__media-meta{position:relative;z-index:2;font-size:max(6px,1.9cqw);line-height:1.25;letter-spacing:.1em;text-transform:uppercase}
.care-panel__media-kicker{color:var(--color-brand);font-weight:700}
.care-panel__media strong{position:relative;z-index:2;font-family:var(--font-display);font-size:6.2cqw;line-height:.95;letter-spacing:-.04em}
.care-panel__media-meta{margin-top:1cqw;color:var(--text-secondary);letter-spacing:.02em;text-transform:none;font-size:max(7px,2.1cqw)}
.care-panel__media-mark{position:absolute;right:2.2cqw;bottom:2.2cqw;width:2cqw;height:2cqw;border-radius:50%;background:var(--color-brand);box-shadow:0 0 0 1.5cqw var(--brand-12)}
.care-panel__content{display:flex;flex:1;min-width:0;flex-direction:column;justify-content:center}
.care-panel__topline{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:3cqw;color:var(--color-ink);font-size:max(9px,2.3cqw);font-weight:500;white-space:nowrap}
.care-panel__topline i{display:block;width:28px;height:6px;border-radius:var(--radius-pill);background:var(--brand-12)}
.care-panel__topline i::after{content:'';display:block;width:14px;height:6px;border-radius:inherit;background:var(--color-brand)}
.care-highlights{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:2.5cqw}
.care-highlight{position:relative;min-width:0}
.care-highlight:not(:first-child)::before{content:'';position:absolute;left:-1.4cqw;top:0;width:1px;height:90%;background:var(--line)}
.care-highlight strong{display:block;margin:0 0 1cqw;color:var(--color-brand);font-family:var(--font-display);font-size:5.2cqw;line-height:1;font-weight:700;letter-spacing:-.04em;white-space:nowrap}
.care-highlight span{display:block;color:var(--color-ink);font-size:max(8px,2cqw);line-height:1.25}

.service-pills{position:absolute;z-index:25;left:4cqw;right:4cqw;top:236cqw;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:2cqw}
.service-pills span{display:flex;align-items:center;justify-content:center;gap:1.4cqw;min-height:11cqw;padding:0 1.5cqw;border-radius:var(--radius-pill);background:rgba(255,255,255,.92);color:var(--color-brand);font-size:max(8px,2.2cqw);line-height:1.05;text-align:center}
.service-pills svg{flex:0 0 auto;width:max(11px,2.6cqw);height:auto}

.feedback{position:absolute;z-index:25;left:7cqw;right:7cqw;top:252cqw;display:flex;justify-content:space-between;align-items:center;gap:3cqw;color:var(--color-white)}
.feedback p{margin:0;max-width:55%;font-size:3.4cqw;line-height:1.3}
.feedback__avatars{display:flex;justify-content:flex-end}
.feedback__avatars span{display:block;width:9cqw;height:9cqw;margin-left:-2cqw;border:2px solid rgba(255,255,255,.9);border-radius:50%;overflow:hidden;background:var(--color-white);box-shadow:0 3px 12px rgba(11,10,10,.12)}
.feedback__avatars img{display:block;width:100%;height:100%;object-fit:cover;object-position:center top}
.hero-arrow{display:none}

/* No-flash start state (class is added by the inline script above, removed once GSAP takes over) */
:global(html.hero-anim) .hero-hand img,
:global(html.hero-anim) .hero-body__hand-glow,
:global(html.hero-anim) [data-in],
:global(html.hero-anim) .care-panel,
:global(html.hero-anim) .service-pills,
:global(html.hero-anim) .feedback{opacity:0}

/* ================= TABLET 700–1023 ================= */
@media (min-width:700px){
  .hero-body{height:max(calc(100svh - 24px),165vw);--wn:78;--ty:90cqw;--ty2:87cqw}
  .hero-body__white{clip-path:ellipse(58cqw 90cqw at 0 40cqw)}
  .hero-body__copy{left:6cqw;top:17cqw;width:56cqw}
  .eyebrow{margin-bottom:2.4cqw}
  h1{font-size:6.4cqw}
  .intro{max-width:46cqw;font-size:2.1cqw;margin:2.4cqw 0 3cqw}
  .hero-body__right-copy{left:63cqw;top:19cqw;width:31cqw}
  .hero-body__right-copy h2{font-size:3.6cqw;margin-bottom:1.6cqw}
  .hero-body__right-copy p{font-size:1.9cqw}
  .care-panel{top:124cqw;left:5cqw;right:5cqw}
  .care-panel__media{flex-basis:24cqw;min-height:16cqw}
  .care-panel__media-kicker{font-size:1.2cqw}.care-panel__media strong{font-size:4cqw}.care-panel__media-meta{font-size:1.3cqw}
  .care-panel__topline{font-size:1.5cqw}
  .care-highlight strong{font-size:3.6cqw}.care-highlight span{font-size:1.4cqw}
  .service-pills{top:147cqw;left:5cqw;right:5cqw}
  .service-pills span{min-height:6.4cqw;font-size:1.5cqw}.service-pills svg{width:2cqw}
  .feedback{top:157cqw;left:6cqw;right:6cqw}
  .feedback p{font-size:1.9cqw}
  .feedback__avatars span{width:5.4cqw;height:5.4cqw}
}

/* ================= DESKTOP 1024+ ================= */
@media (min-width:1024px){
  .hero-body{height:max(600px,calc(100svh - clamp(16px,2.3vw,36px)));--w:min(62cqw,120cqh);--L:1cqw;--ty:53cqh;--ty2:50cqh}
  .hero-body__white{right:auto;width:54%;clip-path:ellipse(100% 82% at 0% 50%)}
  .hero-body__copy{left:5cqw;top:19cqh;width:46cqw}
  .eyebrow{font-size:11px;margin-bottom:20px}
  h1{font-size:min(5.2cqw,4.8rem)}
  .intro{max-width:400px;font-size:15px;margin:24px 0 28px}
  .hero-body__right-copy{left:64cqw;top:14cqh;width:28cqw}
  .hero-body__right-copy h2{font-size:clamp(1.5rem,2.4cqw,2.2rem);margin-bottom:12px}
  .hero-body__right-copy p{font-size:14px;line-height:1.5}
  .hero-body__hand-glow{left:51%;width:26cqw;height:26cqw;margin:-13cqw 0 0 -13cqw}
  .care-panel{top:auto;left:3.2cqw;right:auto;bottom:4cqh;width:min(41cqw,600px);padding:12px;gap:18px;border-radius:22px}
  .care-panel__media{flex-basis:clamp(120px,11.5cqw,174px);min-height:116px;padding:14px;border-radius:14px}
  .care-panel__media img{top:12px;right:12px}
  .care-panel__media-kicker{font-size:9px}.care-panel__media strong{font-size:26px}.care-panel__media-meta{font-size:10px}
  .care-panel__media-mark{right:10px;bottom:10px;width:8px;height:8px;box-shadow:0 0 0 6px var(--brand-12)}
  .care-panel__topline{font-size:11px;margin-bottom:18px}
  .care-highlights{gap:20px}
  .care-highlight:not(:first-child)::before{left:-10px;height:42px}
  .care-highlight strong{font-size:clamp(20px,1.9cqw,30px)}.care-highlight span{font-size:10px}
  .service-pills{top:auto;left:auto;right:17cqw;bottom:13cqh;display:flex;gap:10px}
  .service-pills span{min-height:0;padding:13px 20px;gap:8px;font-size:11px;background:rgba(255,255,255,.14);color:var(--color-white);border:1px solid rgba(255,255,255,.4);backdrop-filter:blur(12px);white-space:nowrap}
  .service-pills svg{width:14px}
  .feedback{top:auto;left:auto;right:3cqw;bottom:13cqh;display:block;width:200px}
  .feedback p{max-width:none;margin-bottom:10px;font-size:11px}
  .feedback__avatars span{width:32px;height:32px;margin-left:-7px}
  .hero-arrow{position:absolute;z-index:18;right:12cqw;bottom:2.2cqw;display:grid;place-items:center;color:var(--color-white)}
}
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  let started = false;
  function initHero() {
    const body = document.querySelector<HTMLElement>('.hero-body');
    const frame = document.querySelector<HTMLElement>('.hero__frame');
    const hero = document.querySelector<HTMLElement>('.hero');
    if (!body || !frame || !hero || started) return;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return; // static hero
    started = true;

    // 1) Entrance: hands slide in from their own edges, glow blooms where fingertips meet.
    gsap.timeline({ defaults: { ease: 'power3.out' } })
      .fromTo('.hero-hand--patient img', { xPercent: -75, opacity: 0 }, { xPercent: 0, opacity: 1, duration: 1.6 }, 0)
      .fromTo('.hero-hand--clinician img', { xPercent: 75, opacity: 0 }, { xPercent: 0, opacity: 1, duration: 1.6 }, 0)
      .fromTo('.hero-body__hand-glow', { scale: 0.2, opacity: 0 }, { scale: 1, opacity: 1, duration: 1.4, ease: 'power2.out' }, 1.1)
      .fromTo('[data-in]', { y: 30, opacity: 0 }, { y: 0, opacity: 1, duration: 0.9, stagger: 0.09 }, 0.25)
      .fromTo('.care-panel, .service-pills, .feedback', { y: 40, opacity: 0 }, { y: 0, opacity: 1, duration: 0.9, stagger: 0.12 }, 0.9)
      .add(() => { gsap.to('.hero-hand img', { y: 7, duration: 3.6, yoyo: true, repeat: -1, ease: 'sine.inOut', stagger: 0.7 }); }, 1.7);
    document.documentElement.classList.remove('hero-anim');

    // 2) Scroll: the hero scrolls away normally (no pinning). While it leaves, the hands
    //    retreat to the edges they came from. Reverses when scrolling back up.
    const reach = () => body.offsetWidth * 1.1;
    gsap.timeline({
      scrollTrigger: { trigger: frame, start: 'top top', end: () => '+=' + innerHeight * 0.8, scrub: 0.6, invalidateOnRefresh: true },
    })
      .to('.hero-hand--patient', { x: () => -reach(), ease: 'none', duration: 1 }, 0)
      .to('.hero-hand--clinician', { x: () => reach(), ease: 'none', duration: 1 }, 0)
      .to('.hero-body__hand-glow', { opacity: 0, scale: 0.3, duration: 0.4 }, 0);
  }

  initHero();
  document.addEventListener('astro:page-load', initHero); // only fires if View Transitions are on
</script>