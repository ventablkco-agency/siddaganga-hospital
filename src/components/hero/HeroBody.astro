---
import IconSlideButton from '../ui/IconSlideButton.astro';
---

<div class="hero-body">
  <div class="hero-body__grid" aria-hidden="true"></div>
  <div class="hero-body__blue-panel" aria-hidden="true"></div>

  <div class="hero-body__copy">
    <p class="eyebrow">SIDDAGANGA HOSPITAL · RANEBENNUR</p>

    <h1>
      <span>Heart &amp;</span>
      <span><em>Diabetes</em>, in <strong>Sync</strong></span>
    </h1>

    <p class="intro">
      Specialist care, advanced diagnostics and a team that listens carefully to every patient.
    </p>

    <IconSlideButton
      href="https://wa.me/919591799099"
      label="Book Appointment"
      newTab={true}
      variant="blue"
    />
  </div>

  <div class="hero-body__right-copy">
    <h2>With Specialist<br />Technology</h2>
    <p>
      The latest diagnostic equipment, paired with a team that never rushes a conversation — because every patient deserves both.
    </p>
  </div>

  <div class="hero-body__hands" aria-hidden="true">
    <div class="hero-body__hand-glow"></div>
    <img class="hand hand--clinician" src="/assets/hero/clinician-hand.png" alt="" />
    <img class="hand hand--patient" src="/assets/hero/patient-hand.png" alt="" />
  </div>

  <aside class="care-panel" aria-label="Siddaganga Hospital care highlights">
    <div class="care-panel__media" aria-hidden="true">
      <div class="care-panel__placeholder">
        <span>SGH</span>
        <small>Siddaganga Hospital</small>
      </div>
      <span class="care-panel__play">→</span>
      <span class="care-panel__caption">Hospital</span>
      <span class="care-panel__dot"></span>
    </div>

    <div class="care-panel__content">
      <div class="care-panel__label">our care in numbers</div>
      <div class="care-panel__rule" aria-hidden="true"><i></i></div>

      <div class="stats">
        <div class="stat">
          <strong>4.5★</strong>
          <span>Google<br />rating</span>
        </div>
        <div class="stat">
          <strong>24×7</strong>
          <span>emergency<br />care</span>
        </div>
        <div class="stat">
          <strong>2D</strong>
          <span>Echo +<br />TMT</span>
        </div>
      </div>
    </div>
  </aside>

  <div class="service-pills" aria-label="Hospital highlights">
    <span><b>♧</b>24×7 Emergency</span>
    <span><b>⌬</b>On-site Lab</span>
    <span><b>♙</b>Family Care</span>
  </div>

  <div class="feedback" aria-hidden="true">
    <p>We appreciate every feedback<br />because it inspires us to<br />become better.</p>
    <div class="feedback__avatars">
      <span></span><span></span><span></span>
    </div>
  </div>

  <div class="hero-arrow" aria-hidden="true">→</div>
</div>

<style>
.hero-body{
  position:relative;
  width:100%;
  min-height:100%;
  height:100%;
  overflow:hidden;
  isolation:isolate;
  background:var(--color-white);
}

.hero-body::before{
  content:"";
  position:absolute;
  inset:clamp(8px, 1.1vw, 18px);
  border-radius:clamp(18px, 1.8vw, 28px);
  background:var(--color-white);
  z-index:0;
}

.hero-body__grid{
  position:absolute;
  inset:0;
  z-index:1;
  pointer-events:none;
  opacity:.42;
  background:
    linear-gradient(rgba(11,10,10,.018) 1px,transparent 1px),
    linear-gradient(90deg,rgba(11,10,10,.018) 1px,transparent 1px);
  background-size:clamp(72px, 8vw, 128px) 100%,100% clamp(72px, 8vw, 128px);
}

/* The blue side is a fluid panel rather than a fixed rectangle. Its curved
   inner edge keeps the hero visually connected to the white side. */
.hero-body__blue-panel{
  position:absolute;
  z-index:2;
  top:clamp(12px, 1.45vw, 24px);
  right:clamp(12px, 1.45vw, 24px);
  bottom:clamp(12px, 1.45vw, 24px);
  left:clamp(38%, 40vw, 43%);
  overflow:hidden;
  border-radius:clamp(72px, 8vw, 150px) clamp(14px, 1.5vw, 24px) clamp(14px, 1.5vw, 24px) clamp(72px, 8vw, 150px);
  background:var(--color-brand);
}

.hero-body__blue-panel::before{
  content:"";
  position:absolute;
  inset:0;
  background:
    radial-gradient(ellipse at 48% 18%,rgba(255,255,255,.24) 0%,rgba(255,255,255,.08) 34%,transparent 62%),
    radial-gradient(ellipse at 16% 74%,rgba(255,255,255,.08),transparent 44%);
}

.hero-body__copy{
  position:absolute;
  z-index:10;
  left:clamp(28px, 3.6vw, 56px);
  top:clamp(150px, 23vh, 230px);
  width:min(48vw, 700px);
}

.eyebrow{
  margin:0 0 clamp(16px, 1.6vw, 24px);
  color:var(--text-secondary);
  font-size:clamp(9px,.7vw,11px);
  line-height:1;
  font-weight:500;
  letter-spacing:.17em;
  text-transform:uppercase;
}

h1{
  margin:0;
  width:100%;
  color:var(--color-ink);
  font-family:var(--font-display);
  font-size:clamp(3.5rem, 6.2vw, 5.5rem);
  line-height:.9;
  letter-spacing:var(--track-display);
  font-weight:800;
}

h1 span{display:block}
h1 em{font-style:normal;color:var(--color-brand)}
h1 strong{font-weight:800;color:var(--color-ink)}

.intro{
  max-width:clamp(300px, 30vw, 420px);
  margin:clamp(20px, 2.2vw, 32px) 0 clamp(20px, 2.2vw, 32px);
  color:var(--text-secondary);
  font-size:clamp(12px, .9vw, 14px);
  line-height:1.55;
}

.hero-body__right-copy{
  position:absolute;
  z-index:10;
  left:clamp(57%, 58vw, 62%);
  top:clamp(190px, 23vh, 250px);
  width:min(32vw, 480px);
  color:var(--color-white);
}

.hero-body__right-copy h2{
  margin:0 0 clamp(22px, 2.1vw, 32px);
  font-family:var(--font-display);
  font-size:clamp(2.25rem, 3.65vw, 3.4rem);
  line-height:.9;
  letter-spacing:var(--track-display);
  font-weight:700;
}

.hero-body__right-copy p{
  margin:0;
  width:100%;
  font-size:clamp(13px, 1.35vw, 21px);
  line-height:1.08;
  color:var(--color-white);
}

.hero-body__hands{
  position:absolute;
  z-index:5;
  inset:0;
  pointer-events:none;
}

.hero-body__hand-glow{
  position:absolute;
  z-index:0;
  right:3%;
  top:7%;
  width:58%;
  height:58%;
  border-radius:50%;
  background:radial-gradient(circle,var(--brand-22) 0%,rgba(255,255,255,.18) 40%,transparent 72%);
}

.hand{
  position:absolute;
  object-fit:contain;
  filter:none;
  will-change:transform;
}

.hand--clinician{
  z-index:4;
  width:clamp(48%, 61vw, 68%);
  right:clamp(-9%, -5vw, -2%);
  top:clamp(20%, 24vh, 29%);
  animation:clinicianFloat 7s ease-in-out infinite;
}

.hand--patient{
  z-index:6;
  width:clamp(48%, 61vw, 69%);
  left:clamp(-10%, -5vw, -2%);
  top:clamp(31%, 34vh, 40%);
  animation:patientFloat 7s ease-in-out -1s infinite;
}

.care-panel{
  position:absolute;
  z-index:12;
  left:clamp(24px, 3.2vw, 52px);
  bottom:clamp(18px, 2.7vw, 42px);
  display:flex;
  align-items:center;
  width:clamp(430px, 39vw, 600px);
  min-height:clamp(142px, 11vw, 176px);
  padding:clamp(9px, .85vw, 14px) clamp(18px, 2vw, 30px) clamp(9px, .85vw, 14px) clamp(9px, .85vw, 14px);
  gap:clamp(18px, 2vw, 30px);
  border-radius:clamp(14px, 1.2vw, 18px);
  background:var(--color-white);
  box-shadow:var(--shadow-md);
}

.care-panel__media{
  position:relative;
  width:clamp(118px, 11.5vw, 170px);
  height:clamp(118px, 9.6vw, 146px);
  flex:0 0 auto;
  border-radius:var(--radius-sm);
  overflow:hidden;
  background:var(--color-bg);
}

.care-panel__placeholder{
  position:absolute;
  inset:0;
  display:flex;
  flex-direction:column;
  justify-content:flex-end;
  padding:14px;
  background:
    radial-gradient(circle at 72% 28%,rgba(36,106,254,.26),transparent 28%),
    linear-gradient(145deg,var(--color-bg),var(--brand-12));
  color:var(--color-ink);
}

.care-panel__placeholder span{
  font-family:var(--font-display);
  font-size:clamp(24px, 2.3vw, 34px);
  font-weight:800;
  letter-spacing:-.05em;
}

.care-panel__placeholder small{
  margin-top:2px;
  font-size:clamp(7px,.6vw,9px);
  color:var(--text-secondary);
}

.care-panel__play{
  position:absolute;
  top:10px;
  right:10px;
  width:clamp(28px, 2.3vw, 36px);
  height:clamp(28px, 2.3vw, 36px);
  display:grid;
  place-items:center;
  border-radius:50%;
  background:var(--color-white);
  color:var(--color-brand);
  font-size:13px;
  box-shadow:var(--shadow-sm);
}

.care-panel__caption{
  position:absolute;
  left:12px;
  bottom:10px;
  color:var(--color-ink);
  font-size:9px;
  font-weight:600;
}

.care-panel__dot{
  position:absolute;
  right:10px;
  bottom:9px;
  width:7px;
  height:7px;
  border-radius:50%;
  background:var(--color-brand);
}

.care-panel__content{position:relative;flex:1;min-width:0}

.care-panel__label{
  position:absolute;
  left:0;
  top:clamp(-20px,-1.5vw,-14px);
  color:var(--color-ink);
  font-size:clamp(9px,.75vw,12px);
  font-weight:500;
  white-space:nowrap;
}

.care-panel__rule{
  position:absolute;
  right:0;
  top:clamp(-24px,-1.7vw,-15px);
  width:28px;
  height:6px;
  border-radius:var(--radius-pill);
  background:var(--brand-12);
}

.care-panel__rule i{display:block;width:14px;height:6px;border-radius:inherit;background:var(--color-brand)}

.stats{display:flex;align-items:flex-start;gap:clamp(18px,2.3vw,36px);margin-top:clamp(16px,2vw,25px)}

.stat{position:relative;min-width:0}
.stat:not(:first-child)::before{content:"";position:absolute;left:clamp(-18px,-1.2vw,-10px);top:0;width:1px;height:clamp(44px,4vw,62px);background:var(--line)}
.stat strong{display:block;margin:0 0 5px;color:var(--color-brand);font-family:var(--font-body);font-size:clamp(25px,2.5vw,38px);line-height:1;font-weight:500;letter-spacing:-.04em}
.stat span{display:block;color:var(--color-ink);font-size:clamp(8px,.72vw,11px);line-height:1.18}

.service-pills{
  position:absolute;
  z-index:12;
  right:clamp(7%, 8vw, 11%);
  bottom:clamp(54px, 7.2vw, 88px);
  display:flex;
  gap:clamp(8px, .9vw, 14px);
}

.service-pills span{
  display:inline-flex;
  align-items:center;
  gap:9px;
  padding:clamp(11px,1vw,15px) clamp(17px,1.5vw,23px);
  border:1px solid rgba(255,255,255,.4);
  border-radius:var(--radius-pill);
  background:rgba(255,255,255,.13);
  color:var(--color-white);
  font-size:clamp(9px,.72vw,11px);
  white-space:nowrap;
  backdrop-filter:blur(12px);
}

.service-pills b{font-size:14px;font-weight:400;color:var(--color-white)}

.feedback{position:absolute;z-index:12;right:clamp(24px,3vw,48px);bottom:clamp(18px,2.2vw,32px);color:var(--color-white);text-align:right}
.feedback p{margin:0 0 10px;font-size:clamp(7px,.6vw,9px);line-height:1.35}
.feedback__avatars{display:flex;justify-content:flex-end}
.feedback__avatars span{width:clamp(24px,2vw,31px);height:clamp(24px,2vw,31px);margin-left:-7px;border:2px solid rgba(255,255,255,.86);border-radius:50%;background:var(--color-bg)}
.feedback__avatars span:nth-child(2){background:var(--brand-12)}
.feedback__avatars span:nth-child(3){background:var(--brand-22)}
.hero-arrow{position:absolute;z-index:12;right:clamp(120px,13vw,190px);bottom:clamp(30px,3vw,48px);color:var(--color-white);font-size:clamp(22px,2vw,28px);font-weight:300}

@keyframes clinicianFloat{0%,100%{transform:translate3d(0,0,0)}50%{transform:translate3d(-7px,6px,0)}}
@keyframes patientFloat{0%,100%{transform:translate3d(0,0,0)}50%{transform:translate3d(7px,-5px,0)}}

@media (max-width:1100px){
  .hero-body__blue-panel{left:38%;border-radius:clamp(58px,7vw,100px) 18px 18px clamp(58px,7vw,100px)}
  .hero-body__copy{width:min(47vw,620px)}
  .hero-body__right-copy{left:57%;width:34%}
  .service-pills{right:5%;transform:scale(.9);transform-origin:right bottom}
  .feedback{display:none}
}

@media (max-width:860px){
  .hero-body__copy{top:17%;width:54%;}
  .hero-body__blue-panel{left:35%;}
  .hero-body__right-copy{top:18%;left:58%;width:34%;}
  .hero-body__right-copy p{line-height:1.2}
  .care-panel{width:clamp(390px,48vw,520px)}
  .service-pills{bottom:5%;transform:scale(.78);}
  .hero-arrow{display:none}
}

@media (max-width:760px){
  .hero-body{height:auto;min-height:760px}
  .hero-body::before{inset:8px;border-radius:22px}
  .hero-body__grid{opacity:.2}
  .hero-body__blue-panel{
    left:8px;
    right:8px;
    top:42%;
    bottom:8px;
    border-radius:clamp(52px,13vw,92px) 20px 20px 20px;
  }
  .hero-body__copy{left:24px;right:24px;top:104px;width:auto}
  .eyebrow{margin-bottom:18px;font-size:8px}
  h1{font-size:clamp(3.1rem,13vw,4.5rem)}
  .intro{max-width:310px;font-size:11px}
  .hero-body__right-copy{left:24px;right:24px;top:auto;bottom:300px;width:auto}
  .hero-body__right-copy h2{font-size:28px;letter-spacing:-.04em}
  .hero-body__right-copy p{font-size:11px;line-height:1.35}
  .hero-body__hand-glow{width:90%;height:45%;right:-7%;top:38%}
  .hand--clinician{width:85%;right:-15%;top:49%}
  .hand--patient{width:88%;left:-5%;top:57%}
  .care-panel{
    left:18px;
    right:18px;
    bottom:18px;
    width:auto;
    min-height:120px;
    padding:7px 10px 7px 7px;
    gap:12px;
    border-radius:20px;
  }
  .care-panel__media{width:110px;height:106px}
  .care-panel__label{top:-2px;font-size:8px}
  .care-panel__rule{top:-4px;transform:scale(.75);transform-origin:right}
  .stats{gap:10px;margin-top:25px}
  .stat:not(:first-child)::before{left:-6px;height:49px}
  .stat strong{font-size:21px}
  .stat span{font-size:7px}
  .service-pills,.feedback,.hero-arrow{display:none}
}

@media (prefers-reduced-motion:reduce){.hand--clinician,.hand--patient{animation:none}}
</style>
