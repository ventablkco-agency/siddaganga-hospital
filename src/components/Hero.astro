---
import Header from './navigation/Header.astro';
import MenuOverlay from './navigation/MenuOverlay.astro';
---
<section id="home" class="hero">
  <Header />
  <MenuOverlay />
  <div class="hero__grid" aria-hidden="true"></div>
  <div class="hero__copy">
    <p class="eyebrow">Siddaganga Hospital · Ranebennur</p>
    <h1><span>Heart &amp;</span><span>Diabetes, <em>In Sync</em></span></h1>
    <p class="intro">Specialist care, advanced diagnostics and a team that listens carefully to every patient.</p>
    <a class="cta" href="https://wa.me/919591799099" target="_blank" rel="noreferrer"><span>Book Appointment</span><span aria-hidden="true">↗</span></a>
    <div class="pills"><span>24×7 Emergency</span><span>On-site Lab</span><span>Family Care</span></div>
  </div>
  <div class="hero__visual">
    <div class="orb"></div>
    <img class="hand hand--patient" src="/assets/hero/patient-hand.png" alt="" />
    <img class="hand hand--clinician" src="/assets/hero/clinician-hand.png" alt="" />
  </div>
  <aside class="technology">
    <span class="technology__number">01</span>
    <div><p class="technology__title">With Specialist Technology</p><p>The latest diagnostic equipment, paired with a team that never rushes a conversation — because every patient deserves both.</p></div>
  </aside>
  <div class="stats"><div><strong>15+</strong><span>years of experience</span></div><div><strong>20+</strong><span>highly qualified doctors</span></div><div><strong>100%</strong><span>advanced diagnostics</span></div></div>
  <div class="scroll">Scroll to explore <span></span></div>
</section>
<style>
.hero{position:relative;min-height:100svh;overflow:hidden;background:#f7f9fc;isolation:isolate}.hero__grid{position:absolute;inset:0;opacity:.55;background:linear-gradient(90deg,transparent 49.95%,rgba(17,19,23,.045) 50%,transparent 50.05%),linear-gradient(0deg,transparent 49.95%,rgba(17,19,23,.035) 50%,transparent 50.05%);background-size:25% 100%,100% 25%;pointer-events:none}.hero__copy{position:relative;z-index:4;width:min(760px,58vw);padding:clamp(150px,18vh,210px) 0 160px var(--page-pad)}.eyebrow{margin:0 0 28px;font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:#747a83}.hero h1{margin:0;font-family:var(--font-display);font-size:clamp(58px,7.4vw,118px);line-height:.88;letter-spacing:-.07em;font-weight:600}.hero h1 span{display:block}.hero h1 em{font-style:normal;color:var(--color-blue)}.intro{max-width:420px;margin:32px 0 24px;color:var(--color-muted);font-size:15px;line-height:1.7}.cta{display:inline-flex;align-items:center;gap:28px;padding:15px 18px 15px 22px;background:#111317;color:#fff;border-radius:999px;font-size:13px}.cta span:last-child{width:28px;height:28px;border-radius:50%;display:grid;place-items:center;background:#fff;color:#111317}.pills{display:flex;flex-wrap:wrap;gap:8px;margin-top:22px}.pills span{padding:9px 13px;border:1px solid var(--color-line);border-radius:999px;background:rgba(255,255,255,.55);font-size:11px;color:#555b63}.hero__visual{position:absolute;z-index:2;inset:0 0 0 43%;pointer-events:none}.orb{position:absolute;width:min(54vw,780px);height:min(54vw,780px);right:-8%;top:50%;transform:translateY(-50%);border-radius:50%;background:radial-gradient(circle at 38% 35%,#fff 0,#eef5fb 42%,#dcecf9 100%);box-shadow:var(--shadow-soft)}.hand{position:absolute;object-fit:contain;filter:drop-shadow(0 25px 35px rgba(20,40,60,.12));will-change:transform}.hand--patient{width:min(44vw,650px);right:4%;top:38%;z-index:3}.hand--clinician{width:min(38vw,560px);right:18%;top:19%;z-index:2}.technology{position:absolute;right:var(--page-pad);bottom:130px;z-index:5;width:min(330px,27vw);padding:20px;border:1px solid rgba(17,19,23,.1);border-radius:22px;background:rgba(255,255,255,.72);backdrop-filter:blur(18px);box-shadow:0 18px 55px rgba(20,40,60,.08)}.technology__number{font-size:10px;color:#7c828a}.technology__title{margin:10px 0 8px;font-family:var(--font-display);font-weight:600;font-size:16px}.technology p:last-child{margin:0;color:#6b7179;font-size:11px;line-height:1.65}.stats{position:absolute;left:var(--page-pad);right:var(--page-pad);bottom:34px;z-index:6;display:flex;gap:clamp(28px,5vw,80px)}.stats div{display:flex;align-items:baseline;gap:9px}.stats strong{font-family:var(--font-display);font-size:18px}.stats span{font-size:10px;color:#777d85}.scroll{position:absolute;right:var(--page-pad);bottom:40px;font-size:10px;color:#7c828a;display:flex;align-items:center;gap:10px}.scroll span{display:block;width:45px;height:1px;background:#a7adb4}
@media(max-width:900px){.hero{min-height:900px}.hero__copy{width:100%;padding-right:var(--page-pad);padding-bottom:420px}.hero h1{font-size:clamp(54px,12vw,86px)}.hero__visual{inset:42% 0 100px 0}.orb{width:100vw;height:100vw;right:-22%;top:52%}.hand--patient{width:85vw;right:-4%;top:37%}.hand--clinician{width:70vw;right:13%;top:19%}.technology{right:var(--page-pad);bottom:115px;width:min(360px,calc(100% - 40px))}.stats{bottom:28px;gap:18px}.stats div{display:block}.stats strong,.stats span{display:block}.scroll{display:none}}
@media(max-width:560px){.hero{min-height:850px}.hero__copy{padding-top:135px}.eyebrow{margin-bottom:20px}.intro{font-size:13px;margin-top:25px}.technology{bottom:112px;padding:16px}.stats{gap:12px}.stats strong{font-size:15px}.stats span{font-size:9px;line-height:1.3;margin-top:3px}.pills{max-width:330px}}
</style>
