---
import HeroBody from './hero/HeroBody.astro';
---

<section id="home" class="hero">
  <div class="hero__frame">
    <HeroBody />
  </div>
</section>

<style>
  .hero {
    min-height: 100svh;
    padding: 16px;
    background: #f5f8fc;
    overflow: hidden;
  }

  .hero__frame {
    position: relative;
    min-height: calc(100svh - 32px);
    overflow: hidden;
    isolation: isolate;
    border-radius: 30px;
    background: #f8fafc;
    box-shadow: 0 20px 70px rgba(21, 48, 77, 0.07);
  }

  .hero__frame::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 40;
    border: 1px solid rgba(255, 255, 255, 0.96);
    border-radius: inherit;
    pointer-events: none;
  }

  @media (max-width: 760px) {
    .hero { padding: 8px; }
    .hero__frame {
      min-height: calc(100svh - 16px);
      border-radius: 22px;
    }
  }
</style>
