---
import HeroBody from './hero/HeroBody.astro';
---

<section id="home" class="hero">
  <div class="hero__frame">
    <HeroBody />
  </div>
</section>

<style>
  /* The page background is the selected #EBF0FE. The frame below is the
     single hero card; HeroBody fills it instead of creating another card. */
  .hero {
    min-height: 100svh;
    padding: clamp(8px, 1.15vw, 18px);
    background: var(--color-bg);
    overflow: hidden;
  }

  .hero__frame {
    position: relative;
    min-height: calc(100svh - clamp(16px, 2.3vw, 36px));
    overflow: hidden;
    isolation: isolate;
    border-radius: clamp(22px, 2.1vw, 32px);
    background: var(--color-white);
    box-shadow: var(--shadow-sm);
  }

  /* Desktop split-field correction. HeroBody owns the actual responsive
     composition; this only establishes the approved desktop colour field. */
  :global(.hero) :global(.hero-body) {
    background:
      radial-gradient(ellipse at 72% 18%, rgba(255,255,255,.22) 0%, rgba(255,255,255,.08) 28%, transparent 55%),
      radial-gradient(ellipse at 90% 78%, rgba(255,255,255,.08), transparent 42%),
      #246AFE !important;
  }

  :global(.hero) :global(.hero-body)::before {
    background: #FFFFFF !important;
  }

  /* Hero-only appointment button: the button changes surface on hover,
     while its circular icon area stays white and only the arrow becomes white. */
  :global(.hero) a[href^="https://wa.me/"] .icon-slide-button__icon::after {
    display: none;
  }

  :global(.hero) a[href^="https://wa.me/"]:hover .icon-slide-button__icon,
  :global(.hero) a[href^="https://wa.me/"]:focus-visible .icon-slide-button__icon {
    background: var(--button-fill);
    color: var(--color-white);
  }

  :global(.hero) a[href^="https://wa.me/"]:hover .icon-slide-button__icon svg,
  :global(.hero) a[href^="https://wa.me/"]:focus-visible .icon-slide-button__icon svg {
    color: var(--color-white);
  }

  .hero__frame::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 40;
    border: 1px solid rgba(255, 255, 255, 0.96);
    border-radius: inherit;
    pointer-events: none;
  }

  /*
   * Responsive layout is intentionally NOT overridden here.
   *
   * HeroBody.astro is now mobile-first and owns the responsive composition:
   * copy/CTA -> hands -> specialist technology -> pills -> care panel.
   *
   * Previously this wrapper re-positioned those same elements with absolute
   * top/left values at 860px, 600px and 380px. That defeated the flow layout
   * and was the reason the CTA, blue field, hands and specialist copy kept
   * colliding on mobile. Keep this wrapper concerned only with the frame.
   */

  @media (max-width: 760px) {
    .hero__frame {
      min-height: calc(100svh - 16px);
      border-radius: 22px;
    }
  }
</style>
