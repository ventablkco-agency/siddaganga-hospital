---
import HeroBody from './hero/HeroBody.astro';
---

<section id="home" class="hero">
  <div class="hero__frame">
    <HeroBody />
  </div>
</section>

<style>
  .hero {
    width: 100%;
    height: 720px;
    min-height: 0;
    margin: 0;
    padding: 0;
    overflow: hidden;
    background: #fff;
  }

  .hero__frame {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 0;
    overflow: hidden;
    isolation: isolate;
    border-radius: 0;
    background: #246afe;
    box-shadow: none;
  }

  @media (min-width: 700px) and (max-width: 900px) {
    .hero { height: 1040px; }
  }

  @media (max-width: 699px) {
    .hero { height: 1360px; }
  }

  @media (max-width: 339px) {
    .hero { height: 1399px; }
  }
</style>