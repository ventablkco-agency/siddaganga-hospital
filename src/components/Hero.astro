---
import Header from './navigation/Header.astro';
import MenuOverlay from './navigation/MenuOverlay.astro';
---

<section id="home" class="hero">
  <div class="hero__frame">
    <div class="hero__ambient" aria-hidden="true"></div>
    <div class="hero__halo" aria-hidden="true"></div>

    <Header />
    <MenuOverlay />

    <div class="hero__copy">
      <p class="eyebrow">SIDDAGANGA HOSPITAL · RANEBENNUR</p>

      <h1>
        <span>Heart &amp;</span>
        <span>Diabetes, <em>In</em></span>
        <span><em>Sync</em></span>
      </h1>

      <p class="intro">
        Specialist care, advanced diagnostics and a team that listens carefully to every patient.
      </p>

      <a class="cta" href="https://wa.me/919591799099" target="_blank" rel="noreferrer">
        <span>Book Appointment</span>
        <span class="cta__arrow" aria-hidden="true">↗</span>
      </a>
    </div>

    <div class="hero__visual" aria-hidden="true">
      <div class="hero__light-orb"></div>
      <img class="hand hand--clinician" src="/assets/hero/clinician-hand.png" alt="" />
      <img class="hand hand--patient" src="/assets/hero/patient-hand.png" alt="" />
    </div>

    <aside class="technology-card">
      <span class="technology-card__number">01</span>
      <h2>With Specialist Technology</h2>
      <p>
        The latest diagnostic equipment, paired with a team that never rushes a conversation — because every patient deserves both.
      </p>
    </aside>

    <div class="care-stats" aria-label="Hospital care statistics">
      <div class="care-stat">
        <strong>15+</strong>
        <span>years of experience</span>
      </div>
      <div class="care-stat">
        <strong>20+</strong>
        <span>highly qualified doctors</span>
      </div>
      <div class="care-stat">
        <strong>100%</strong>
        <span>advanced diagnostics</span>
      </div>
    </div>

    <div class="explore" aria-hidden="true">
      <span>Scroll to explore</span>
      <i></i>
    </div>
  </div>
</section>

<style>
.hero {
  min-height: 100svh;
  padding: 16px;
  background: #f5f8fc;
  overflow: hidden;
}

.hero__frame {
  position: relative;
  min-height: calc(100svh - 32px);
  overflow: hidden;
  isolation: isolate;
  border-radius: 30px;
  background: #f8fafc;
  box-shadow: 0 20px 70px rgba(21, 48, 77, .07);
}

.hero__frame::before {
  content: '';
  position: absolute;
  inset: 0;
  z-index: 20;
  border: 1px solid rgba(255,255,255,.96);
  border-radius: inherit;
  pointer-events: none;
}

.hero__ambient {
  position: absolute;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  background:
    linear-gradient(rgba(27, 46, 68, .026) 1px, transparent 1px),
    linear-gradient(90deg, rgba(27, 46, 68, .026) 1px, transparent 1px);
  background-size: 100% 25%;
  opacity: .8;
}

.hero__halo {
  position: absolute;
  z-index: 1;
  width: min(47vw, 760px);
  aspect-ratio: 1;
  top: 48%;
  right: -1.5%;
  transform: translateY(-50%);
  border-radius: 50%;
  background:
    radial-gradient(circle at 50% 47%, rgba(255,255,255,.98) 0%, rgba(244,250,255,.94) 39%, rgba(228,242,255,.72) 67%, rgba(221,238,255,0) 75%);
  box-shadow: 0 28px 80px rgba(99, 154, 214, .07);
}

.hero__copy {
  position: relative;
  z-index: 8;
  width: min(52%, 790px);
  padding: clamp(140px, 18vh, 185px) 0 150px clamp(32px, 3.7vw, 66px);
}

.eyebrow {
  margin: 0 0 30px;
  color: #66758a;
  font-size: 10px;
  font-weight: 500;
  letter-spacing: .18em;
  text-transform: uppercase;
}

.hero h1 {
  margin: 0;
  max-width: 790px;
  color: #0c1017;
  font-family: var(--font-display);
  font-size: clamp(64px, 7.25vw, 118px);
  line-height: .82;
  letter-spacing: -.078em;
  font-weight: 700;
}

.hero h1 span { display: block; }
.hero h1 em { font-style: normal; color: var(--color-blue); }

.intro {
  max-width: 405px;
  margin: 32px 0 25px;
  color: #68778b;
  font-size: 13px;
  line-height: 1.7;
}

.cta {
  display: inline-flex;
  align-items: center;
  gap: 27px;
  padding: 7px 8px 7px 21px;
  color: #fff;
  background: #0d1015;
  border-radius: 999px;
  font-size: 11px;
  font-weight: 600;
  box-shadow: 0 13px 28px rgba(17, 19, 23, .13);
  transition: transform .3s ease, box-shadow .3s ease;
}

.cta:hover {
  transform: translateY(-2px);
  box-shadow: 0 17px 34px rgba(17, 19, 23, .17);
}

.cta__arrow {
  width: 32px;
  height: 32px;
  display: grid;
  place-items: center;
  color: #0d1015;
  background: #fff;
  border-radius: 50%;
  font-size: 15px;
}

.hero__visual {
  position: absolute;
  inset: 0;
  z-index: 4;
  pointer-events: none;
}

.hero__light-orb {
  position: absolute;
  z-index: 0;
  width: min(40vw, 650px);
  aspect-ratio: 1;
  right: 7.5%;
  top: 13%;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255,255,255,.97) 0%, rgba(237,247,255,.78) 57%, rgba(225,240,253,.15) 75%, transparent 76%);
}

.hand {
  position: absolute;
  object-fit: contain;
  filter: drop-shadow(0 24px 25px rgba(27, 66, 108, .11));
  will-change: transform;
}

.hand--clinician {
  z-index: 3;
  width: min(39vw, 630px);
  right: 3.8%;
  top: 17%;
  animation: clinicianFloat 7s ease-in-out infinite;
}

.hand--patient {
  z-index: 4;
  width: min(43vw, 700px);
  right: 8.5%;
  top: 42%;
  animation: patientFloat 7s ease-in-out -1.1s infinite;
}

.technology-card {
  position: absolute;
  z-index: 9;
  right: clamp(30px, 3.7vw, 64px);
  bottom: 68px;
  width: min(300px, 22vw);
  min-height: 145px;
  padding: 22px 22px 20px;
  border: 1px solid rgba(150, 171, 194, .24);
  border-radius: 22px;
  background: rgba(255,255,255,.84);
  box-shadow: 0 18px 45px rgba(47, 82, 115, .09);
  backdrop-filter: blur(18px);
}

.technology-card__number {
  display: block;
  margin-bottom: 18px;
  color: #8994a2;
  font-size: 9px;
  letter-spacing: .04em;
}

.technology-card h2 {
  margin: 0 0 11px;
  color: #17202c;
  font-family: var(--font-display);
  font-size: 17px;
  line-height: 1.15;
  letter-spacing: -.04em;
  font-weight: 700;
}

.technology-card p {
  margin: 0;
  color: #6f7b89;
  font-size: 9.5px;
  line-height: 1.55;
}

.care-stats {
  position: absolute;
  z-index: 9;
  left: clamp(32px, 3.7vw, 66px);
  bottom: 35px;
  display: flex;
  align-items: baseline;
  gap: clamp(32px, 4.2vw, 68px);
}

.care-stat {
  display: flex;
  align-items: baseline;
  gap: 8px;
}

.care-stat strong {
  color: #151a21;
  font-family: var(--font-display);
  font-size: 17px;
  letter-spacing: -.045em;
  font-weight: 700;
}

.care-stat span {
  color: #87919f;
  font-size: 9px;
}

.explore {
  position: absolute;
  z-index: 9;
  right: 3.7vw;
  bottom: 36px;
  display: flex;
  align-items: center;
  gap: 10px;
  color: #778291;
  font-size: 9px;
}

.explore i {
  display: block;
  width: 42px;
  height: 1px;
  background: #a8b1bd;
}

@keyframes clinicianFloat {
  0%, 100% { transform: translate3d(0, 0, 0); }
  50% { transform: translate3d(-8px, 7px, 0); }
}

@keyframes patientFloat {
  0%, 100% { transform: translate3d(0, 0, 0); }
  50% { transform: translate3d(7px, -5px, 0); }
}

@media (max-width: 1150px) {
  .hero__copy { width: 54%; }
  .hero h1 { font-size: clamp(58px, 7.5vw, 92px); }
  .hand--clinician { width: 42vw; right: 0; }
  .hand--patient { width: 46vw; right: 5%; }
  .technology-card { width: 270px; }
}

@media (max-width: 760px) {
  .hero { padding: 8px; }
  .hero__frame { min-height: calc(100svh - 16px); border-radius: 22px; }
  .hero__ambient { background-size: 100% 20%; }
  .hero__halo { width: 105vw; top: 64%; right: -22%; }
  .hero__copy { width: 100%; padding: 125px 24px 430px; }
  .hero h1 { font-size: clamp(52px, 13vw, 78px); line-height: .84; }
  .intro { max-width: 330px; margin-top: 24px; font-size: 12px; }
  .hand--clinician { width: 77vw; right: -5%; top: 50%; }
  .hand--patient { width: 83vw; right: 0; top: 63%; }
  .technology-card { right: 20px; bottom: 88px; width: calc(100% - 40px); }
  .care-stats { left: 22px; right: 22px; bottom: 21px; justify-content: space-between; gap: 8px; }
  .care-stat { display: block; }
  .care-stat strong, .care-stat span { display: block; }
  .care-stat strong { font-size: 15px; }
  .care-stat span { margin-top: 3px; font-size: 8px; line-height: 1.25; }
  .explore { display: none; }
}

@media (prefers-reduced-motion: reduce) {
  .hand--clinician,
  .hand--patient { animation: none; }
}
</style>
