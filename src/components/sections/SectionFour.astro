---
import Icon from '../icons/Icon.astro';

const stats = [
  { value: '4.5', suffix: '', label: 'Google rating', detail: 'Rated 4.5 stars by patients on Google, based on the hospital reviews available.', icon: 'star' },
  { value: '15+', suffix: '', label: 'Years of experience', detail: 'Experienced medical care built around specialist consultation and continuous patient support.', icon: 'calendar' },
  { value: '6+', suffix: '', label: 'Areas of medicine', detail: 'General Medicine, Cardiology, Diabetology, Surgery, Obstetrics, ENT and more.', icon: 'medicine' },
  { value: '24×7', suffix: '', label: 'Emergency care', detail: 'Round-the-clock emergency support alongside laboratory, pharmacy and ambulance facilities.', icon: 'emergency' },
];
---

<section class="why-section" aria-labelledby="why-title">
  <div class="why-card">
    <div class="visual-panel" aria-label="Why choose Siddaganga Hospital image area">
      <div class="visual-copy">
        <p class="visual-kicker">PROVIDED BY</p>
        <h2 id="why-title">Why<br /><strong>choose us</strong></h2>
        <p class="visual-note">Specialist care · advanced diagnostics</p>
      </div>
    </div>

    <div class="why-content">
      <div class="eyebrow-row">
        <span>( Advantages )</span>
        <span class="looks-like">LOOKS LIKE: <strong>Modern medicine</strong></span>
      </div>

      <div class="stats-grid">
        {stats.map((stat) => (
          <article class="stat">
            <div class="stat-heading"><span class="stat-icon" aria-hidden="true"><Icon name={stat.icon} size={17} strokeWidth={1.7} /></span><div class="stat-number">{stat.value}<span>{stat.suffix}</span></div></div>
            <h3>{stat.label}</h3>
            <p>{stat.detail}</p>
          </article>
        ))}
      </div>

      <p class="trust-line">IN FACT: <strong>Specialist medical care, diagnostics and essential hospital facilities in one place.</strong></p>
    </div>
  </div>
</section>

<style>
  .why-section{width:100%;padding:0 20px 36px;box-sizing:border-box;background:#edf3ff}.why-card{position:relative;width:100%;max-width:1440px;min-height:430px;margin:0 auto;display:grid;grid-template-columns:minmax(420px,42%) minmax(0,58%);overflow:hidden;border-radius:28px;background:#fff}.visual-panel{position:relative;min-height:430px;overflow:hidden;background:linear-gradient(135deg,#2678ef 0%,#1769ec 55%,#3e89f5 100%)}.visual-panel::before{content:'';position:absolute;width:520px;height:520px;right:-250px;top:-155px;border-radius:50%;border:1px solid rgba(255,255,255,.13)}.visual-panel::after{content:'';position:absolute;width:300px;height:300px;left:-170px;bottom:-185px;border-radius:50%;border:1px solid rgba(255,255,255,.12)}.visual-copy{position:absolute;z-index:2;left:clamp(32px,4vw,58px);top:clamp(36px,4vw,52px)}.visual-kicker{margin:0 0 7px;color:rgba(255,255,255,.68);font-size:8px;letter-spacing:.08em}.visual-copy h2{margin:0;color:#fff;font-family:var(--font-display);font-size:clamp(40px,4vw,62px);font-weight:400;line-height:.88;letter-spacing:-.065em}.visual-copy h2 strong{font-weight:600}.visual-note{margin:18px 0 0;color:rgba(255,255,255,.7);font-size:10px}.why-content{position:relative;min-width:0;padding:40px 56px 31px;overflow:hidden;background:#fbfdff}.why-content::before,.why-content::after{content:'';position:absolute;width:185px;height:185px;border:1px solid rgba(65,118,196,.075);clip-path:polygon(25% 3%,75% 3%,100% 50%,75% 97%,25% 97%,0 50%);pointer-events:none}.why-content::before{right:-42px;top:25px}.why-content::after{right:105px;bottom:-118px}.eyebrow-row{position:relative;z-index:2;display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:31px;color:#9aa3b1;font-size:9px}.looks-like{padding:4px 9px;border-radius:999px;background:rgba(255,255,255,.85);color:#7d8797;box-shadow:0 2px 8px rgba(20,48,90,.03)}.looks-like strong{color:#182a49;font-weight:500}.stats-grid{position:relative;z-index:2;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));column-gap:clamp(34px,4vw,70px);row-gap:31px}.stat{min-width:0}.stat-heading{display:flex;align-items:flex-start;gap:10px}.stat-icon{width:30px;height:30px;display:grid;place-items:center;border-radius:50%;background:#eaf2ff;color:#2878ed;flex:0 0 auto;margin-top:2px}.stat-number{color:#111827;font-family:var(--font-display);font-size:clamp(52px,4.8vw,78px);font-weight:400;line-height:.72;letter-spacing:-.075em;white-space:nowrap}.stat-number span{color:#2378ef;font-size:.48em;vertical-align:top;margin-left:2px;letter-spacing:-.02em}.stat h3{margin:18px 0 6px;color:#172b4d;font-size:12px;line-height:1.1;font-weight:600;letter-spacing:-.02em}.stat p{max-width:230px;margin:0;color:#8a94a5;font-size:9px;line-height:1.45}.trust-line{position:relative;z-index:2;margin:27px 0 0;color:#929baa;font-size:8px;line-height:1.45}.trust-line strong{color:#293750;font-weight:500}
  @media(max-width:1050px){.why-card{grid-template-columns:38% 62%}.why-content{padding:34px 38px 28px}.stats-grid{column-gap:30px}}
  @media(max-width:800px){.why-card{grid-template-columns:1fr}.visual-panel{min-height:300px}.why-content{padding:34px 30px}}
  @media(max-width:560px){.why-section{padding:0 12px 24px}.why-card{border-radius:22px}.stats-grid{column-gap:24px;row-gap:28px}.eyebrow-row{align-items:flex-start}.looks-like{display:none}.stat-number{font-size:48px}.stat-icon{width:26px;height:26px}}
</style>
