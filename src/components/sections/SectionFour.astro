---
import Icon from '../icons/Icon.astro';

const stats = [
  { value: '15+', label: 'Years of experience', detail: 'Experienced medical care built around specialist consultation and support.', icon: 'calendar' },
  { value: '6+', label: 'Areas of medicine', detail: 'General Medicine, Cardiology, Diabetology, Surgery, Obstetrics, ENT and more.', icon: 'medicine' },
  { value: '4.5', label: 'Google rating', detail: 'Patient rating shown on the hospital’s Google listing.', icon: 'star' },
  { value: '24×7', label: 'Emergency care', detail: 'Round-the-clock emergency support with essential hospital facilities.', icon: 'emergency' },
];
---

<section class="why-section" aria-labelledby="why-title">
  <div class="why-card">
    <div class="visual-panel">
      <img src="/assets/gallery/02-entrance-side.webp" alt="Siddaganga Hospital exterior" loading="lazy" decoding="async" />
      <div class="visual-overlay"></div>
      <div class="visual-copy">
        <p class="visual-kicker">WHY SIDDAGANGA</p>
        <h2 id="why-title">Care<br /><strong>with context.</strong></h2>
        <p class="visual-note">Specialist care · diagnostics · emergency support</p>
      </div>
      <span class="visual-tag">SGH / 02</span>
    </div>

    <div class="why-content">
      <div class="eyebrow-row"><span>( Advantages )</span><span>BUILT AROUND THE PATIENT</span></div>
      <div class="stats-grid">
        {stats.map((stat) => (
          <article class="stat">
            <div class="stat-heading"><span class="stat-icon" aria-hidden="true"><Icon name={stat.icon} size={17} strokeWidth={1.7} /></span><div class="stat-number">{stat.value}</div></div>
            <h3>{stat.label}</h3>
            <p>{stat.detail}</p>
          </article>
        ))}
      </div>
      <p class="trust-line">IN FOCUS: <strong>Specialist medical care, diagnostics and essential hospital facilities in one place.</strong></p>
    </div>
  </div>
</section>

<style>
.why-section{width:100%;padding:0 20px 36px;box-sizing:border-box;background:#edf3ff}.why-card{position:relative;width:100%;max-width:1440px;min-height:430px;margin:0 auto;display:grid;grid-template-columns:minmax(420px,42%) minmax(0,58%);overflow:hidden;border-radius:28px;background:#fff;box-shadow:0 20px 60px rgba(38,78,128,.08)}
.visual-panel{position:relative;min-height:430px;overflow:hidden;background:#dbe8f7}.visual-panel img{position:absolute;inset:0;width:100%;height:100%;display:block;object-fit:cover;object-position:center}.visual-overlay{position:absolute;inset:0;background:linear-gradient(180deg,rgba(11,24,43,.08),rgba(11,24,43,.68))}.visual-copy{position:absolute;z-index:2;left:clamp(32px,4vw,58px);bottom:clamp(38px,4vw,54px)}.visual-kicker{margin:0 0 8px;color:rgba(255,255,255,.72);font-family:var(--font-body);font-size:13px;line-height:1.25;letter-spacing:.08em}.visual-copy h2{margin:0;color:#fff;font-family:var(--font-display);font-size:clamp(42px,4vw,62px);font-weight:400;line-height:.88;letter-spacing:-.065em}.visual-copy h2 strong{font-weight:700}.visual-note{margin:18px 0 0;color:rgba(255,255,255,.78);font-family:var(--font-body);font-size:13px;line-height:1.4}.visual-tag{position:absolute;z-index:2;top:22px;right:22px;padding:7px 10px;border-radius:999px;background:rgba(255,255,255,.16);backdrop-filter:blur(10px);color:#fff;font-family:var(--font-body);font-size:11px;line-height:1.2;letter-spacing:.1em}
.why-content{position:relative;min-width:0;padding:40px 56px 31px;overflow:hidden;background:#fbfdff}.why-content::before,.why-content::after{content:'';position:absolute;width:185px;height:185px;border:1px solid rgba(65,118,196,.075);clip-path:polygon(25% 3%,75% 3%,100% 50%,75% 97%,25% 97%,0 50%);pointer-events:none}.why-content::before{right:-42px;top:25px}.why-content::after{right:105px;bottom:-118px}.eyebrow-row{position:relative;z-index:2;display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:31px;color:#9aa3b1;font-family:var(--font-body);font-size:13px;line-height:1.25;letter-spacing:.04em}.eyebrow-row span{min-width:0}.eyebrow-row span:first-child{white-space:nowrap}.stats-grid{position:relative;z-index:2;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));column-gap:clamp(34px,4vw,70px);row-gap:31px}.stat{min-width:0}.stat-heading{display:flex;align-items:flex-start;gap:10px}.stat-icon{width:30px;height:30px;display:grid;place-items:center;border-radius:50%;background:#eaf2ff;color:#2878ed;flex:0 0 auto;margin-top:2px}.stat-number{color:#2878ed;font-family:var(--font-display);font-size:clamp(52px,4.8vw,78px);font-weight:500;line-height:.82;letter-spacing:-.075em;white-space:nowrap}.stat h3{margin:18px 0 6px;color:#172b4d;font-family:var(--font-display);font-size:16px;line-height:1.15;font-weight:600;letter-spacing:-.02em}.stat p{max-width:260px;margin:0;color:#7c889b;font-family:var(--font-body);font-size:15px;line-height:1.5}.trust-line{position:relative;z-index:2;margin:27px 0 0;color:#929baa;font-family:var(--font-body);font-size:13px;line-height:1.45}.trust-line strong{color:#293750;font-weight:550}
@media(max-width:1050px){.why-card{grid-template-columns:38% 62%}.why-content{padding:34px 38px 28px}.stats-grid{column-gap:30px}}
@media(max-width:800px){.why-card{grid-template-columns:1fr}.visual-panel{min-height:330px}.why-content{padding:34px 30px}.stat-number{font-size:clamp(48px,10vw,64px)}}
@media(max-width:700px){.eyebrow-row{flex-direction:column;align-items:flex-start;justify-content:flex-start;gap:8px;margin-bottom:28px}.eyebrow-row span{max-width:100%;white-space:normal;overflow-wrap:anywhere}.eyebrow-row span:first-child{white-space:nowrap}.stats-grid{column-gap:22px;row-gap:28px}}
@media(max-width:560px){.why-section{padding:0 12px 24px}.why-card{border-radius:22px}.why-content{padding:30px 24px}.eyebrow-row{font-size:12px;letter-spacing:.045em}.stats-grid{column-gap:24px;row-gap:28px}.stat-number{font-size:48px}.stat-icon{width:26px;height:26px}.stat h3{font-size:14px}.stat p{font-size:14px}}
</style>
