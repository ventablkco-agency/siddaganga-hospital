---
import IconSlideButton from '../ui/IconSlideButton.astro';
import Icon from '../icons/Icon.astro';
---
<section id="about" class="section-two" aria-labelledby="section-two-title">
  <div class="section-two__card">
    <div class="section-two__geometry section-two__geometry--left" aria-hidden="true"><span class="hex hex--one"></span><span class="hex hex--two"></span><span class="hex hex--three"></span></div>
    <div class="section-two__geometry section-two__geometry--right" aria-hidden="true"><span class="hex hex--four"></span><span class="hex hex--five"></span><span class="hex hex--six"></span></div>
    <div class="section-two__content">
      <div class="section-two__eyebrow" aria-hidden="true"><span></span><span class="section-two__heartbeat"><Icon name="cardiology" size={23} strokeWidth={1.8} /></span><span></span></div>
      <div class="section-two__text-reveal">
        <h2 id="section-two-title">Modern medicine, <strong>human care.</strong><br class="desktop-break" /> At <strong>Siddaganga Hospital</strong>, every patient gets careful attention.</h2>
        <p class="section-two__description">Specialist care in <strong>Cardiology, Diabetology &amp; General Medicine</strong>, supported by diagnostics and continuous patient support.</p>
      </div>
      <div class="section-two__cta">
        <IconSlideButton href="#services" label="Discover our care" background="var(--color-brand)" backgroundHover="var(--color-ink)" textColor="var(--color-white)" textHover="var(--color-white)" fillColor="var(--color-white)" iconColor="var(--color-brand)" iconHoverFill="var(--color-ink)" />
      </div>
    </div>
  </div>
</section>
<style>
.section-two{min-height:0;height:100%;padding:clamp(10px,1.2vw,18px) clamp(12px,1.6vw,24px);background:#eef7ff;display:flex;align-items:stretch;overflow:hidden;box-sizing:border-box;view-timeline-name:--section-two-view;view-timeline-axis:block}.section-two__card{position:relative;width:100%;height:100%;min-height:0;overflow:hidden;isolation:isolate;border-radius:32px;background:#fff;display:grid;place-items:center;box-shadow:0 18px 60px rgba(22,93,167,.08)}.section-two__content{position:relative;z-index:3;width:min(calc(100% - 40px),1500px);text-align:center;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:clamp(20px,3vh,42px) 20px;box-sizing:border-box}.section-two__eyebrow{display:flex;align-items:center;justify-content:center;gap:18px;margin-bottom:clamp(14px,2vh,26px)}.section-two__eyebrow span:first-child,.section-two__eyebrow span:last-child{width:72px;height:1px;background:rgba(31,116,232,.22)}.section-two__heartbeat{color:#2477e8;display:grid;place-items:center;line-height:1}.section-two__text-reveal{width:100%;display:flex;flex-direction:column;align-items:center}.section-two__text-reveal h2{max-width:1200px;margin:0;color:#152944;font-family:var(--font-display);font-size:clamp(36px,3.6vw,60px);font-weight:500;line-height:1.12;letter-spacing:-.047em}.section-two__text-reveal h2 strong{color:#1973e8;font-weight:650}.section-two__description{max-width:760px;margin:clamp(16px,2.2vh,28px) 0 0;color:#536176;font-family:var(--font-body);font-size:clamp(15px,1.12vw,18px);line-height:1.5}.section-two__description strong{color:#1973e8;font-weight:600}.section-two__cta{margin-top:30px}.hex{position:absolute;width:150px;height:130px;border:1px solid rgba(36,119,232,.10);clip-path:polygon(25% 0,75% 0,100% 50%,75% 100%,25% 100%,0 50%)}.section-two__geometry{position:absolute;z-index:1;inset:0;pointer-events:none}.section-two__geometry--left .hex--one{left:-45px;top:8%}.section-two__geometry--left .hex--two{left:75px;top:0;transform:scale(.72)}.section-two__geometry--left .hex--three{left:-65px;bottom:8%;transform:scale(1.05)}.section-two__geometry--right .hex--four{right:-38px;top:10%;transform:scale(.75)}.section-two__geometry--right .hex--five{right:90px;bottom:14%;transform:scale(1.12)}.section-two__geometry--right .hex--six{right:-60px;bottom:-10px;transform:scale(.95)}
@supports (animation-timeline:view()){.section-two__text-reveal{animation:section-two-copy-reveal linear both;animation-timeline:--section-two-view;animation-range:entry 0% cover 42%}}@keyframes section-two-copy-reveal{from{opacity:0;transform:translateY(34px);clip-path:inset(0 0 100% 0)}to{opacity:1;transform:translateY(0);clip-path:inset(0 0 0 0)}}@media(prefers-reduced-motion:reduce){.section-two__text-reveal{animation:none!important;opacity:1!important;transform:none!important;clip-path:none!important}}@media(max-width:900px){.section-two__content{width:min(calc(100% - 24px),720px);padding-inline:12px}.section-two__text-reveal h2{font-size:clamp(31px,6.3vw,52px)}}@media(max-width:760px){.section-two{padding:8px}.section-two__card{border-radius:22px}.section-two__content{padding:20px 10px}.section-two__eyebrow{margin-bottom:16px}.section-two__eyebrow span:first-child,.section-two__eyebrow span:last-child{width:38px}.section-two__text-reveal h2{font-size:clamp(27px,8.2vw,42px);line-height:1.1;letter-spacing:-.04em}.section-two__description{max-width:480px;margin-top:16px;font-size:15px;line-height:1.4}.section-two__cta{margin-top:22px}.desktop-break{display:none}.hex{width:100px;height:86px}}
@media(max-height:760px) and (min-width:761px){.section-two__content{padding-block:12px}.section-two__eyebrow{margin-bottom:10px}.section-two__description{margin-top:12px}.section-two__cta{margin-top:24px}}
</style>
