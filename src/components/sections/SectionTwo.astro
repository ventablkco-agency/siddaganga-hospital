---
---

<section id="about" class="section-two" aria-labelledby="section-two-title">
  <div class="section-two__card">
    <div class="section-two__geometry section-two__geometry--left" aria-hidden="true">
      <span class="hex hex--one"></span>
      <span class="hex hex--two"></span>
      <span class="hex hex--three"></span>
    </div>

    <div class="section-two__geometry section-two__geometry--right" aria-hidden="true">
      <span class="hex hex--four"></span>
      <span class="hex hex--five"></span>
      <span class="hex hex--six"></span>
    </div>

    <div class="section-two__content">
      <div class="section-two__eyebrow" aria-hidden="true">
        <span></span>
        <span class="section-two__heartbeat">♥</span>
        <span></span>
      </div>

      <h2 id="section-two-title">
        At <strong>Siddaganga Hospital</strong>, we combine advanced<br class="desktop-break" />
        medicine &amp; compassionate care to help every
        <span class="section-two__people" aria-label="Our specialist care team">
          <span class="person person--one">D</span>
          <span class="person person--two">S</span>
          <span class="person person--three">A</span>
        </span>
        patient live a <strong>healthier, longer life.</strong>
      </h2>

      <p class="section-two__description">
        With expertise in <strong>Cardiology, Diabetology &amp; General Medicine</strong>,<br class="desktop-break" />
        we deliver personalized treatment, advanced diagnostics,<br class="desktop-break" />
        and continuous care you can trust.
      </p>

      <a class="section-two__cta" href="#services">
        <span>Discover our care</span>
        <span class="section-two__cta-icon" aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .section-two {
    flex: 1 1 auto;
    min-height: 0;
    height: auto;
    padding: clamp(10px, 1.2vw, 18px) clamp(12px, 1.6vw, 24px);
    background: #eef7ff;
    display: flex;
    align-items: stretch;
    overflow: hidden;
  }

  .section-two__card {
    position: relative;
    width: 100%;
    min-height: 0;
    height: 100%;
    overflow: hidden;
    isolation: isolate;
    border-radius: 32px;
    background: #fff;
    display: grid;
    place-items: center;
    box-shadow: 0 18px 60px rgba(22, 93, 167, 0.08);
  }

  .section-two__content {
    position: relative;
    z-index: 3;
    width: min(100% - 40px, 1320px);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: clamp(24px, 4.2vh, 64px) 20px;
  }

  .section-two__eyebrow {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    margin-bottom: clamp(18px, 2.6vh, 34px);
  }

  .section-two__eyebrow span:first-child,
  .section-two__eyebrow span:last-child {
    width: 64px;
    height: 1px;
    background: rgba(31, 116, 232, 0.22);
  }

  .section-two__heartbeat {
    color: #2477e8;
    font-size: 27px;
    line-height: 1;
    transform: scaleX(1.12);
  }

  h2 {
    max-width: 1240px;
    margin: 0;
    color: #152944;
    font-family: var(--font-display);
    font-size: clamp(34px, 3.75vw, 64px);
    font-weight: 500;
    line-height: 1.18;
    letter-spacing: -0.045em;
  }

  h2 strong {
    color: #1973e8;
    font-weight: 600;
  }

  .section-two__people {
    display: inline-flex;
    align-items: center;
    vertical-align: middle;
    margin: 0 9px 0 10px;
    padding-left: 9px;
    transform: translateY(-2px);
    white-space: nowrap;
  }

  .person {
    width: clamp(40px, 2.8vw, 50px);
    height: clamp(40px, 2.8vw, 50px);
    margin-left: -9px;
    border: 3px solid #fff;
    border-radius: 50%;
    display: grid;
    place-items: center;
    color: #fff;
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 700;
    box-shadow: 0 5px 18px rgba(16, 54, 90, 0.14);
  }

  .person--one { background: linear-gradient(145deg, #8ba2b9, #365875); }
  .person--two { background: linear-gradient(145deg, #c8a582, #755c43); }
  .person--three { background: linear-gradient(145deg, #d7b39c, #866657); }

  .section-two__description {
    max-width: 790px;
    margin: clamp(16px, 2.2vh, 26px) 0 0;
    color: #536176;
    font-family: var(--font-body);
    font-size: clamp(15px, 1.15vw, 20px);
    font-weight: 400;
    line-height: 1.45;
  }

  .section-two__description strong {
    color: #1973e8;
    font-weight: 600;
  }

  .section-two__cta {
    display: inline-flex;
    align-items: center;
    gap: 18px;
    min-height: 60px;
    margin-top: clamp(20px, 2.5vh, 30px);
    padding: 6px 7px 6px 26px;
    border-radius: 999px;
    background: #2477e8;
    color: #fff;
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 500;
    box-shadow: 0 12px 30px rgba(36, 119, 232, 0.22);
    transition: transform 220ms ease, box-shadow 220ms ease;
  }

  .section-two__cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 16px 36px rgba(36, 119, 232, 0.28);
  }

  .section-two__cta-icon {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: #fff;
    color: #152944;
    font-size: 24px;
    line-height: 1;
  }

  .section-two__geometry {
    position: absolute;
    z-index: 1;
    inset: 0;
    pointer-events: none;
  }

  .hex {
    position: absolute;
    width: 150px;
    height: 130px;
    border: 1px solid rgba(36, 119, 232, 0.10);
    clip-path: polygon(25% 0, 75% 0, 100% 50%, 75% 100%, 25% 100%, 0 50%);
  }

  .section-two__geometry--left .hex--one { left: -45px; top: 8%; }
  .section-two__geometry--left .hex--two { left: 75px; top: 0; transform: scale(.72); }
  .section-two__geometry--left .hex--three { left: -65px; bottom: 8%; transform: scale(1.05); }
  .section-two__geometry--right .hex--four { right: -38px; top: 10%; transform: scale(.75); }
  .section-two__geometry--right .hex--five { right: 90px; bottom: 14%; transform: scale(1.12); }
  .section-two__geometry--right .hex--six { right: -60px; bottom: -10px; transform: scale(.95); }

  @media (max-width: 900px) {
    .section-two__content { width: min(100% - 24px, 720px); padding-inline: 12px; }
    h2 { font-size: clamp(31px, 6.3vw, 52px); }
  }

  @media (max-width: 760px) {
    .section-two { padding: 8px; }
    .section-two__card { border-radius: 22px; }
    .section-two__content { padding: 22px 12px; }
    .section-two__eyebrow { margin-bottom: 18px; }
    .section-two__eyebrow span:first-child,
    .section-two__eyebrow span:last-child { width: 38px; }
    h2 { font-size: clamp(28px, 8.5vw, 43px); line-height: 1.1; letter-spacing: -0.04em; }
    .section-two__people { margin-inline: 4px; padding-left: 7px; }
    .person { width: 35px; height: 35px; margin-left: -7px; border-width: 2px; font-size: 11px; }
    .section-two__description { max-width: 480px; margin-top: 16px; font-size: 15px; line-height: 1.4; }
    .desktop-break { display: none; }
    .section-two__cta { min-height: 54px; margin-top: 20px; padding-left: 20px; font-size: 14px; }
    .section-two__cta-icon { width: 42px; height: 42px; }
    .hex { width: 100px; height: 86px; }
  }

  @media (max-height: 760px) and (min-width: 761px) {
    .section-two__content { padding-block: 18px; }
    .section-two__eyebrow { margin-bottom: 14px; }
    .section-two__description { margin-top: 12px; }
    .section-two__cta { margin-top: 16px; }
  }
</style>
