---
const items = [
  { src:'/assets/gallery/01-entrance.webp', alt:'Modern Siddaganga Hospital entrance', title:'Main entrance', subtitle:'A welcoming first impression' },
  { src:'/assets/gallery/02-entrance-side.webp', alt:'Siddaganga Hospital exterior from the side', title:'Hospital exterior', subtitle:'Built for better health' },
  { src:'/assets/gallery/03-entrance-wide.webp', alt:'Wide view of Siddaganga Hospital entrance', title:'Siddaganga', subtitle:'A place for better care' },
  { src:'/assets/gallery/04-reception.webp', alt:'Siddaganga Hospital reception lobby', title:'Reception', subtitle:'Care starts here' },
  { src:'/assets/gallery/05-reception-detail.webp', alt:'Modern Siddaganga Hospital reception area', title:'Patient experience', subtitle:'Calm. Clear. Considered.' },
  { src:'/assets/gallery/06-patient-room.webp', alt:'Bright modern Siddaganga Hospital patient room', title:'Patient rooms', subtitle:'Comfort built into care' },
  { src:'/assets/gallery/07-emergency.webp', alt:'Modern Siddaganga Hospital emergency ward', title:'Emergency care', subtitle:'Ready when it matters' },
  { src:'/assets/gallery/08-ambulance.webp', alt:'Siddaganga Hospital entrance with ambulance', title:'Ambulance', subtitle:'Care beyond the doors' },
  { src:'/assets/gallery/09-imaging.webp', alt:'Modern hospital imaging suite', title:'Imaging', subtitle:'Technology with precision' },
  { src:'/assets/gallery/10-laboratory.webp', alt:'Modern clinical laboratory at Siddaganga Hospital', title:'Laboratory', subtitle:'Accurate diagnosis, better decisions' },
];
---

<section class="gallery-section" id="gallery" aria-labelledby="gallery-title">
  <div class="gallery-inner">
    <div class="gallery-heading">
      <p class="gallery-eyebrow">{`{ Inside Siddaganga }`}</p>
      <h2 id="gallery-title">A closer look<br /><strong>at care.</strong></h2>
      <p class="gallery-description">Step inside our spaces, people, and details<br class="desktop-break" /> that make every visit feel considered.</p>
    </div>

    <div class="panorama" data-panorama tabindex="0" role="region" aria-roledescription="carousel" aria-label="Siddaganga Hospital gallery">
      <div class="panorama-viewport">
        <div class="panorama-stage">
          {items.map((item, index) => (
            <article class="panorama-card" data-card={index} aria-label={`${item.title}, ${index + 1} of ${items.length}`}>
              <button class="panorama-card-button" type="button" aria-label={`Focus ${item.title}`}>
                <span class="panorama-frame">
                  <img src={item.src} alt={item.alt} width="4" height="3" loading={index < 4 ? 'eager' : 'lazy'} decoding="async" draggable="false" />
                </span>
              </button>
            </article>
          ))}
        </div>
      </div>

      <p class="panorama-hint">DRAG TO EXPLORE · CLICK A FRAME TO FOCUS</p>

      <div class="gallery-caption" aria-live="polite">
        <span class="gallery-caption__title" data-title>{items[0].title}</span>
        <span class="gallery-caption__subtitle" data-subtitle>{items[0].subtitle}</span>
        <span class="gallery-caption__count"><span data-current>01</span><i>/</i>{String(items.length).padStart(2,'0')}</span>
      </div>

      <div class="gallery-controls" aria-label="Gallery controls">
        <button type="button" data-prev aria-label="Previous gallery image">←</button>
        <button type="button" data-next aria-label="Next gallery image">→</button>
      </div>
    </div>

    <div class="gallery-meta" aria-hidden="true">
      <span>SGH / 01</span>
      <span>SPACES · PEOPLE · CARE</span>
    </div>
  </div>
</section>

<script define:vars={{ items }}>
  const initPanorama = () => {
    document.querySelectorAll('[data-panorama]').forEach((root) => {
      if (root.dataset.initialized === 'true') return;
      root.dataset.initialized = 'true';
      const cards = Array.from(root.querySelectorAll('[data-card]'));
      const title = root.querySelector('[data-title]');
      const subtitle = root.querySelector('[data-subtitle]');
      const current = root.querySelector('[data-current]');
      const count = cards.length;
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const state = { position:0, velocity:0, target:null, dragging:false, pointerId:null, startX:0, startPosition:0, lastX:0, lastTime:0, hover:false, raf:0, lastFrame:0 };
      const wrap = value => ((value % count) + count) % count;
      const shortestOffset = (index, position) => { let offset = index - position; if (offset > count / 2) offset -= count; if (offset < -count / 2) offset += count; return offset; };
      const updateCaption = index => { const item = items[index]; if (!item) return; if (title) title.textContent = item.title; if (subtitle) subtitle.textContent = item.subtitle; if (current) current.textContent = String(index + 1).padStart(2,'0'); };
      const render = () => {
        const active = wrap(Math.round(state.position));
        const fractional = state.position - Math.round(state.position);
        cards.forEach((card,index) => {
          const offset = shortestOffset(index,active) - fractional;
          const abs = Math.abs(offset);
          const visible = abs <= 4.5;
          const x = offset * Math.min(330,Math.max(250,root.clientWidth * .23));
          const y = Math.min(abs * abs * 3.2,38);
          const rotate = offset * -8.5;
          const z = -abs * 72;
          const scale = 1 - Math.min(abs * .055,.2);
          const opacity = 1 - Math.min(abs * .15,.66);
          card.style.transform = `translate3d(calc(-50% + ${x}px),calc(-50% + ${y}px),${z}px) rotateY(${rotate}deg) scale(${scale})`;
          card.style.opacity = visible ? String(opacity) : '0';
          card.style.pointerEvents = visible ? 'auto' : 'none';
          card.style.zIndex = String(100 - Math.round(abs * 10));
        });
        updateCaption(active);
      };
      const wake = () => { if (!state.raf) state.raf = requestAnimationFrame(tick); };
      const snapTo = index => { const active = wrap(Math.round(state.position)); let delta = index - active; if (delta > count/2) delta -= count; if (delta < -count/2) delta += count; state.target = state.position + delta; state.velocity = 0; wake(); };
      const stepBy = direction => snapTo(wrap(Math.round(state.position) + direction));
      const tick = now => {
        state.raf = 0;
        const dt = state.lastFrame ? Math.min((now-state.lastFrame)/1000,.05) : 1/60;
        state.lastFrame = now;
        if (state.target !== null) {
          const diff = state.target - state.position;
          state.velocity += (diff * 74 - state.velocity * 14) * dt;
          state.position += state.velocity * dt;
          if (Math.abs(diff) < .002 && Math.abs(state.velocity) < .01) { state.position = state.target; state.target = null; state.velocity = 0; }
        } else if (!state.dragging && !state.hover && !reduced) {
          const cruise = -.09;
          state.velocity += (cruise-state.velocity) * (1-Math.exp(-dt/1.5));
          state.position += state.velocity * dt;
        } else if (!state.dragging) {
          state.velocity *= Math.exp(-8*dt);
          state.position += state.velocity * dt;
        }
        render();
        if (state.target !== null || state.dragging || (!state.hover && !reduced)) state.raf = requestAnimationFrame(tick); else state.lastFrame = 0;
      };
      root.addEventListener('pointerenter', event => { if (event.pointerType === 'mouse') state.hover = true; });
      root.addEventListener('pointerleave', event => { if (event.pointerType === 'mouse') { state.hover = false; wake(); } });
      root.addEventListener('pointerdown', event => { if (event.button !== 0) return; state.dragging = true; state.pointerId = event.pointerId; state.startX = event.clientX; state.lastX = event.clientX; state.startPosition = state.position; state.lastTime = performance.now(); state.target = null; root.setPointerCapture(event.pointerId); wake(); });
      root.addEventListener('pointermove', event => { if (!state.dragging || event.pointerId !== state.pointerId) return; const now = performance.now(); const dx = event.clientX-state.startX; const spacing = Math.min(330,Math.max(250,root.clientWidth*.23)); state.position = state.startPosition - dx/spacing; state.velocity = -(event.clientX-state.lastX)/spacing/Math.max((now-state.lastTime)/1000,.016); state.lastX = event.clientX; state.lastTime = now; render(); });
      const release = event => { if (!state.dragging || event.pointerId !== state.pointerId) return; state.dragging = false; state.pointerId = null; state.target = Math.round(state.position + state.velocity*.08); wake(); };
      root.addEventListener('pointerup',release); root.addEventListener('pointercancel',release);
      cards.forEach((card,index) => card.querySelector('button')?.addEventListener('click',event => { event.stopPropagation(); snapTo(index); }));
      root.querySelector('[data-prev]')?.addEventListener('click',event => { event.stopPropagation(); stepBy(-1); });
      root.querySelector('[data-next]')?.addEventListener('click',event => { event.stopPropagation(); stepBy(1); });
      root.addEventListener('keydown',event => { if (event.key==='ArrowLeft') { event.preventDefault(); stepBy(-1); } else if (event.key==='ArrowRight') { event.preventDefault(); stepBy(1); } else if (event.key==='Home') { event.preventDefault(); snapTo(0); } else if (event.key==='End') { event.preventDefault(); snapTo(count-1); } });
      render(); wake();
    });
  };
  if (document.readyState==='loading') document.addEventListener('DOMContentLoaded',initPanorama,{once:true}); else initPanorama();
</script>

<style>
.gallery-section{--ink:#111a2b;--muted:#74839a;position:relative;width:100%;min-height:88svh;background:#edf2ff;color:var(--ink);font-family:var(--font-body);overflow:hidden}
.gallery-inner{position:relative;width:100%;min-height:88svh;overflow:hidden;border-radius:24px;box-sizing:border-box}
.gallery-heading{position:absolute;left:5.5%;top:12%;z-index:20}.gallery-eyebrow{margin:0 0 15px;color:#8ca0bb;font-size:13px;letter-spacing:.03em}.gallery-heading h2{margin:0;font-family:var(--font-display);font-size:clamp(42px,4.4vw,66px);line-height:.9;letter-spacing:-.065em;font-weight:400}.gallery-heading h2 strong{font-weight:700}.gallery-description{margin:22px 0 0;color:var(--muted);font-size:15px;line-height:1.45}
.panorama{position:absolute;inset:3% 2.5% 4% 27%;overflow:hidden;outline:none;touch-action:pan-y;user-select:none;-webkit-user-select:none}.panorama:focus-visible{outline:2px solid rgba(40,120,237,.45);outline-offset:-2px;border-radius:24px}.panorama-viewport{position:absolute;inset:15% 0 20%;display:flex;align-items:center;justify-content:center;perspective:1500px;perspective-origin:50% 50%;overflow:hidden}.panorama-stage{position:relative;width:100%;height:100%;transform-style:preserve-3d;will-change:transform}.panorama-card{position:absolute;left:50%;top:50%;width:clamp(250px,25vw,380px);aspect-ratio:4/3;transform-origin:center center;transform-style:preserve-3d;backface-visibility:hidden;-webkit-backface-visibility:hidden;will-change:transform,opacity}.panorama-card-button{display:block;width:100%;height:100%;padding:0;border:0;background:none;cursor:pointer;transform-style:preserve-3d}.panorama-frame{display:block;position:relative;width:100%;height:100%;overflow:hidden;border-radius:18px;background:#dce8f7;border:1px solid rgba(255,255,255,.82);box-shadow:0 24px 60px rgba(30,63,108,.16);transform:translateZ(0)}.panorama-frame::after{content:"";position:absolute;inset:0;border:1px solid rgba(255,255,255,.42);border-radius:inherit;pointer-events:none}.panorama-frame img{display:block;width:100%;height:100%;object-fit:contain;object-position:center;background:#e5eefb;border:0;pointer-events:none;user-select:none;-webkit-user-drag:none}
.panorama-hint{position:absolute;right:4%;top:7%;margin:0;color:#91a2ba;font-size:11px;letter-spacing:.08em;z-index:30}.gallery-caption{position:absolute;left:50%;bottom:7%;transform:translateX(-50%);display:flex;flex-direction:column;align-items:center;gap:7px;z-index:30;white-space:nowrap;pointer-events:none}.gallery-caption__title{font-family:var(--font-display);font-size:22px;letter-spacing:-.04em;color:#111a2b}.gallery-caption__subtitle{font-size:13px;color:#8a9ab0}.gallery-caption__count{font-size:11px;color:#9aa9bd;letter-spacing:.1em}.gallery-caption__count i{font-style:normal;margin:0 7px}.gallery-controls{position:absolute;right:7%;bottom:6%;display:flex;gap:12px;z-index:40}.gallery-controls button{width:42px;height:42px;border-radius:50%;border:1px solid #2878ed;background:transparent;color:#2878ed;font-size:18px;line-height:1;cursor:pointer;display:grid;place-items:center}.gallery-controls button:last-child{background:#2878ed;color:#fff}.gallery-meta{position:absolute;left:5.5%;right:5.5%;bottom:4%;display:flex;justify-content:space-between;color:#a0aec0;font-size:11px;letter-spacing:.12em;z-index:30}
@media(max-width:1100px){.panorama{inset-left:23%}.panorama-card{width:clamp(235px,27vw,320px)}}
@media(max-width:820px){.gallery-section,.gallery-inner{min-height:820px}.gallery-heading{left:7%;top:8%}.gallery-description{font-size:14px}.panorama{inset:27% 3% 9% 3%}.panorama-viewport{inset:4% 0 24%}.panorama-card{width:min(72vw,330px)}.panorama-hint{top:0;right:3%;font-size:9px}.gallery-caption{bottom:7%}.gallery-controls{right:5%;bottom:6%}.gallery-meta{left:7%;right:7%;bottom:2.5%}}
@media(max-width:560px){.gallery-heading h2{font-size:clamp(39px,12vw,52px)}.gallery-description{max-width:330px;font-size:13px}.panorama{inset:29% 0 12%}.panorama-viewport{inset:3% 0 25%}.panorama-card{width:min(76vw,300px)}.panorama-hint{display:none}.gallery-caption__title{font-size:20px}.gallery-caption__subtitle{font-size:12px}.gallery-controls button{width:40px;height:40px}.gallery-meta{font-size:9px}}
</style>
