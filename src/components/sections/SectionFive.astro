---
import IconSlideButton from '../ui/IconSlideButton.astro';
import DepthDoctorCarousel from '../ui/DepthDoctorCarousel.astro';

const appointmentUrl = 'https://wa.me/919591799099';

const doctors = [
  {
    name: 'Dr. Nagaraj S K',
    role: 'General Medicine · Cardiac & Diabetes Specialist',
    qualification: 'MBBS, MD (Gen Med), FDM (UK)',
  },
  {
    name: 'Dr. Santosh V. Motagi',
    role: 'General Surgery',
    qualification: 'MBBS, MS (General Surgery)',
  },
  {
    name: 'Dr. Basavaraj Kallihal',
    role: 'Obstetrics',
    qualification: 'MBBS, DGO',
  },
];
---

<section id="doctors" class="doctors-section" aria-labelledby="doctors-title">
  <div class="doctors-inner">
    <div class="trust-area">
      <span class="decor decor-left" aria-hidden="true"></span>
      <span class="decor decor-right" aria-hidden="true"></span>

      <p class="trust-message">
        Medicine <strong>starts with science</strong> — but true<br />
        healing <strong>begins with trust</strong>
      </p>

      <div class="trust-image" aria-label="Doctor image placeholder">
        <span>Image</span>
      </div>

      <div class="trust-appointment">
        <span class="trust-brand"><span>✦</span> SGH</span>
        <IconSlideButton
          href={appointmentUrl}
          label="Make an appointment"
          newTab={true}
          variant="blue"
        />
      </div>
    </div>

    <div class="people-area">
      <div class="people-copy">
        <p class="eyebrow">{`{ Our doctors }`}</p>
        <h2 id="doctors-title">Meet the people<br /><strong>who care.</strong></h2>
        <p class="people-description">
          Our team brings together expertise, empathy, and a<br class="desktop-break" />
          deep passion for helping others.
        </p>
      </div>

      <DepthDoctorCarousel items={doctors} />
    </div>
  </div>
</section>

<style>
  .doctors-section {
    --blue: #2878ed;
    --ink: #101a2b;
    --muted: #6a7a91;
    position: relative;
    width: 100%;
    min-height: 100svh;
    height: 100svh;
    overflow: hidden;
    box-sizing: border-box;
    background: #edf2ff;
    color: var(--ink);
    font-family: var(--font-body);
  }

  .doctors-inner { width: 100%; height: 100%; position: relative; box-sizing: border-box; }

  .trust-area {
    position: relative;
    height: 45.5%;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    padding-top: clamp(38px, 6.5vh, 72px);
    box-sizing: border-box;
  }

  .trust-message {
    margin: 0;
    text-align: center;
    color: #59677b;
    font-family: var(--font-display);
    font-size: clamp(31px, 4vw, 58px);
    line-height: .98;
    letter-spacing: -.055em;
    font-weight: 400;
    position: relative;
    z-index: 2;
  }

  .trust-message strong { color: #111820; font-weight: 700; }

  .decor {
    position: absolute;
    width: 44px;
    height: 44px;
    border-radius: 11px;
    background: rgba(255,255,255,.6);
  }

  .decor-left { left: 4.7%; top: 25%; }
  .decor-right { right: 4.7%; top: 30%; }

  .trust-image {
    position: absolute;
    right: 21%;
    top: 46%;
    width: 104px;
    height: 78px;
    border-radius: 13px;
    transform: rotate(-10deg);
    display: grid;
    place-items: center;
    background: rgba(255,255,255,.45);
    border: 1px solid rgba(255,255,255,.75);
    color: #9aa6b8;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: .08em;
  }

  .trust-appointment {
    position: absolute;
    left: 50%;
    top: 68%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 22px;
    z-index: 3;
  }

  .trust-brand {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #a0adbf;
    font-size: 10px;
    letter-spacing: .12em;
    white-space: nowrap;
  }

  .trust-brand span {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--blue);
    color: white;
    font-size: 9px;
  }

  .people-area {
    position: absolute;
    left: 4.7%;
    right: 4.7%;
    bottom: 8.5%;
    height: 43%;
    display: grid;
    grid-template-columns: 36% 64%;
    align-items: center;
  }

  .people-copy {
    position: relative;
    height: 100%;
    padding-top: 10%;
    box-sizing: border-box;
    z-index: 5;
  }

  .eyebrow { margin: 0 0 15px; color: #8ca0bb; font-size: 11px; letter-spacing: .03em; }

  .people-copy h2 {
    margin: 0;
    color: #111a2b;
    font-family: var(--font-display);
    font-size: clamp(38px, 4.4vw, 66px);
    line-height: .9;
    letter-spacing: -.065em;
    font-weight: 400;
  }

  .people-copy h2 strong { font-weight: 700; }

  .people-description { margin: 24px 0 0; color: #71839d; font-size: 12px; line-height: 1.45; }

  @media (max-width: 900px) {
    .trust-area { height: 43%; }
    .trust-message { font-size: clamp(28px, 5vw, 44px); }
    .trust-image { right: 12%; }
    .people-area { grid-template-columns: 36% 64%; bottom: 7%; height: 45%; }
    .people-copy h2 { font-size: clamp(34px, 5.3vw, 52px); }
    .people-description { font-size: 11px; }
  }

  @media (max-width: 640px) {
    .doctors-section { min-height: 100svh; height: auto; overflow: hidden; }
    .trust-area { height: 43svh; min-height: 330px; }
    .trust-message { font-size: clamp(25px, 7.5vw, 36px); }
    .trust-message br { display: none; }
    .trust-image { width: 76px; height: 58px; right: 8%; top: 49%; }
    .trust-appointment { top: 73%; gap: 10px; }
    .trust-brand { display: none; }
    .people-area {
      position: relative;
      inset: auto;
      height: auto;
      min-height: 570px;
      padding: 0 6% 28px;
      display: flex;
      flex-direction: column;
      align-items: stretch;
      box-sizing: border-box;
    }
    .people-copy { height: auto; padding-top: 4%; flex: 0 0 auto; }
    .people-copy h2 { font-size: clamp(38px, 12vw, 58px); line-height: .92; }
    .people-description { margin-top: 14px; max-width: 330px; }
    .desktop-break { display: none; }
    .depth-carousel { height: 330px; min-height: 330px; margin-top: 18px; }
  }
</style>
