---
import IconSlideButton from '../ui/IconSlideButton.astro';

const appointmentUrl = 'https://wa.me/919591799099';

const doctors = [
  {
    name: 'Dr. Nagaraj S K',
    role: 'General Medicine · Cardiac & Diabetes Specialist',
    qualification: 'MBBS, MD (Gen Med), FDM (UK)',
    tone: 'doctor-tone-one',
  },
  {
    name: 'Dr. Santosh V. Motagi',
    role: 'General Surgery',
    qualification: 'MBBS, MS (General Surgery)',
    tone: 'doctor-tone-two',
  },
  {
    name: 'Dr. Basavaraj Kallihal',
    role: 'Obstetrics',
    qualification: 'MBBS, DGO',
    tone: 'doctor-tone-three',
  },
];
---

<section id="doctors" class="doctors-section" aria-labelledby="doctors-title">
  <div class="doctors-inner">
    <div class="trust-area">
      <span class="decor decor-left" aria-hidden="true"></span>
      <span class="decor decor-right" aria-hidden="true"></span>

      <p class="trust-message">
        Medicine <strong>starts with science</strong> — but true<br />
        healing <strong>begins with trust</strong>
      </p>

      <div class="trust-image" aria-label="Doctor image placeholder">
        <span>Image</span>
      </div>

      <div class="trust-appointment">
        <span class="trust-brand"><span>✦</span> SGH</span>
        <IconSlideButton
          href={appointmentUrl}
          label="Make an appointment"
          newTab={true}
          variant="blue"
        />
      </div>
    </div>

    <div class="people-area">
      <div class="people-copy">
        <p class="eyebrow">{`{ Our doctors }`}</p>
        <h2 id="doctors-title">Meet the people<br /><strong>who care.</strong></h2>
        <p class="people-description">
          Our team brings together expertise, empathy, and a<br class="desktop-break" />
          deep passion for helping others.
        </p>

        <div class="carousel-controls" aria-label="Doctor carousel controls">
          <button class="carousel-button carousel-button--prev" type="button" aria-label="Previous doctor">
            <span>←</span>
          </button>
          <span class="carousel-index" aria-live="polite">01 / 03</span>
          <button class="carousel-button carousel-button--next" type="button" aria-label="Next doctor">
            <span>→</span>
          </button>
        </div>
      </div>

      <div class="depth-stage" data-depth-carousel tabindex="0" aria-label="Our doctors carousel">
        <div class="depth-rail">
          {doctors.map((doctor, index) => (
            <article
              class:list={['depth-card', doctor.tone, index === 0 && 'is-active']}
              data-depth-card
              data-index={index}
              aria-hidden={index !== 0}
            >
              <div class="depth-photo" aria-label={`${doctor.name} portrait placeholder`}>
                <div class="portrait-placeholder" aria-hidden="true">
                  <span class="portrait-head"></span>
                  <span class="portrait-body"></span>
                </div>
                <span class="photo-label">SGH · Doctor portrait</span>
              </div>

              <div class="depth-card-info">
                <span class="depth-card-number">0{index + 1}</span>
                <h3>{doctor.name}</h3>
                <p>{doctor.role}</p>
                <small>{doctor.qualification}</small>
              </div>
            </article>
          ))}
        </div>

        <div class="depth-hint" aria-hidden="true">Drag to explore</div>
      </div>
    </div>
  </div>
</section>

<script>
  const initDepthDoctorCarousel = () => {
    document.querySelectorAll('[data-depth-carousel]').forEach((stage) => {
      if (stage.dataset.ready === 'true') return;
      stage.dataset.ready = 'true';

      const cards = Array.from(stage.querySelectorAll('[data-depth-card]'));
      const section = stage.closest('.doctors-section');
      const previous = section?.querySelector('.carousel-button--prev');
      const next = section?.querySelector('.carousel-button--next');
      const indexLabel = section?.querySelector('.carousel-index');
      let activeIndex = 0;
      let pointerStartX = 0;
      let pointerStartY = 0;

      const render = () => {
        cards.forEach((card, index) => {
          const offset = (index - activeIndex + cards.length) % cards.length;
          card.dataset.position = String(offset);
          card.classList.toggle('is-active', offset === 0);
          card.setAttribute('aria-hidden', offset === 0 ? 'false' : 'true');
        });

        if (indexLabel) indexLabel.textContent = `${String(activeIndex + 1).padStart(2, '0')} / ${String(cards.length).padStart(2, '0')}`;
      };

      const go = (direction) => {
        activeIndex = (activeIndex + direction + cards.length) % cards.length;
        render();
      };

      previous?.addEventListener('click', () => go(-1));
      next?.addEventListener('click', () => go(1));

      stage.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowLeft') {
          event.preventDefault();
          go(-1);
        }
        if (event.key === 'ArrowRight') {
          event.preventDefault();
          go(1);
        }
      });

      stage.addEventListener('pointerdown', (event) => {
        pointerStartX = event.clientX;
        pointerStartY = event.clientY;
        stage.setPointerCapture?.(event.pointerId);
      });

      stage.addEventListener('pointerup', (event) => {
        const dx = event.clientX - pointerStartX;
        const dy = event.clientY - pointerStartY;
        if (Math.abs(dx) > 45 && Math.abs(dx) > Math.abs(dy)) go(dx < 0 ? 1 : -1);
      });

      cards.forEach((card, index) => {
        card.addEventListener('click', () => {
          const offset = (index - activeIndex + cards.length) % cards.length;
          if (offset !== 0) {
            activeIndex = index;
            render();
          }
        });
      });

      render();
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initDepthDoctorCarousel, { once: true });
  } else {
    initDepthDoctorCarousel();
  }
</script>

<style>
  .doctors-section {
    --blue: #2878ed;
    --ink: #101a2b;
    --muted: #6a7a91;
    position: relative;
    width: 100%;
    min-height: 100svh;
    height: 100svh;
    overflow: hidden;
    box-sizing: border-box;
    background: #edf2ff;
    color: var(--ink);
    font-family: var(--font-body);
  }

  .doctors-inner { width: 100%; height: 100%; position: relative; box-sizing: border-box; }

  .trust-area {
    position: relative;
    height: 45.5%;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    padding-top: clamp(38px, 6.5vh, 72px);
    box-sizing: border-box;
  }

  .trust-message {
    margin: 0;
    text-align: center;
    color: #59677b;
    font-family: var(--font-display);
    font-size: clamp(31px, 4vw, 58px);
    line-height: .98;
    letter-spacing: -.055em;
    font-weight: 400;
    position: relative;
    z-index: 2;
  }

  .trust-message strong { color: #111820; font-weight: 700; }

  .decor { position: absolute; width: 44px; height: 44px; border-radius: 11px; background: rgba(255,255,255,.6); }
  .decor-left { left: 4.7%; top: 25%; }
  .decor-right { right: 4.7%; top: 30%; }

  .trust-image {
    position: absolute;
    right: 21%;
    top: 46%;
    width: 104px;
    height: 78px;
    border-radius: 13px;
    transform: rotate(-10deg);
    display: grid;
    place-items: center;
    background: rgba(255,255,255,.45);
    border: 1px solid rgba(255,255,255,.75);
    color: #9aa6b8;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: .08em;
  }

  .trust-appointment {
    position: absolute;
    left: 50%;
    top: 68%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 22px;
    z-index: 3;
  }

  .trust-brand { display: inline-flex; align-items: center; gap: 6px; color: #a0adbf; font-size: 10px; letter-spacing: .12em; white-space: nowrap; }
  .trust-brand span { width: 18px; height: 18px; border-radius: 50%; display: grid; place-items: center; background: var(--blue); color: white; font-size: 9px; }

  .people-area {
    position: absolute;
    left: 4.7%;
    right: 4.7%;
    bottom: 8.5%;
    height: 43%;
    display: grid;
    grid-template-columns: 34% 66%;
    align-items: center;
  }

  .people-copy {
    position: relative;
    height: 100%;
    padding-top: 9%;
    box-sizing: border-box;
    z-index: 5;
  }

  .eyebrow { margin: 0 0 15px; color: #8ca0bb; font-size: 11px; letter-spacing: .03em; }

  .people-copy h2 {
    margin: 0;
    color: #111a2b;
    font-family: var(--font-display);
    font-size: clamp(38px, 4.4vw, 66px);
    line-height: .9;
    letter-spacing: -.065em;
    font-weight: 400;
  }

  .people-copy h2 strong { font-weight: 700; }
  .people-description { margin: 24px 0 0; color: #71839d; font-size: 12px; line-height: 1.45; }

  .carousel-controls { display: flex; align-items: center; gap: 12px; margin-top: 48px; }

  .carousel-button {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border: 1px solid rgba(40,120,237,.45);
    display: grid;
    place-items: center;
    padding: 0;
    cursor: pointer;
    font: inherit;
    transition: transform .25s ease, background .25s ease, color .25s ease;
  }

  .carousel-button--prev { background: rgba(255,255,255,.65); color: var(--blue); }
  .carousel-button--next { background: var(--blue); color: white; }
  .carousel-button:hover { transform: translateY(-2px); }

  .carousel-index { color: #8a9bb1; font-size: 10px; letter-spacing: .12em; min-width: 48px; text-align: center; }

  .depth-stage {
    position: relative;
    height: 100%;
    min-width: 0;
    perspective: 1400px;
    outline: none;
    touch-action: pan-y;
    cursor: grab;
  }

  .depth-stage:active { cursor: grabbing; }

  .depth-rail {
    position: absolute;
    top: 0;
    right: 1%;
    width: min(100%, 620px);
    height: 100%;
    transform-style: preserve-3d;
  }

  .depth-card {
    --card-w: clamp(220px, 20vw, 300px);
    --card-h: clamp(290px, 31vw, 380px);
    position: absolute;
    top: 50%;
    left: 0;
    width: var(--card-w);
    height: var(--card-h);
    border-radius: 18px;
    overflow: hidden;
    transform-origin: 50% 50%;
    background: white;
    border: 1px solid rgba(255,255,255,.95);
    box-shadow: 0 24px 55px rgba(55,79,116,.16);
    transform: translate3d(var(--x, 0px), -50%, var(--z, 0px)) rotateY(var(--ry, 0deg)) scale(var(--scale, 1));
    opacity: var(--opacity, 1);
    filter: blur(var(--blur, 0px));
    transition: transform .7s cubic-bezier(.22,1,.36,1), opacity .7s ease, filter .7s ease, box-shadow .7s ease;
    transform-style: preserve-3d;
    cursor: pointer;
  }

  .depth-card[data-position="0"] { --x: 0px; --z: 0px; --ry: 0deg; --scale: 1; --opacity: 1; --blur: 0px; z-index: 5; }
  .depth-card[data-position="1"] { --x: 82px; --z: -220px; --ry: 22deg; --scale: .91; --opacity: .82; --blur: 1px; z-index: 4; }
  .depth-card[data-position="2"] { --x: 154px; --z: -440px; --ry: 22deg; --scale: .82; --opacity: .58; --blur: 3px; z-index: 3; }
  .depth-card[data-position="3"] { --x: 210px; --z: -660px; --ry: 22deg; --scale: .74; --opacity: .28; --blur: 6px; z-index: 2; }

  .depth-card:not([data-position]) { opacity: 0; }

  .depth-card.is-active { box-shadow: 0 28px 65px rgba(45,77,132,.2); }

  .depth-photo {
    position: absolute;
    inset: 0 0 31% 0;
    display: grid;
    place-items: center;
    overflow: hidden;
    background: linear-gradient(145deg, #e6efff 0%, #f9fbff 52%, #d9e7fb 100%);
  }

  .doctor-tone-two .depth-photo { background: linear-gradient(145deg, #edf4ff 0%, #e4edfb 50%, #cfdff6 100%); }
  .doctor-tone-three .depth-photo { background: linear-gradient(145deg, #f2f7ff 0%, #e5efff 48%, #d5e4f8 100%); }

  .portrait-placeholder { position: relative; width: 66%; height: 86%; opacity: .72; }
  .portrait-head { position: absolute; width: 31%; aspect-ratio: 1; left: 35%; top: 9%; border-radius: 50%; background: linear-gradient(145deg,#aabbd0,#8095af); }
  .portrait-body { position: absolute; left: 20%; right: 20%; bottom: 0; height: 68%; border-radius: 45% 45% 14% 14%; background: linear-gradient(145deg,#f7fbff,#d6e4f5); box-shadow: inset 0 0 0 1px rgba(76,111,151,.08); }
  .portrait-body::before { content: ''; position: absolute; left: 44%; top: 7%; width: 1px; height: 85%; background: rgba(50,92,140,.16); }

  .photo-label { position: absolute; left: 14px; top: 14px; padding: 7px 9px; border-radius: 999px; background: rgba(255,255,255,.7); backdrop-filter: blur(10px); color: #72839a; font-size: 7px; letter-spacing: .12em; text-transform: uppercase; }

  .depth-card-info {
    position: absolute;
    left: 9px;
    right: 9px;
    bottom: 9px;
    min-height: 27%;
    padding: 11px 13px;
    box-sizing: border-box;
    border-radius: 11px;
    background: rgba(255,255,255,.97);
  }

  .depth-card-number { display: block; color: #9bbff9; font-size: 9px; letter-spacing: .1em; margin-bottom: 4px; }
  .depth-card-info h3 { margin: 0 0 4px; color: #142035; font-family: var(--font-display); font-size: clamp(15px, 1.3vw, 19px); line-height: 1.05; letter-spacing: -.035em; }
  .depth-card-info p, .depth-card-info small { display: block; margin: 0; color: #6d7d94; font-size: 8px; line-height: 1.3; }
  .depth-card-info small { margin-top: 3px; color: #8a99ac; }

  .depth-hint { position: absolute; right: 2%; bottom: -1px; color: #9aabc0; font-size: 8px; letter-spacing: .1em; text-transform: uppercase; opacity: .8; }

  @media (max-width: 1100px) {
    .people-area { grid-template-columns: 38% 62%; }
    .depth-rail { right: 0; }
    .depth-card { --card-w: clamp(210px, 21vw, 280px); --card-h: clamp(275px, 30vw, 350px); }
    .depth-card[data-position="1"] { --x: 68px; }
    .depth-card[data-position="2"] { --x: 125px; }
    .depth-card[data-position="3"] { --x: 170px; }
  }

  @media (max-width: 760px) {
    .doctors-section { min-height: auto; height: auto; overflow: hidden; }
    .trust-area { height: 42svh; min-height: 320px; }
    .trust-message { font-size: clamp(25px, 7.5vw, 36px); padding: 0 8%; }
    .trust-message br { display: none; }
    .trust-image { width: 76px; height: 58px; right: 8%; top: 49%; }
    .trust-appointment { top: 72%; gap: 10px; }
    .trust-brand { display: none; }

    .people-area {
      position: relative;
      inset: auto;
      height: auto;
      min-height: 680px;
      padding: 58px 6% 72px;
      display: block;
      box-sizing: border-box;
    }

    .people-copy { height: auto; padding-top: 0; }
    .people-copy h2 { font-size: clamp(42px, 12vw, 62px); line-height: .92; }
    .people-description { margin-top: 17px; max-width: 330px; }
    .desktop-break { display: none; }
    .carousel-controls { margin-top: 22px; }

    .depth-stage {
      height: 410px;
      margin-top: 28px;
      width: 100%;
      overflow: visible;
    }

    .depth-rail {
      left: 0;
      right: auto;
      width: 100%;
      height: 100%;
    }

    .depth-card {
      --card-w: min(66vw, 280px);
      --card-h: min(86vw, 360px);
      left: 8%;
      top: 50%;
    }

    .depth-card[data-position="1"] { --x: 72px; --z: -170px; --ry: 20deg; --scale: .9; }
    .depth-card[data-position="2"] { --x: 125px; --z: -330px; --ry: 20deg; --scale: .8; }
    .depth-card[data-position="3"] { --x: 165px; --z: -490px; --ry: 20deg; --scale: .72; }
    .depth-hint { right: 5%; bottom: 0; }
  }

  @media (max-width: 430px) {
    .people-area { min-height: 635px; padding-top: 48px; }
    .depth-stage { height: 375px; margin-top: 24px; }
    .depth-card { --card-w: min(69vw, 265px); --card-h: min(91vw, 345px); left: 5%; }
    .depth-card[data-position="1"] { --x: 55px; --z: -145px; }
    .depth-card[data-position="2"] { --x: 100px; --z: -285px; }
    .depth-card[data-position="3"] { --x: 135px; --z: -425px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .depth-card, .carousel-button { transition: none; }
  }
</style>
