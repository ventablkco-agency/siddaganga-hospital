---
import IconSlideButton from '../ui/IconSlideButton.astro';

const appointmentUrl = 'https://wa.me/919591799099';

const doctors = [
  {
    name: 'Dr. Nagaraj S K',
    role: 'General Medicine · Cardiac & Diabetes Specialist',
    qualification: 'MBBS, MD (Gen Med), FDM (UK)',
  },
  {
    name: 'Dr. Santosh V. Motagi',
    role: 'General Surgery',
    qualification: 'MBBS, MS (General Surgery)',
  },
  {
    name: 'Dr. Basavaraj Kallihal',
    role: 'Obstetrics',
    qualification: 'MBBS, DGO',
  },
];
---

<section id="doctors" class="doctors-section" aria-labelledby="doctors-title">
  <div class="doctors-inner">
    <div class="trust-area">
      <span class="decor decor-left" aria-hidden="true"></span>
      <span class="decor decor-right" aria-hidden="true"></span>

      <p class="trust-message">
        Medicine <strong>starts with science</strong> — but true<br />
        healing <strong>begins with trust</strong>
      </p>

      <div class="trust-image" aria-label="Doctor image placeholder">
        <span>Image</span>
      </div>

      <div class="trust-appointment">
        <span class="trust-brand"><span>✦</span> SGH</span>
        <IconSlideButton
          href={appointmentUrl}
          label="Make an appointment"
          newTab={true}
          variant="blue"
        />
      </div>
    </div>

    <div class="people-area">
      <div class="people-copy">
        <p class="eyebrow">{`{ Our doctors }`}</p>
        <h2 id="doctors-title">Meet the people<br /><strong>who care.</strong></h2>
        <p class="people-description">
          Our team brings together expertise, empathy, and a<br class="desktop-break" />
          deep passion for helping others.
        </p>

        <div class="carousel-controls" aria-label="Doctor carousel controls">
          <button class="carousel-button carousel-button--prev" type="button" aria-label="Previous doctors">
            <span>←</span>
          </button>
          <button class="carousel-button carousel-button--next" type="button" aria-label="Next doctors">
            <span>→</span>
          </button>
        </div>
      </div>

      <div class="doctor-carousel" data-carousel>
        {doctors.map((doctor, index) => (
          <article class:list={['doctor-card', index === 0 && 'is-active']} data-card data-index={index}>
            <div class="doctor-image" aria-label={`${doctor.name} image placeholder`}>
              <span>Image</span>
              {index === 0 && <span class="experience-badge">SGH<br /><strong>Doctor</strong></span>}
            </div>
            <div class="doctor-info">
              <h3>{doctor.name}</h3>
              <p>{doctor.role}</p>
              <small>{doctor.qualification}</small>
              <span class="card-arrow" aria-hidden="true">→</span>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const initDoctorCarousel = () => {
    const carousel = document.querySelector('[data-carousel]');
    if (!carousel) return;

    const cards = Array.from(carousel.querySelectorAll('[data-card]'));
    const previous = document.querySelector('.carousel-button--prev');
    const next = document.querySelector('.carousel-button--next');
    let activeIndex = 0;

    const render = () => {
      cards.forEach((card, index) => {
        const offset = (index - activeIndex + cards.length) % cards.length;
        card.classList.toggle('is-active', offset === 0);
        card.classList.toggle('is-left', offset === cards.length - 1);
        card.classList.toggle('is-right', offset === 1);
        card.classList.toggle('is-hidden', offset > 1 && offset < cards.length - 1);
      });
    };

    previous?.addEventListener('click', () => {
      activeIndex = (activeIndex - 1 + cards.length) % cards.length;
      render();
    });

    next?.addEventListener('click', () => {
      activeIndex = (activeIndex + 1) % cards.length;
      render();
    });

    render();
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initDoctorCarousel, { once: true });
  } else {
    initDoctorCarousel();
  }
</script>

<style>
  .doctors-section {
    --blue: #2878ed;
    --ink: #101a2b;
    --muted: #6a7a91;
    position: relative;
    width: 100%;
    min-height: 100svh;
    height: 100svh;
    overflow: hidden;
    box-sizing: border-box;
    background: #edf2ff;
    color: var(--ink);
    font-family: var(--font-body);
  }

  .doctors-inner {
    width: 100%;
    height: 100%;
    position: relative;
    box-sizing: border-box;
  }

  .trust-area {
    position: relative;
    height: 45.5%;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    padding-top: clamp(38px, 6.5vh, 72px);
    box-sizing: border-box;
  }

  .trust-message {
    margin: 0;
    text-align: center;
    color: #59677b;
    font-family: var(--font-display);
    font-size: clamp(31px, 4vw, 58px);
    line-height: .98;
    letter-spacing: -.055em;
    font-weight: 400;
    position: relative;
    z-index: 2;
  }

  .trust-message strong {
    color: #111820;
    font-weight: 700;
  }

  .decor {
    position: absolute;
    width: 44px;
    height: 44px;
    border-radius: 11px;
    background: rgba(255,255,255,.6);
  }

  .decor-left { left: 4.7%; top: 25%; }
  .decor-right { right: 4.7%; top: 30%; }

  .trust-image {
    position: absolute;
    right: 21%;
    top: 46%;
    width: 104px;
    height: 78px;
    border-radius: 13px;
    transform: rotate(-10deg);
    display: grid;
    place-items: center;
    background: rgba(255,255,255,.45);
    border: 1px solid rgba(255,255,255,.75);
    color: #9aa6b8;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: .08em;
  }

  .trust-appointment {
    position: absolute;
    left: 50%;
    top: 68%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 22px;
    z-index: 3;
  }

  .trust-brand {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #a0adbf;
    font-size: 10px;
    letter-spacing: .12em;
    white-space: nowrap;
  }

  .trust-brand span {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--blue);
    color: white;
    font-size: 9px;
  }

  .people-area {
    position: absolute;
    left: 4.7%;
    right: 4.7%;
    bottom: 8.5%;
    height: 43%;
    display: grid;
    grid-template-columns: 31% 69%;
    align-items: center;
  }

  .people-copy {
    position: relative;
    height: 100%;
    padding-top: 10%;
    box-sizing: border-box;
    z-index: 5;
  }

  .eyebrow {
    margin: 0 0 15px;
    color: #8ca0bb;
    font-size: 11px;
    letter-spacing: .03em;
  }

  .people-copy h2 {
    margin: 0;
    color: #111a2b;
    font-family: var(--font-display);
    font-size: clamp(38px, 4.4vw, 66px);
    line-height: .9;
    letter-spacing: -.065em;
    font-weight: 400;
  }

  .people-copy h2 strong { font-weight: 700; }

  .people-description {
    margin: 24px 0 0;
    color: #71839d;
    font-size: 12px;
    line-height: 1.45;
  }

  .carousel-controls {
    display: flex;
    gap: 13px;
    margin-top: 58px;
  }

  .carousel-button {
    width: 25px;
    height: 25px;
    border-radius: 50%;
    border: 1px solid var(--blue);
    display: grid;
    place-items: center;
    padding: 0;
    cursor: pointer;
    font: inherit;
    transition: transform .25s ease, background .25s ease, color .25s ease;
  }

  .carousel-button--prev {
    background: transparent;
    color: var(--blue);
  }

  .carousel-button--next {
    background: var(--blue);
    color: white;
  }

  .carousel-button:hover { transform: translateY(-2px); }

  .doctor-carousel {
    position: relative;
    height: 100%;
    overflow: visible;
  }

  .doctor-card {
    position: absolute;
    top: 0;
    width: 29.5%;
    height: 100%;
    border-radius: 13px;
    overflow: hidden;
    background: #fff;
    border: 1px solid rgba(255,255,255,.8);
    box-shadow: 0 8px 28px rgba(66,91,129,.06);
    transition: left .55s cubic-bezier(.22,1,.36,1), background .45s ease, color .35s ease, transform .55s cubic-bezier(.22,1,.36,1), opacity .35s ease;
  }

  .doctor-card.is-active {
    left: 0;
    background: linear-gradient(160deg, #2778f1 0%, #1f68df 100%);
    color: white;
    z-index: 3;
  }

  .doctor-card.is-right {
    left: 31.5%;
    z-index: 2;
  }

  .doctor-card.is-left {
    left: -31.5%;
    z-index: 1;
    opacity: 0;
  }

  .doctor-card.is-hidden {
    left: 100%;
    opacity: 0;
    pointer-events: none;
  }

  .doctor-image {
    position: absolute;
    inset: 0 0 25% 0;
    display: grid;
    place-items: center;
    color: rgba(91,108,132,.35);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: .08em;
    background: rgba(255,255,255,.48);
  }

  .is-active .doctor-image {
    background: radial-gradient(circle at 70% 20%, rgba(255,255,255,.2), transparent 34%), linear-gradient(160deg, rgba(255,255,255,.08), rgba(0,54,170,.12));
    color: rgba(255,255,255,.55);
  }

  .experience-badge {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 39px;
    height: 39px;
    border-radius: 7px;
    background: rgba(255,255,255,.9);
    color: #26344b;
    display: grid;
    place-items: center;
    text-align: center;
    font-size: 7px;
    line-height: 1.05;
  }

  .experience-badge strong { font-size: 8px; }

  .doctor-info {
    position: absolute;
    left: 8px;
    right: 8px;
    bottom: 8px;
    min-height: 26%;
    border-radius: 10px;
    background: rgba(255,255,255,.96);
    color: #18243a;
    padding: 12px 36px 9px 12px;
    box-sizing: border-box;
  }

  .doctor-info h3 {
    margin: 0 0 3px;
    font-family: var(--font-display);
    font-size: clamp(14px, 1.2vw, 18px);
    line-height: 1.05;
    letter-spacing: -.035em;
  }

  .doctor-info p,
  .doctor-info small {
    display: block;
    margin: 0;
    color: #65758d;
    font-size: 8px;
    line-height: 1.25;
  }

  .doctor-info small { margin-top: 2px; }

  .card-arrow {
    position: absolute;
    right: 10px;
    bottom: 10px;
    width: 23px;
    height: 23px;
    border-radius: 50%;
    background: white;
    color: var(--blue);
    display: grid;
    place-items: center;
    font-size: 13px;
  }

  @media (max-width: 900px) {
    .trust-area { height: 43%; }
    .trust-message { font-size: clamp(28px, 5vw, 44px); }
    .trust-image { right: 12%; }
    .people-area { grid-template-columns: 34% 66%; bottom: 7%; height: 45%; }
    .people-copy h2 { font-size: clamp(34px, 5.3vw, 52px); }
    .doctor-card { width: 45%; }
    .doctor-card.is-right { left: 48%; }
    .doctor-card.is-left { left: -48%; }
    .people-description { font-size: 11px; }
  }

  @media (max-width: 640px) {
    .doctors-section { min-height: 100svh; height: auto; overflow: hidden; }
    .trust-area { height: 43svh; min-height: 330px; }
    .trust-message { font-size: clamp(25px, 7.5vw, 36px); }
    .trust-message br { display: none; }
    .trust-image { width: 76px; height: 58px; right: 8%; top: 49%; }
    .trust-appointment { top: 73%; gap: 10px; }
    .trust-brand { display: none; }
    .people-area { position: relative; inset: auto; height: 57svh; min-height: 420px; padding: 0 6%; display: block; }
    .people-copy { height: 35%; padding-top: 4%; }
    .people-copy h2 { font-size: clamp(38px, 12vw, 58px); }
    .people-description { margin-top: 14px; }
    .carousel-controls { margin-top: 18px; }
    .doctor-carousel { position: absolute; left: 6%; right: 6%; bottom: 6%; height: 58%; }
    .doctor-card { width: 58%; height: 100%; }
    .doctor-card.is-active { left: 0; }
    .doctor-card.is-right { left: 62%; }
    .doctor-card.is-left { left: -62%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .doctor-card,
    .carousel-button { transition: none; }
  }
</style>
