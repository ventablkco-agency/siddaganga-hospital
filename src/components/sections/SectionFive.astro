---
import IconSlideButton from '../ui/IconSlideButton.astro';

const appointmentUrl = 'https://wa.me/919591799099';
---

<section id="doctors" class="doctors-section" aria-labelledby="doctors-title">
  <div class="trust-panel">
    <span class="decor decor-left" aria-hidden="true"></span>
    <span class="decor decor-right" aria-hidden="true"></span>

    <p class="trust-message">
      Medicine <strong>starts with science</strong> — but true<br />
      healing <strong>begins with trust</strong>
    </p>

    <div class="trust-image" aria-hidden="true"></div>

    <div class="trust-appointment">
      <span class="trust-line" aria-hidden="true"></span>
      <IconSlideButton
        href={appointmentUrl}
        label="Make an appointment"
        newTab={true}
        variant="blue"
      />
    </div>
  </div>
</section>

<style>
  .doctors-section {
    --blue: #2878ed;
    --ink: #111b2d;
    position: relative;
    min-height: 100svh;
    height: 100svh;
    overflow: hidden;
    box-sizing: border-box;
    padding: clamp(26px, 4vw, 48px) clamp(28px, 4.6vw, 70px) clamp(30px, 4vw, 48px);
    background: #edf2ff;
    color: var(--ink);
    display: flex;
    flex-direction: column;
  }

  .trust-panel {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    justify-content: flex-start;
    align-items: center;
    flex-direction: column;
    padding-top: clamp(10px, 1.2vw, 18px);
    box-sizing: border-box;
  }

  .trust-message {
    margin: 0;
    text-align: center;
    color: #5d6a7c;
    font-family: var(--font-display);
    font-size: clamp(34px, 4.05vw, 61px);
    line-height: .99;
    letter-spacing: -.055em;
    font-weight: 400;
    position: relative;
    z-index: 2;
  }

  .trust-message strong {
    color: #111820;
    font-weight: 700;
  }

  .decor {
    position: absolute;
    width: 43px;
    height: 43px;
    border-radius: 10px;
    background: rgba(255,255,255,.58);
  }

  .decor-left { left: 1.5%; top: 17%; }
  .decor-right { right: 1.5%; top: 24%; }

  .trust-image {
    position: absolute;
    right: 17.5%;
    bottom: 14%;
    width: 104px;
    height: 78px;
    border-radius: 12px;
    transform: rotate(-10deg);
    background: rgba(255,255,255,.48);
    border: 1px solid rgba(255,255,255,.65);
    box-shadow: 0 12px 30px rgba(55,78,112,.05);
  }

  .trust-appointment {
    position: absolute;
    left: 50%;
    bottom: 8%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 15px;
  }

  .trust-line {
    width: 78px;
    height: 1px;
    background: #d2dbe9;
  }

  @media (max-width: 950px) {
    .doctors-section {
      height: 100svh;
      min-height: 100svh;
    }

    .trust-message {
      font-size: clamp(30px, 7vw, 48px);
    }

    .trust-image {
      right: 10%;
      bottom: 17%;
    }
  }
</style>
