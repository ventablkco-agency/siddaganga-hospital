---
import IconSlideButton from '../ui/IconSlideButton.astro';

const appointmentUrl = 'https://wa.me/919591799099';

const doctors = [
  {
    name: 'Dr. Nagaraj S K',
    role: 'General Medicine · Cardiac & Diabetes Specialist',
    badge: 'Lead physician',
    featured: true,
  },
  {
    name: 'Dr. Santosh V. Motagi',
    role: 'General Surgery',
    badge: 'Surgeon',
    featured: false,
  },
  {
    name: 'Dr. Basavaraj Kallihal',
    role: 'Obstetrics',
    badge: 'Obstetrics',
    featured: false,
  },
];
---

<section id="doctors" class="doctors-section" aria-labelledby="doctors-title">
  <div class="trust-hero">
    <span class="soft-square soft-square-left" aria-hidden="true"></span>
    <span class="soft-square soft-square-right" aria-hidden="true"></span>

    <p class="trust-message">
      Medicine <strong>starts with science</strong> — but true<br />
      healing <strong>begins with trust</strong>
    </p>

    <div class="trust-visual-placeholder" aria-hidden="true">
      <span>Image</span>
    </div>

    <div class="trust-cta">
      <span class="trust-rule" aria-hidden="true"></span>
      <IconSlideButton
        href={appointmentUrl}
        label="Make an appointment"
        newTab={true}
        variant="blue"
      />
    </div>
  </div>

  <div class="doctors-area">
    <div class="doctors-intro">
      <div class="brand-mark"><span>✦</span> SGH</div>

      <div class="intro-copy">
        <p class="eyebrow">{`{ Our doctors }`}</p>
        <h2 id="doctors-title">Meet the people<br /><strong>who care.</strong></h2>
        <p class="description">
          Our team brings together expertise, empathy,
          and a deep passion for helping others.
        </p>
      </div>

      <div class="doctor-controls" aria-label="Doctor carousel controls">
        <button type="button" aria-label="Previous doctors">←</button>
        <button type="button" class="active" aria-label="Next doctors">→</button>
      </div>
    </div>

    <div class="doctors-rail">
      {doctors.map((doctor, index) => (
        <article class:list={["doctor-card", { featured: doctor.featured }]}>
          <div class="doctor-visual" aria-label={`Image placeholder for ${doctor.name}`}>
            {doctor.featured && <span class="practice-badge"><strong>8+</strong><small>Years in<br />practice</small></span>}
            <span class="image-placeholder">Doctor image</span>
          </div>

          <div class="doctor-card-info">
            <div>
              <p class="doctor-role">{doctor.badge}</p>
              <h3>{doctor.name}</h3>
              <p class="doctor-speciality">{doctor.role}</p>
            </div>
            <a class="doctor-arrow" href={appointmentUrl} target="_blank" rel="noreferrer" aria-label={`Book an appointment with ${doctor.name}`}>
              →
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .doctors-section {
    position: relative;
    min-height: 100svh;
    height: 100svh;
    box-sizing: border-box;
    overflow: hidden;
    padding: clamp(28px, 4vw, 54px) clamp(22px, 4.5vw, 64px) clamp(24px, 3vw, 42px);
    background: #edf3ff;
    color: #111827;
    display: flex;
    flex-direction: column;
  }

  .trust-hero {
    position: relative;
    flex: 0 0 43%;
    min-height: 270px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    padding-top: clamp(6px, 1vw, 16px);
  }

  .trust-message {
    position: relative;
    z-index: 2;
    margin: 0;
    text-align: center;
    color: #4e5c70;
    font-family: var(--font-display);
    font-size: clamp(34px, 4.15vw, 61px);
    line-height: 1.05;
    letter-spacing: -.055em;
    font-weight: 400;
  }

  .trust-message strong {
    color: #111820;
    font-weight: 700;
  }

  .soft-square {
    position: absolute;
    width: 45px;
    height: 45px;
    border-radius: 10px;
    background: rgba(255,255,255,.48);
    filter: blur(.2px);
  }

  .soft-square-left { left: 2%; top: 16%; }
  .soft-square-right { right: 1.5%; top: 21%; }

  .trust-visual-placeholder {
    position: absolute;
    right: 16%;
    top: 51%;
    width: 104px;
    height: 78px;
    border-radius: 12px;
    background: rgba(255,255,255,.5);
    transform: rotate(-10deg);
    display: grid;
    place-items: center;
    color: rgba(90,108,133,.28);
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: .1em;
  }

  .trust-cta {
    position: absolute;
    bottom: 4px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .trust-rule {
    width: 82px;
    height: 1px;
    background: #d7dfeb;
  }

  .doctors-area {
    flex: 1 1 auto;
    min-height: 0;
    width: min(100%, 1410px);
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(270px, .88fr) minmax(0, 1.9fr);
    align-items: end;
    gap: clamp(30px, 5vw, 70px);
  }

  .doctors-intro {
    height: 100%;
    min-height: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 0 0 3px;
  }

  .brand-mark {
    color: #172b49;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: -.02em;
  }

  .brand-mark span {
    display: inline-grid;
    place-items: center;
    width: 22px;
    height: 22px;
    margin-right: 6px;
    border-radius: 50%;
    background: #2478ed;
    color: #fff;
    font-size: 9px;
  }

  .intro-copy { margin: auto 0; }

  .eyebrow {
    margin: 0 0 12px;
    color: #8793a6;
    font-size: 9px;
    letter-spacing: .01em;
  }

  .intro-copy h2 {
    margin: 0;
    color: #111820;
    font-family: var(--font-display);
    font-size: clamp(42px, 4.6vw, 67px);
    line-height: .88;
    letter-spacing: -.065em;
    font-weight: 400;
  }

  .intro-copy h2 strong { font-weight: 700; }

  .description {
    max-width: 300px;
    margin: 20px 0 0;
    color: #718096;
    font-size: 11px;
    line-height: 1.45;
  }

  .doctor-controls {
    display: flex;
    gap: 9px;
  }

  .doctor-controls button {
    width: 30px;
    height: 30px;
    border: 1px solid #2478ed;
    border-radius: 50%;
    background: transparent;
    color: #2478ed;
    font-size: 15px;
    cursor: pointer;
  }

  .doctor-controls button.active {
    background: #2478ed;
    color: #fff;
  }

  .doctors-rail {
    min-width: 0;
    height: min(48vh, 350px);
    display: grid;
    grid-template-columns: 1.18fr .84fr .84fr;
    gap: 7px;
  }

  .doctor-card {
    position: relative;
    min-width: 0;
    overflow: hidden;
    border-radius: 11px;
    background: #fff;
    box-shadow: 0 12px 30px rgba(35, 63, 103, .055);
  }

  .doctor-visual {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(rgba(48,100,177,.025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(48,100,177,.025) 1px, transparent 1px),
      #fafcff;
    background-size: 38px 38px;
  }

  .doctor-card.featured .doctor-visual {
    background: linear-gradient(145deg, #176bea 0%, #287af3 100%);
  }

  .image-placeholder {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: rgba(79,101,131,.2);
    font-size: 9px;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  .featured .image-placeholder { color: rgba(255,255,255,.24); }

  .practice-badge {
    position: absolute;
    z-index: 2;
    right: 10px;
    top: 10px;
    width: 43px;
    height: 48px;
    border-radius: 5px;
    background: rgba(255,255,255,.94);
    color: #172b49;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    line-height: 1;
  }

  .practice-badge strong { font-size: 17px; }
  .practice-badge small { margin-top: 3px; font-size: 6px; text-align: center; line-height: 1.2; }

  .doctor-card-info {
    position: absolute;
    z-index: 3;
    left: 8px;
    right: 8px;
    bottom: 8px;
    min-height: 60px;
    padding: 10px 10px 8px;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 8px;
    border-radius: 9px;
    background: rgba(255,255,255,.95);
    box-shadow: 0 8px 22px rgba(27,52,83,.08);
    backdrop-filter: blur(10px);
  }

  .doctor-role {
    margin: 0 0 3px;
    color: #2478ed;
    font-size: 7px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .08em;
  }

  .doctor-card-info h3 {
    margin: 0;
    color: #172b49;
    font-family: var(--font-display);
    font-size: clamp(13px, 1.2vw, 17px);
    line-height: 1.05;
    letter-spacing: -.035em;
    font-weight: 600;
  }

  .doctor-speciality {
    max-width: 205px;
    margin: 3px 0 0;
    color: #71809a;
    font-size: 7px;
    line-height: 1.3;
  }

  .doctor-arrow {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: #2478ed;
    color: #fff;
    font-size: 14px;
    text-decoration: none;
  }

  @media (max-width: 950px) {
    .doctors-section { height: auto; min-height: 100svh; overflow: visible; }
    .trust-hero { flex-basis: 390px; }
    .doctors-area { grid-template-columns: 1fr; gap: 25px; }
    .doctors-intro { min-height: 230px; }
    .doctors-rail { height: 330px; }
  }

  @media (max-width: 640px) {
    .doctors-section { padding: 26px 16px; }
    .trust-hero { flex-basis: 310px; }
    .trust-message { font-size: 34px; }
    .trust-message br { display: none; }
    .trust-visual-placeholder { right: 8%; }
    .doctors-rail { grid-template-columns: 1fr; height: 320px; }
    .doctor-card:not(:first-child) { display: none; }
  }
</style>
