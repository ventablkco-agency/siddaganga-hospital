---
import IconSlideButton from '../ui/IconSlideButton.astro';
import Icon from '../icons/Icon.astro';

const appointmentUrl = 'https://wa.me/919591799099';

const doctors = [
  { name: 'Dr. Nagaraj S K', role: 'General Medicine · Cardiac & Diabetes Specialist', qualification: 'MBBS, MD (Gen Med), FDM (UK)', tone: 'doctor-tone-one', image: '/assets/doctors/doctor-01.webp' },
  { name: 'Dr. Santosh V. Motagi', role: 'General Surgery', qualification: 'MBBS, MS (General Surgery)', tone: 'doctor-tone-two', image: '/assets/doctors/doctor-02.webp' },
  { name: 'Dr. Basavaraj Kallihal', role: 'Obstetrics', qualification: 'MBBS, DGO', tone: 'doctor-tone-three', image: '/assets/doctors/doctor-03.webp' },
];
---

<section id="doctors" class="doctors-section" aria-labelledby="doctors-title">
  <div class="doctors-inner">
    <div class="trust-area">
      <span class="decor decor-left" aria-hidden="true"></span>
      <span class="decor decor-right" aria-hidden="true"></span>
      <p class="trust-message">Medicine <strong>starts with science</strong> — but true<br />healing <strong>begins with trust</strong></p>
      <figure class="trust-image"><img src="/assets/doctors/doctor-01.webp" alt="Dr. Nagaraj S K" loading="lazy" decoding="async" /><figcaption>SGH · Care team</figcaption></figure>
      <div class="trust-appointment">
        <span class="trust-brand"><Icon name="medicine" size={14} strokeWidth={1.7} /> SGH</span>
        <IconSlideButton href={appointmentUrl} label="Make an appointment" newTab={true} variant="blue" />
      </div>
    </div>

    <div class="people-area">
      <div class="people-copy">
        <p class="eyebrow">{`{ Our doctors }`}</p>
        <h2 id="doctors-title">Meet the people<br /><strong>who care.</strong></h2>
        <p class="people-description">Our team brings together expertise, empathy, and a<br class="desktop-break" /> deep passion for helping others.</p>
        <div class="scroll-progress" aria-live="polite">
          <span class="scroll-progress-line"><span data-scroll-progress></span></span>
          <span class="scroll-progress-label" data-scroll-label>01 / 03</span>
        </div>
        <p class="scroll-hint"><Icon name="arrow-down" size={12} strokeWidth={1.7} /> Scroll to meet every doctor</p>
      </div>

      <div class="depth-stage" data-depth-carousel tabindex="0" aria-label="Our doctors. Scroll to meet every doctor.">
        <div class="depth-rail">
          {doctors.map((doctor, index) => (
            <article class:list={['depth-card', doctor.tone, index === 0 && 'is-active']} data-depth-card data-index={index} aria-hidden={index !== 0}>
              <div class="depth-photo" aria-label={`${doctor.name} portrait`}>
                <img src={doctor.image} alt={`${doctor.name} — ${doctor.role}`} loading={index === 0 ? 'eager' : 'lazy'} draggable="false" />
                <span class="photo-label">SGH · Doctor portrait</span>
              </div>
              <div class="depth-card-info">
                <span class="depth-card-number">0{index + 1}</span>
                <h3>{doctor.name}</h3>
                <p><Icon name="medicine" size={12} strokeWidth={1.7} /> {doctor.role}</p>
                <small><Icon name="qualification" size={12} strokeWidth={1.7} /> {doctor.qualification}</small>
                <span class="doctor-availability"><Icon name="calendar" size={11} strokeWidth={1.7} /> Appointments available</span>
              </div>
            </article>
          ))}
        </div>
        <div class="depth-hint" aria-hidden="true"><Icon name="drag" size={12} strokeWidth={1.6} /> Scroll to explore</div>
      </div>
    </div>
  </div>
</section>

<script>
  const initDepthDoctorCarousel = () => {
    document.querySelectorAll('[data-depth-carousel]').forEach((stage) => {
      if (stage.dataset.ready === 'true') return;
      stage.dataset.ready = 'true';
      const cards = Array.from(stage.querySelectorAll('[data-depth-card]'));
      const section = stage.closest('.doctors-section');
      const indexLabel = section?.querySelector('[data-scroll-label]');
      const progress = section?.querySelector('[data-scroll-progress]');
      let activeIndex = 0;
      let locked = false;
      let touchY = 0;
      let touchX = 0;
      const render = () => {
        cards.forEach((card,index) => {
          const offset = (index-activeIndex+cards.length)%cards.length;
          card.dataset.position = String(offset);
          card.classList.toggle('is-active',offset===0);
          card.setAttribute('aria-hidden',offset===0?'false':'true');
        });
        if(indexLabel) indexLabel.textContent=`${String(activeIndex+1).padStart(2,'0')} / ${String(cards.length).padStart(2,'0')}`;
        if(progress) progress.style.width=`${((activeIndex+1)/cards.length)*100}%`;
      };
      const canMove = direction => direction>0 ? activeIndex<cards.length-1 : activeIndex>0;
      const move = direction => { if(!canMove(direction)||locked) return false; locked=true; activeIndex+=direction; render(); window.setTimeout(()=>{locked=false;},760); return true; };
      stage.addEventListener('wheel',event=>{ if(Math.abs(event.deltaY)<8) return; const direction=event.deltaY>0?1:-1; if(canMove(direction)){event.preventDefault();event.stopPropagation();move(direction);} },{passive:false});
      stage.addEventListener('keydown',event=>{const direction=event.key==='ArrowDown'||event.key==='ArrowRight'?1:event.key==='ArrowUp'||event.key==='ArrowLeft'?-1:0;if(direction&&canMove(direction)){event.preventDefault();move(direction);}});
      stage.addEventListener('touchstart',event=>{touchY=event.changedTouches[0].clientY;touchX=event.changedTouches[0].clientX;},{passive:true});
      stage.addEventListener('touchend',event=>{const touch=event.changedTouches[0];const dy=touch.clientY-touchY;const dx=touch.clientX-touchX;if(Math.abs(dy)<40||Math.abs(dy)<Math.abs(dx)) return;move(dy<0?1:-1);},{passive:true});
      cards.forEach(card=>card.addEventListener('click',()=>{const index=Number(card.dataset.index);if(index===activeIndex)return;activeIndex=index;render();}));
      render();
    });
  };
  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',initDepthDoctorCarousel,{once:true}); else initDepthDoctorCarousel();
</script>

<style>
.doctors-section{--blue:#2878ed;--ink:#101a2b;position:relative;width:100%;min-height:92svh;height:92svh;overflow:hidden;box-sizing:border-box;background:#edf2ff;color:var(--ink);font-family:var(--font-body)}.doctors-inner{width:100%;height:100%;position:relative;box-sizing:border-box}.trust-area{position:relative;height:45.5%;display:flex;justify-content:center;align-items:flex-start;padding-top:clamp(38px,6.5vh,72px);box-sizing:border-box}.trust-message{margin:0;text-align:center;color:#59677b;font-family:var(--font-display);font-size:clamp(31px,4vw,58px);line-height:.98;letter-spacing:-.055em;font-weight:400;position:relative;z-index:2}.trust-message strong{color:#111820;font-weight:700}.decor{position:absolute;width:44px;height:44px;border-radius:11px;background:rgba(255,255,255,.6)}.decor-left{left:4.7%;top:25%}.decor-right{right:4.7%;top:30%}.trust-image{position:absolute;right:21%;top:46%;width:118px;height:88px;margin:0;border-radius:13px;transform:rotate(-8deg);overflow:hidden;background:#dce8f7;border:1px solid rgba(255,255,255,.8);box-shadow:0 12px 30px rgba(40,70,110,.12)}.trust-image img{width:100%;height:100%;display:block;object-fit:cover;object-position:center 20%}.trust-image figcaption{position:absolute;left:7px;bottom:6px;padding:3px 6px;border-radius:999px;background:rgba(255,255,255,.75);color:#66778f;font-size:7px;letter-spacing:.08em;text-transform:uppercase}.trust-appointment{position:absolute;left:50%;top:68%;transform:translateX(-50%);display:flex;align-items:center;gap:22px;z-index:3}.trust-brand{display:inline-flex;align-items:center;gap:6px;color:#a0adbf;font-size:13px;letter-spacing:.12em;white-space:nowrap}.trust-brand svg{color:var(--blue)}
.people-area{position:absolute;left:4.7%;right:4.7%;bottom:8.5%;height:43%;display:grid;grid-template-columns:34% 66%;align-items:center}.people-copy{position:relative;height:100%;padding-top:9%;box-sizing:border-box;z-index:5}.eyebrow{margin:0 0 15px;color:#8ca0bb;font-size:13px;letter-spacing:.03em}.people-copy h2{margin:0;color:#111a2b;font-family:var(--font-display);font-size:clamp(38px,4.4vw,66px);line-height:.9;letter-spacing:-.065em;font-weight:400}.people-copy h2 strong{font-weight:700}.people-description{margin:24px 0 0;color:#71839d;font-size:15px;line-height:1.45}.scroll-progress{display:flex;align-items:center;gap:12px;margin-top:36px;width:min(210px,80%)}.scroll-progress-line{position:relative;display:block;flex:1;height:2px;border-radius:999px;background:rgba(40,120,237,.16);overflow:hidden}.scroll-progress-line span{display:block;height:100%;width:33.333%;border-radius:inherit;background:var(--blue);transition:width .7s cubic-bezier(.22,1,.36,1)}.scroll-progress-label{min-width:38px;color:#7f91a9;font-size:11px;letter-spacing:.12em}.scroll-hint{display:flex;align-items:center;gap:6px;margin:12px 0 0;color:#a0afc2;font-size:11px;letter-spacing:.11em;text-transform:uppercase}.depth-stage{position:relative;height:100%;min-width:0;perspective:1400px;outline:none;touch-action:pan-y}.depth-rail{position:absolute;top:0;right:1%;width:min(100%,620px);height:100%;transform-style:preserve-3d}.depth-card{--card-w:clamp(220px,20vw,300px);--card-h:clamp(290px,31vw,380px);position:absolute;top:50%;left:0;width:var(--card-w);height:var(--card-h);border-radius:18px;overflow:hidden;transform-origin:50% 50%;background:white;border:1px solid rgba(255,255,255,.95);box-shadow:0 24px 55px rgba(55,79,116,.16);transform:translate3d(var(--x,0px),-50%,var(--z,0px)) rotateY(var(--ry,0deg)) scale(var(--scale,1));opacity:var(--opacity,1);filter:blur(var(--blur,0px));transition:transform .7s cubic-bezier(.22,1,.36,1),opacity .7s ease,filter .7s ease,box-shadow .7s ease;transform-style:preserve-3d;cursor:pointer}.depth-card[data-position="0"]{--x:0px;--z:0px;--ry:0deg;--scale:1;--opacity:1;--blur:0px;z-index:5}.depth-card[data-position="1"]{--x:82px;--z:-220px;--ry:22deg;--scale:.91;--opacity:.82;--blur:1px;z-index:4}.depth-card[data-position="2"]{--x:154px;--z:-440px;--ry:22deg;--scale:.82;--opacity:.58;--blur:3px;z-index:3}.depth-card[data-position="3"]{--x:210px;--z:-660px;--ry:22deg;--scale:.74;--opacity:.28;--blur:6px;z-index:2}.depth-card.is-active{box-shadow:0 28px 65px rgba(45,77,132,.2)}.depth-photo{position:absolute;inset:0 0 31% 0;overflow:hidden;background:#e6efff}.depth-photo img{width:100%;height:100%;display:block;object-fit:cover;object-position:center 24%}.photo-label{position:absolute;left:14px;top:14px;padding:7px 9px;border-radius:999px;background:rgba(255,255,255,.7);backdrop-filter:blur(10px);color:#72839a;font-size:11px;letter-spacing:.12em;text-transform:uppercase}.depth-card-info{position:absolute;left:9px;right:9px;bottom:9px;min-height:27%;padding:11px 13px;box-sizing:border-box;border-radius:11px;background:rgba(255,255,255,.97)}.depth-card-number{display:block;color:#9bbff9;font-size:11px;letter-spacing:.1em;margin-bottom:4px}.depth-card-info h3{margin:0 0 5px;color:#142035;font-family:var(--font-display);font-size:clamp(15px,1.3vw,19px);line-height:1.05;letter-spacing:-.035em}.depth-card-info p,.depth-card-info small,.doctor-availability{display:flex;align-items:center;gap:5px;margin:0;color:#6d7d94;font-size:13px;line-height:1.3}.depth-card-info small{margin-top:3px;color:#8a99ac}.doctor-availability{margin-top:7px;color:#2878ed;text-transform:uppercase;letter-spacing:.06em;font-size:11px}.depth-card-info svg{flex:0 0 auto;color:#2878ed}.depth-hint{display:flex;align-items:center;gap:6px;position:absolute;right:2%;bottom:-1px;color:#9aabc0;font-size:11px;letter-spacing:.1em;text-transform:uppercase;opacity:.8}
@media(max-width:1100px){.people-area{grid-template-columns:38% 62%}.depth-card{--card-w:clamp(210px,21vw,280px);--card-h:clamp(275px,30vw,350px)}.depth-card[data-position="1"]{--x:68px}.depth-card[data-position="2"]{--x:125px}.depth-card[data-position="3"]{--x:170px}}@media(max-width:760px){.doctors-section{min-height:auto;height:auto;overflow:hidden}.trust-area{height:42svh;min-height:320px}.trust-message{font-size:clamp(25px,7.5vw,36px);padding:0 8%}.trust-message br{display:none}.trust-image{width:92px;height:70px;right:8%;top:49%}.trust-appointment{top:72%;gap:10px}.trust-brand{display:none}.people-area{position:relative;inset:auto;height:auto;min-height:720px;padding:58px 6% 72px;display:block;box-sizing:border-box}.people-copy{height:auto;padding-top:0}.people-copy h2{font-size:clamp(42px,12vw,62px);line-height:.92}.people-description{margin-top:17px;max-width:330px}.desktop-break{display:none}.scroll-progress{margin-top:24px;width:min(240px,90%)}.depth-stage{height:410px;margin-top:26px;width:100%;overflow:visible}.depth-rail{left:0;right:auto;width:100%;height:100%}.depth-card{--card-w:min(66vw,280px);--card-h:min(86vw,360px);left:8%;top:50%}.depth-card[data-position="1"]{--x:72px;--z:-170px;--ry:20deg;--scale:.9}.depth-card[data-position="2"]{--x:125px;--z:-330px;--ry:20deg;--scale:.8}.depth-card[data-position="3"]{--x:165px;--z:-490px;--ry:20deg;--scale:.72}.depth-hint{right:5%;bottom:0}}@media(max-width:430px){.people-area{min-height:690px;padding-top:48px}.depth-stage{height:375px;margin-top:24px}.depth-card{--card-w:min(69vw,265px);--card-h:min(91vw,345px);left:5%}.depth-card[data-position="1"]{--x:55px;--z:-145px}.depth-card[data-position="2"]{--x:100px;--z:-285px}.depth-card[data-position="3"]{--x:135px;--z:-425px}}@media(prefers-reduced-motion:reduce){.depth-card,.scroll-progress-line span{transition:none}}
</style>
