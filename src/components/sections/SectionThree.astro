---
import Icon from '../icons/Icon.astro';

const appointmentUrl = 'https://wa.me/919591799099';

const services = [
  { number: '01', title: 'Cardiology', description: 'Heart-focused diagnosis and treatment, supported by 2D Echo and TMT facilities.', icon: 'cardiology' },
  { number: '02', title: 'Diabetology & General Medicine', description: 'Specialist care for diabetes, blood pressure and related medical conditions.', icon: 'diabetes', featured: true },
  { number: '03', title: 'Obstetrics & Gynaecology', description: 'Pregnancy, reproductive health, high-risk care, infertility and gynaecological services.', icon: 'baby' },
  { number: '04', title: 'General Surgery', description: 'Surgical care for conditions requiring specialist evaluation and treatment.', icon: 'surgery' },
  { number: '05', title: 'ENT', description: 'Evaluation and treatment for ear, nose and throat conditions.', icon: 'ent' },
  { number: '06', title: 'Diagnostics & Laboratory', description: 'Laboratory testing and diagnostic support for accurate clinical evaluation.', icon: 'laboratory' },
];

const essentialServices = [
  { icon: 'emergency', title: '24 × 7', detail: 'Emergency' },
  { icon: 'laboratory', title: 'Laboratory', detail: 'Services' },
  { icon: 'pharmacy', title: 'Pharmacy', detail: 'On-site support' },
  { icon: 'ambulance', title: 'Ambulance', detail: 'Facility' },
  { icon: 'xray', title: 'Digital X-Ray', detail: 'Diagnostics' },
  { icon: 'cardiology', title: '2D Echo / TMT', detail: 'Cardiac diagnostics' },
];
---

<section id="services" class="services-section" aria-labelledby="services-title">
  <div class="services-shell">
    <header class="services-header">
      <div class="services-heading">
        <p class="services-eyebrow">OUR MEDICAL SERVICES <span>(What you get)</span></p>
        <h2 id="services-title">Care that covers <strong>what matters most.</strong></h2>
      </div>
      <div class="services-header-side">
        <p>Specialist care, diagnostics and essential hospital services — all under one roof. Combining advanced technology with a patient-first approach.</p>
        <a href="#services-grid" class="services-view-link">See all services</a>
      </div>
    </header>

    <div class="services-grid" id="services-grid">
      {services.map((service) => (
        <article class:list={['service-card', { 'service-card--featured': service.featured }]}>
          <div class="service-topline">
            <span class="service-number">{service.number}</span>
            <span class="service-icon" aria-hidden="true"><Icon name={service.icon} size={22} strokeWidth={1.7} /></span>
          </div>
          <div class="service-copy">
            <h3>{service.title}</h3>
            <p>{service.description}</p>
          </div>
          <a class="service-link" href={appointmentUrl} target="_blank" rel="noreferrer" aria-label={`Make an appointment for ${service.title}`}>Make an appointment</a>
        </article>
      ))}
    </div>

    <div class="essential-services" aria-label="24 by 7 essential hospital services">
      <div class="essential-intro"><span>ALSO AVAILABLE</span><strong>24 × 7 Essential Services</strong></div>
      <div class="essential-items">
        {essentialServices.map((service) => (
          <div class="essential-item">
            <span class="essential-icon" aria-hidden="true"><Icon name={service.icon} size={23} strokeWidth={1.7} /></span>
            <span><strong>{service.title}</strong><small>{service.detail}</small></span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
.services-section{padding:clamp(18px,2vw,30px) clamp(12px,2vw,30px) clamp(30px,3.5vw,52px);background:#eef7ff}
.services-shell{width:min(100%,1696px);margin:0 auto;padding:clamp(24px,2.8vw,42px);border:1px solid rgba(49,104,178,.09);border-radius:30px;background:#f8fbff;box-shadow:0 22px 65px rgba(44,91,150,.075);overflow:hidden;position:relative;isolation:isolate}
.services-shell:before,.services-shell:after{content:'';position:absolute;width:280px;height:280px;border:1px solid rgba(40,120,238,.07);clip-path:polygon(25% 3%,75% 3%,100% 50%,75% 97%,25% 97%,0 50%);pointer-events:none;z-index:-1}.services-shell:before{top:-120px;left:-110px}.services-shell:after{right:-120px;bottom:-135px}
.services-header{display:grid;grid-template-columns:minmax(0,1fr) minmax(250px,390px);align-items:end;gap:48px;margin-bottom:clamp(24px,2.6vw,36px);position:relative;z-index:1}
.services-eyebrow{margin:0 0 12px;color:#71809a;font-size:10px;font-weight:700;letter-spacing:.15em;text-transform:uppercase}.services-eyebrow span{color:#9aa8bd;font-weight:500;letter-spacing:0;text-transform:none;margin-left:4px}
.services-header h2{margin:0;max-width:900px;color:#152944;font-family:var(--font-display);font-size:clamp(38px,3.5vw,60px);font-weight:500;line-height:1.16;letter-spacing:-.047em}.services-header h2 strong{color:#1973e8;font-weight:600}
.services-header-side{justify-self:end;max-width:370px;padding-bottom:3px}.services-header-side p{margin:0 0 14px;color:#687991;font-size:12px;line-height:1.55}.services-view-link{color:#2878ee;font-size:10px;font-weight:650;text-decoration:underline;text-underline-offset:3px}
.services-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;position:relative;z-index:1}
.service-card{min-height:224px;padding:17px 18px 16px;display:flex;flex-direction:column;border:1px solid rgba(67,105,156,.10);border-radius:17px;background:rgba(255,255,255,.94);color:#172b4d;box-shadow:0 8px 28px rgba(47,82,129,.045);transition:transform .3s ease,box-shadow .3s ease,background .3s ease,color .3s ease,border-color .3s ease;position:relative;overflow:hidden}.service-card:hover{transform:translateY(-3px);border-color:#2878ee;background:#2878ee;color:#fff;box-shadow:0 20px 42px rgba(40,120,238,.18)}.service-card--featured{background:linear-gradient(145deg,#2878ee 0%,#1767dc 100%);border-color:#2878ee;color:#fff;box-shadow:0 20px 42px rgba(40,120,238,.18)}.service-card--featured:after{content:'';position:absolute;width:150px;height:150px;right:-60px;top:-55px;border:1px solid rgba(255,255,255,.13);border-radius:50%;box-shadow:0 0 0 25px rgba(255,255,255,.035),0 0 0 50px rgba(255,255,255,.025);pointer-events:none}
.service-topline{display:flex;align-items:flex-start;justify-content:space-between;gap:12px}.service-number{color:#cfe0f8;font-family:var(--font-display);font-size:clamp(42px,3.7vw,56px);font-weight:500;letter-spacing:-.08em;line-height:.8}.service-icon{width:42px;height:42px;display:grid;place-items:center;border-radius:50%;background:#edf4ff;color:#2878ee;flex:0 0 auto}.service-card--featured .service-icon,.service-card:hover .service-icon{background:rgba(255,255,255,.16);color:#fff}.service-icon svg{width:22px;height:22px}
.service-copy{margin-top:auto;padding-top:24px;max-width:330px}.service-copy h3{margin:0 0 7px;color:inherit;font-family:var(--font-display);font-size:clamp(18px,1.45vw,23px);font-weight:600;letter-spacing:-.045em;line-height:1.05}.service-copy p{margin:0;color:#687991;font-size:10.5px;line-height:1.48}.service-card--featured .service-copy p,.service-card:hover .service-copy p{color:rgba(255,255,255,.82)}
.service-link{margin-top:18px;align-self:flex-end;color:#2878ee;font-size:9px;font-weight:650;text-decoration:underline;text-underline-offset:3px}.service-card--featured .service-link,.service-card:hover .service-link{color:#fff}
.essential-services{margin-top:10px;display:grid;grid-template-columns:260px minmax(0,1fr);align-items:stretch;border:1px solid rgba(67,105,156,.10);border-radius:17px;background:rgba(255,255,255,.82);box-shadow:0 8px 28px rgba(47,82,129,.035);overflow:hidden;position:relative;z-index:1}.essential-intro{display:flex;flex-direction:column;justify-content:center;padding:17px 22px;border-right:1px solid rgba(67,105,156,.10)}.essential-intro span{color:#8d9cb1;font-size:9px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;margin-bottom:6px}.essential-intro strong{color:#172b4d;font-family:var(--font-display);font-size:19px;font-weight:600;letter-spacing:-.035em;line-height:1.12}.essential-items{display:grid;grid-template-columns:repeat(6,minmax(0,1fr))}.essential-item{min-width:0;display:flex;align-items:center;justify-content:center;gap:10px;padding:12px 10px;border-right:1px solid rgba(67,105,156,.10);color:#2878ee}.essential-item:last-child{border-right:0}.essential-icon{width:32px;height:32px;display:grid;place-items:center;flex:0 0 auto}.essential-item>span:last-child{display:flex;flex-direction:column;min-width:0}.essential-item strong{color:#293750;font-size:11px;font-weight:650;line-height:1.2}.essential-item small{color:#71809a;font-size:9.5px;line-height:1.3;margin-top:3px}
@media(max-width:1000px){.services-header{grid-template-columns:1fr;gap:14px}.services-header-side{justify-self:start;max-width:480px}.services-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.essential-services{grid-template-columns:1fr}.essential-intro{border-right:0;border-bottom:1px solid rgba(67,105,156,.10)}.essential-items{grid-template-columns:repeat(3,minmax(0,1fr))}.essential-item:nth-child(3){border-right:0}.essential-item:nth-child(-n+3){border-bottom:1px solid rgba(67,105,156,.10)}}
@media(max-width:620px){.services-section{padding-inline:8px}.services-shell{padding:23px 14px;border-radius:23px}.services-header{margin-bottom:22px}.services-header h2{font-size:clamp(34px,10vw,48px);line-height:1.1}.services-grid{grid-template-columns:1fr;gap:9px}.service-card{min-height:205px;padding:16px}.service-copy{padding-top:20px}.service-copy h3{font-size:20px}.service-copy p{font-size:11px}.essential-items{grid-template-columns:repeat(2,minmax(0,1fr))}.essential-item:nth-child(3){border-right:1px solid rgba(67,105,156,.10)}.essential-item:nth-child(odd){border-right:1px solid rgba(67,105,156,.10)}.essential-item:nth-child(-n+4){border-bottom:1px solid rgba(67,105,156,.10)}.essential-item:nth-child(5),.essential-item:nth-child(6){border-bottom:0}.essential-intro{padding:15px 17px}.essential-item{justify-content:flex-start;padding:12px 10px}}
@media(prefers-reduced-motion:reduce){.service-card{transition:none}}
</style>
