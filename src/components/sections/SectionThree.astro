---
const appointmentUrl = 'https://wa.me/919591799099';

const services = [
  {
    number: '01',
    title: 'Cardiology',
    description: 'Heart-focused diagnosis and treatment, supported by 2D Echo and TMT facilities.',
  },
  {
    number: '02',
    title: 'Diabetology & General Medicine',
    description: 'Specialist care for diabetes, blood pressure and related medical conditions.',
  },
  {
    number: '03',
    title: 'General Surgery',
    description: 'Surgical care for conditions requiring specialist evaluation and treatment.',
  },
  {
    number: '04',
    title: 'Obstetrics',
    description: 'Specialist obstetric care with experienced medical support for women.',
  },
  {
    number: '05',
    title: 'ENT',
    description: 'Evaluation and treatment for ear, nose and throat conditions.',
  },
  {
    number: '06',
    title: 'Diagnostics & Laboratory',
    description: 'Complete laboratory testing and advanced diagnostic support for accurate evaluation.',
  },
];
---

<section id="services" class="services-section" aria-labelledby="services-title">
  <div class="services-shell">
    <header class="services-header">
      <div>
        <p class="services-eyebrow">OUR MEDICAL SERVICES <span>(What you get)</span></p>
        <h2 id="services-title">Care that covers <strong>what matters most.</strong></h2>
      </div>
      <p class="services-intro">
        Specialist care, diagnostics and essential hospital services — under one roof.
      </p>
    </header>

    <div class="services-grid">
      {services.map((service) => (
        <article class="service-card">
          <div class="service-number">{service.number}</div>
          <div class="service-copy">
            <h3>{service.title}</h3>
            <p>{service.description}</p>
          </div>
          <a class="service-link" href={appointmentUrl} target="_blank" rel="noreferrer" aria-label={`Make an appointment for ${service.title}`}>
            <span>Make an appointment</span>
            <span class="service-arrow" aria-hidden="true">↗</span>
          </a>
        </article>
      ))}
    </div>

    <div class="services-footer">
      <span>24×7 emergency · laboratory · pharmacy · ambulance · digital X-ray · 2D Echo · TMT</span>
      <a href={appointmentUrl} target="_blank" rel="noreferrer">Book an appointment ↗</a>
    </div>
  </div>
</section>

<style>
  .services-section {
    padding: clamp(20px, 2.2vw, 34px) clamp(16px, 2.4vw, 38px) clamp(34px, 4vw, 58px);
    background: #eef4ff;
  }

  .services-shell {
    width: min(100%, 1696px);
    margin: 0 auto;
    padding: clamp(28px, 3vw, 46px);
    border-radius: 30px;
    background: #f8fbff;
    border: 1px solid rgba(88, 137, 215, 0.1);
    box-shadow: 0 22px 65px rgba(44, 91, 150, 0.08);
    overflow: hidden;
    position: relative;
  }

  .services-shell::before,
  .services-shell::after {
    content: '';
    position: absolute;
    width: 260px;
    height: 260px;
    border: 1px solid rgba(52, 116, 226, 0.08);
    clip-path: polygon(25% 3%, 75% 3%, 100% 50%, 75% 97%, 25% 97%, 0 50%);
    pointer-events: none;
  }

  .services-shell::before { top: -105px; left: -105px; }
  .services-shell::after { right: -105px; bottom: -120px; }

  .services-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(250px, 360px);
    align-items: end;
    gap: 40px;
    margin-bottom: clamp(24px, 3vw, 38px);
    position: relative;
    z-index: 1;
  }

  .services-eyebrow {
    margin: 0 0 10px;
    color: #71809a;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .14em;
  }

  .services-eyebrow span {
    color: #9aa8bd;
    font-weight: 500;
    letter-spacing: 0;
    margin-left: 5px;
  }

  .services-header h2 {
    margin: 0;
    max-width: 780px;
    color: #172b4d;
    font-family: var(--font-display);
    font-size: clamp(32px, 4.2vw, 62px);
    font-weight: 500;
    letter-spacing: -.055em;
    line-height: .98;
  }

  .services-header h2 strong {
    color: #2374eb;
    font-weight: 600;
  }

  .services-intro {
    margin: 0 0 2px;
    color: #687991;
    font-size: 13px;
    line-height: 1.6;
    max-width: 330px;
    justify-self: end;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    position: relative;
    z-index: 1;
  }

  .service-card {
    min-height: 245px;
    padding: 18px 19px 17px;
    display: flex;
    flex-direction: column;
    border: 1px solid rgba(67, 105, 156, .11);
    border-radius: 17px;
    background: #fff;
    color: #172b4d;
    box-shadow: 0 10px 30px rgba(47, 82, 129, .055);
    transition: background .3s ease, color .3s ease, border-color .3s ease, transform .3s ease, box-shadow .3s ease;
  }

  .service-card:hover {
    background: #2878ee;
    color: #fff;
    border-color: #2878ee;
    transform: translateY(-4px);
    box-shadow: 0 22px 45px rgba(40, 120, 238, .2);
  }

  .service-number {
    color: #dbe6f8;
    font-family: var(--font-display);
    font-size: clamp(42px, 4vw, 58px);
    font-weight: 500;
    letter-spacing: -.08em;
    line-height: .85;
    transition: color .3s ease;
  }

  .service-card:hover .service-number { color: rgba(255,255,255,.34); }

  .service-copy { margin-top: auto; padding-top: 22px; }

  .service-copy h3 {
    margin: 0 0 8px;
    color: inherit;
    font-family: var(--font-display);
    font-size: clamp(19px, 1.55vw, 25px);
    font-weight: 600;
    letter-spacing: -.045em;
    line-height: 1.05;
  }

  .service-copy p {
    margin: 0;
    max-width: 310px;
    color: #687991;
    font-size: 11px;
    line-height: 1.5;
    transition: color .3s ease;
  }

  .service-card:hover .service-copy p { color: rgba(255,255,255,.82); }

  .service-link {
    margin-top: 18px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    color: #2878ee;
    font-size: 10px;
    font-weight: 600;
    transition: color .3s ease;
  }

  .service-card:hover .service-link { color: #fff; }

  .service-arrow {
    display: inline-grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border: 1px solid currentColor;
    border-radius: 50%;
    font-size: 13px;
    transition: transform .3s ease, background .3s ease, color .3s ease;
  }

  .service-card:hover .service-arrow {
    transform: translate(2px, -2px);
    background: #fff;
    color: #2878ee;
  }

  .services-footer {
    margin-top: 14px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    position: relative;
    z-index: 1;
    color: #71809a;
    font-size: 10px;
  }

  .services-footer a {
    color: #2878ee;
    font-weight: 600;
    white-space: nowrap;
  }

  @media (max-width: 900px) {
    .services-header { grid-template-columns: 1fr; gap: 14px; }
    .services-intro { justify-self: start; }
    .services-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 620px) {
    .services-shell { padding: 24px 16px; border-radius: 23px; }
    .services-grid { grid-template-columns: 1fr; gap: 10px; }
    .service-card { min-height: 220px; }
    .services-footer { align-items: flex-start; flex-direction: column; gap: 10px; }
    .services-footer span { line-height: 1.5; }
  }

  @media (hover: none) {
    .service-card:active {
      background: #2878ee;
      color: #fff;
    }
    .service-card:active .service-number { color: rgba(255,255,255,.34); }
    .service-card:active .service-copy p,
    .service-card:active .service-link { color: rgba(255,255,255,.82); }
  }
</style>
