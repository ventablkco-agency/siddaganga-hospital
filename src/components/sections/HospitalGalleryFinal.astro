---
const items = [
  { src:'/assets/gallery/01-entrance.webp', alt:'Modern Siddaganga Hospital entrance', title:'Main entrance', subtitle:'A welcoming first impression' },
  { src:'/assets/gallery/02-entrance-side.webp', alt:'Siddaganga Hospital exterior from the side', title:'Hospital exterior', subtitle:'Built for better health' },
  { src:'/assets/gallery/03-entrance-wide.webp', alt:'Wide view of Siddaganga Hospital entrance', title:'Siddaganga', subtitle:'A place for better care' },
  { src:'/assets/gallery/04-reception.webp', alt:'Siddaganga Hospital reception lobby', title:'Reception', subtitle:'Care starts here' },
  { src:'/assets/gallery/05-reception-detail.webp', alt:'Modern Siddaganga Hospital reception area', title:'Patient experience', subtitle:'Calm. Clear. Considered.' },
  { src:'/assets/gallery/06-patient-room.webp', alt:'Bright modern Siddaganga Hospital patient room', title:'Patient rooms', subtitle:'Comfort built into care' },
  { src:'/assets/gallery/07-emergency.webp', alt:'Modern Siddaganga Hospital emergency ward', title:'Emergency care', subtitle:'Ready when it matters' },
  { src:'/assets/gallery/08-ambulance.webp', alt:'Siddaganga Hospital entrance with ambulance', title:'Ambulance', subtitle:'Care beyond the doors' },
  { src:'/assets/gallery/09-imaging.webp', alt:'Modern hospital imaging suite', title:'Imaging', subtitle:'Technology with precision' },
  { src:'/assets/gallery/10-laboratory.webp', alt:'Modern clinical laboratory at Siddaganga Hospital', title:'Laboratory', subtitle:'Accurate diagnosis, better decisions' },
];
const count = items.length;
const cardWidth = 320;
const cardHeight = 240;
const gap = 28;
const radius = 540;
---

<section class="gallery-section" id="gallery" aria-labelledby="gallery-title">
  <div class="gallery-inner">
    <div class="gallery-heading">
      <p class="gallery-eyebrow">{`{ Inside Siddaganga }`}</p>
      <h2 id="gallery-title">A closer look<br /><strong>at care.</strong></h2>
      <p class="gallery-description">Step inside our spaces, people, and details<br class="desktop-break" /> that make every visit feel considered.</p>
    </div>

    <div class="panorama" data-panorama tabindex="0" role="region" aria-roledescription="carousel" aria-label="Siddaganga Hospital gallery">
      <div class="panorama-viewport">
        <div class="panorama-world">
          <div class="panorama-ring">
            {items.map((item, index) => (
              <article class="panorama-card" data-index={index}>
                <button class="panorama-card-button" type="button" aria-label={`Focus ${item.title}`}>
                  <span class="panorama-frame">
                    <img src={item.src} alt={item.alt} loading={index < 4 ? 'eager' : 'lazy'} decoding="async" draggable="false" />
                  </span>
                </button>
              </article>
            ))}
          </div>
        </div>
      </div>

      <p class="panorama-hint">DRAG TO EXPLORE · CLICK A FRAME TO FOCUS</p>

      <div class="gallery-caption" aria-live="polite">
        <span class="gallery-caption__title" data-title>{items[0].title}</span>
        <span class="gallery-caption__subtitle" data-subtitle>{items[0].subtitle}</span>
        <span class="gallery-caption__count"><span data-current>01</span><i>/</i>{String(count).padStart(2,'0')}</span>
      </div>

      <div class="gallery-controls" aria-label="Gallery controls">
        <button type="button" data-prev aria-label="Previous gallery image">←</button>
        <button type="button" data-next aria-label="Next gallery image">→</button>
      </div>
    </div>

    <div class="gallery-meta" aria-hidden="true">
      <span>SGH / 01</span>
      <span>SPACES · PEOPLE · CARE</span>
    </div>
  </div>
</section>

<script>
  const initPanorama = () => {
    const root = document.querySelector('[data-panorama]');
    if (!root || root.dataset.readyInit) return;
    root.dataset.readyInit = 'true';

    const ring = root.querySelector('.panorama-ring');
    const cards = [...root.querySelectorAll('.panorama-card')];
    const title = root.querySelector('[data-title]');
    const subtitle = root.querySelector('[data-subtitle]');
    const current = root.querySelector('[data-current]');
    const step = 360 / cards.length;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const state = { angle: 0, target: null, velocity: 0, active: 0, dragging: false, pointerId: null, startX: 0, startAngle: 0, lastX: 0, lastTime: 0, hover: false, raf: 0, lastFrame: 0 };

    const wrap = value => ((value + 180) % 360 + 360) % 360 - 180;
    const focus = index => {
      const desired = -index * step;
      state.target = desired + 360 * Math.round((state.angle - desired) / 360);
      wake();
    };

    const render = () => {
      ring.style.transform = `rotateY(${state.angle}deg)`;
      const active = ((Math.round(-state.angle / step) % cards.length) + cards.length) % cards.length;
      if (active !== state.active) {
        state.active = active;
        current.textContent = String(active + 1).padStart(2, '0');
        title.textContent = cards[active].querySelector('img').alt.replace(/^Modern |^Bright |^Wide view of |^Siddaganga Hospital /, '').replace(/ entrance.*$/i, ' entrance');
        const subtitles = [
          'A welcoming first impression','Built for better health','A place for better care','Care starts here','Calm. Clear. Considered.',
          'Comfort built into care','Ready when it matters','Care beyond the doors','Technology with precision','Accurate diagnosis, better decisions'
        ];
        subtitle.textContent = subtitles[active];
      }
    };

    const tick = now => {
      state.raf = 0;
      const dt = state.lastFrame ? Math.min((now - state.lastFrame) / 1000, 0.05) : 1 / 60;
      state.lastFrame = now;

      if (state.target !== null) {
        const difference = state.target - state.angle;
        state.velocity += (difference * 95 - state.velocity * 16) * dt;
        state.angle += state.velocity * dt;
        if (Math.abs(difference) < 0.05 && Math.abs(state.velocity) < 0.08) {
          state.angle = state.target;
          state.target = null;
          state.velocity = 0;
        }
      } else if (!state.dragging && !state.hover && !reduced) {
        state.angle -= 3.2 * dt;
      } else if (!state.dragging) {
        state.velocity *= Math.exp(-8 * dt);
        state.angle += state.velocity * dt;
      }

      render();
      if (state.target !== null || state.dragging || (!state.hover && !reduced)) wake();
      else state.lastFrame = 0;
    };

    const wake = () => {
      if (!state.raf) state.raf = requestAnimationFrame(tick);
    };

    root.addEventListener('mouseenter', () => { state.hover = true; });
    root.addEventListener('mouseleave', () => { state.hover = false; wake(); });

    root.addEventListener('pointerdown', event => {
      if (event.button !== 0) return;
      state.dragging = true;
      state.pointerId = event.pointerId;
      state.startX = event.clientX;
      state.lastX = event.clientX;
      state.startAngle = state.angle;
      state.lastTime = performance.now();
      state.target = null;
      root.setPointerCapture(event.pointerId);
      wake();
    });

    root.addEventListener('pointermove', event => {
      if (!state.dragging || event.pointerId !== state.pointerId) return;
      const now = performance.now();
      const dx = event.clientX - state.startX;
      const scale = 180 / (Math.PI * radius);
      state.angle = state.startAngle + dx * scale;
      state.velocity = (event.clientX - state.lastX) * scale / Math.max((now - state.lastTime) / 1000, 0.016);
      state.lastX = event.clientX;
      state.lastTime = now;
      render();
    });

    const release = event => {
      if (!state.dragging || event.pointerId !== state.pointerId) return;
      state.dragging = false;
      state.pointerId = null;
      state.target = Math.round((state.angle + state.velocity * 0.08) / step) * step;
      wake();
    };

    root.addEventListener('pointerup', release);
    root.addEventListener('pointercancel', release);

    cards.forEach((card, index) => {
      card.querySelector('button').addEventListener('click', event => {
        event.stopPropagation();
        if (Math.abs(state.velocity) > 0.5) return;
        focus(index);
      });
    });

    root.querySelector('[data-prev]').addEventListener('click', () => focus((state.active - 1 + cards.length) % cards.length));
    root.querySelector('[data-next]').addEventListener('click', () => focus((state.active + 1) % cards.length));

    root.addEventListener('keydown', event => {
      if (event.key === 'ArrowLeft') { event.preventDefault(); focus((state.active - 1 + cards.length) % cards.length); }
      if (event.key === 'ArrowRight') { event.preventDefault(); focus((state.active + 1) % cards.length); }
    });

    render();
    wake();
  };

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initPanorama, { once: true });
  else initPanorama();
</script>

<style>
  .gallery-section{--ink:#111a2b;--muted:#74839a;width:100%;height:100svh;min-height:680px;overflow:hidden;background:#edf2ff;color:var(--ink);font-family:var(--font-body)}
  .gallery-inner{position:relative;width:100%;height:100%;overflow:hidden;border-radius:24px;box-sizing:border-box}
  .gallery-heading{position:absolute;left:5.5%;top:12%;z-index:30}
  .gallery-eyebrow{margin:0 0 15px;color:#8ca0bb;font-size:11px;letter-spacing:.03em}
  .gallery-heading h2{margin:0;font-family:var(--font-display);font-size:clamp(38px,4.4vw,66px);line-height:.9;letter-spacing:-.065em;font-weight:400}
  .gallery-heading h2 strong{font-weight:700}
  .gallery-description{margin:22px 0 0;color:var(--muted);font-size:12px;line-height:1.45}

  .panorama{position:absolute;inset:4% 2.5% 5% 27%;overflow:hidden;outline:none;touch-action:pan-y;user-select:none;-webkit-user-select:none}
  .panorama-viewport{position:absolute;inset:7% 0 22%;display:flex;align-items:center;justify-content:center;perspective:1050px;perspective-origin:50% 50%;overflow:hidden}
  .panorama-world{position:relative;width:0;height:0;transform-style:preserve-3d}
  .panorama-ring{position:relative;width:0;height:0;transform-style:preserve-3d;will-change:transform}
  .panorama-card{position:absolute;left:-160px;top:-120px;width:320px;height:240px;transform:rotateY(0deg) translateZ(540px);transform-style:preserve-3d;backface-visibility:hidden;-webkit-backface-visibility:hidden}
  .panorama-card-button{display:block;width:100%;height:100%;padding:0;border:0;background:none;cursor:pointer;transform-style:preserve-3d}
  .panorama-frame{display:block;width:320px;height:240px;overflow:hidden;border-radius:16px;background:#dbe8f7;box-shadow:0 24px 70px rgba(26,57,100,.15);backface-visibility:hidden;-webkit-backface-visibility:hidden}
  .panorama-frame img{display:block;width:100%;height:100%;object-fit:cover;object-position:center;border:0;pointer-events:none;user-select:none;-webkit-user-drag:none}
  .panorama-frame::after{content:"";position:absolute;inset:0;border:1px solid rgba(255,255,255,.48);border-radius:16px;pointer-events:none}
  .panorama-hint{position:absolute;right:4%;top:7%;margin:0;color:#91a2ba;font-size:10px;letter-spacing:.08em;z-index:10}
  .gallery-caption{position:absolute;left:50%;bottom:6%;transform:translateX(-50%);display:flex;flex-direction:column;align-items:center;gap:7px;z-index:20;white-space:nowrap}
  .gallery-caption__title{font-size:22px;letter-spacing:-.04em;color:#111a2b}
  .gallery-caption__subtitle{font-size:11px;color:#8a9ab0}
  .gallery-caption__count{font-size:10px;color:#9aa9bd;letter-spacing:.1em}
  .gallery-caption__count i{font-style:normal;margin:0 7px}
  .gallery-controls{position:absolute;right:7%;bottom:5.5%;display:flex;gap:12px;z-index:30}
  .gallery-controls button{width:40px;height:40px;border-radius:50%;border:1px solid #2878ed;background:transparent;color:#2878ed;font-size:18px;line-height:1;cursor:pointer;display:grid;place-items:center}
  .gallery-controls button:last-child{background:#2878ed;color:#fff}
  .gallery-meta{position:absolute;left:5.5%;right:5.5%;bottom:5.5%;display:flex;justify-content:space-between;color:#a0aec0;font-size:9px;letter-spacing:.12em;z-index:20}

  @media(max-width:900px){
    .gallery-section{min-height:760px}
    .gallery-heading{left:7%;top:8%}
    .panorama{inset:25% 3% 8% 3%}
    .panorama-hint{top:2%;right:4%}
    .panorama-viewport{inset:5% 0 25%;perspective:850px}
    .panorama-card{left:-135px;top:-101px;width:270px;height:202px}
    .panorama-frame{width:270px;height:202px}
    .gallery-caption{bottom:7%}
    .gallery-meta{left:7%;right:7%}
  }

  @media(max-width:600px){
    .gallery-heading h2{font-size:48px}
    .gallery-description{font-size:11px}
    .panorama{inset:26% 0 7% 0}
    .panorama-viewport{perspective:700px}
    .panorama-card{left:-115px;top:-86px;width:230px;height:172px}
    .panorama-frame{width:230px;height:172px;border-radius:13px}
    .gallery-caption__title{font-size:18px}
    .gallery-controls{right:7%;bottom:4%}
    .gallery-controls button{width:36px;height:36px}
  }
</style>
