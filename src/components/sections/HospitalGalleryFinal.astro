const items = [
  { src:'https://images.unsplash.com/photo-1519494026892-80bbd2d6fd0d?w=1200&q=82&auto=format&fit=crop', alt:'Bright hospital corridor with clean modern interiors', title:'Care spaces', subtitle:'Designed around comfort' },
  { src:'https://images.unsplash.com/photo-1538108149393-fbbd81895907?w=1200&q=82&auto=format&fit=crop', alt:'Modern hospital room prepared for patient care', title:'Patient rooms', subtitle:'Calm. Clean. Considered.' },
  { src:'https://images.unsplash.com/photo-1576091160399-112ba8d25d1d?w=1200&q=82&auto=format&fit=crop', alt:'Healthcare professional working in a clinical setting', title:'Clinical care', subtitle:'Experience meets precision' },
  { src:'https://images.unsplash.com/photo-1584982751601-97dcc096659c?w=1200&q=82&auto=format&fit=crop', alt:'Medical team preparing for clinical work', title:'Our team', subtitle:'People behind the care' },
  { src:'https://images.unsplash.com/photo-1586773860418-d37222d8fce3?w=1200&q=82&auto=format&fit=crop', alt:'Contemporary hospital exterior', title:'Siddaganga', subtitle:'A place for better health' },
  { src:'https://images.unsplash.com/photo-1559757175-0eb30cd8c063?w=1200&q=82&auto=format&fit=crop', alt:'Doctor consulting with a patient', title:'Consultation', subtitle:'Listening comes first' },
  { src:'https://images.unsplash.com/photo-1516841273335-e39b37888115?w=1200&q=82&auto=format&fit=crop', alt:'Hospital treatment environment', title:'Technology', subtitle:'Built for better decisions' },
  { src:'https://images.unsplash.com/photo-1505751172876-fa1923c5c528?w=1200&q=82&auto=format&fit=crop', alt:'Healthcare equipment in a clinical environment', title:'Precision', subtitle:'Every detail matters' },
  { src:'https://images.unsplash.com/photo-1580281658628-3c5b7c0a4c8a?w=1200&q=82&auto=format&fit=crop', alt:'Healthcare professional in a hospital', title:'Expertise', subtitle:'Care with confidence' },
  { src:'https://images.unsplash.com/photo-1511174511562-5f7f18b874f8?w=1200&q=82&auto=format&fit=crop', alt:'Modern clinical equipment', title:'Inside SGH', subtitle:'A closer look' },
];
const cardWidth=210, cardHeight=269.23077, gap=14, count=items.length;
const pitch=cardWidth+gap, chord=pitch/(2*Math.sin(Math.PI/count)), arc=(count*pitch)/(2*Math.PI), radius=Math.max(chord+(arc-chord),cardWidth*.6);
const tileCount=8, tileLength=cardWidth/tileCount;
const tiles=Array.from({length:tileCount},(_,i)=>{const start=i*tileLength-(i?1.25:0),end=(i+1)*tileLength+(i<tileCount-1?1.25:0),size=end-start,center=(start+end)/2-cardWidth/2,alpha=center/radius;return{i,size,move:`translate3d(${radius*Math.sin(alpha)}px,0,${radius*(1-Math.cos(alpha))}px) rotateY(${alpha*180/Math.PI}deg)`}});
---

<section class="gallery-section" id="gallery" aria-labelledby="gallery-title">
  <div class="gallery-inner">
    <div class="gallery-heading">
      <p class="gallery-eyebrow">{`{ Inside Siddaganga }`}</p>
      <h2 id="gallery-title">A closer look<br /><strong>at care.</strong></h2>
      <p class="gallery-description">Step inside our spaces, people, and details<br class="desktop-break" /> that make every visit feel considered.</p>
    </div>

    <div class="circular-carousel" data-gallery-carousel data-radius={radius} role="region" aria-roledescription="carousel" aria-label="Siddaganga Hospital gallery" tabindex="0">
      <div class="carousel-view"><div class="carousel-stage"><div class="carousel-camera"><div class="carousel-ring">
        {items.map((item,index)=><div class="carousel-card" data-card-index={index} role="group" aria-roledescription="slide" aria-label={`${item.title}, ${index+1} of ${count}`}>
          {tiles.map(tile=><div class="carousel-tile" style={`left:${-tile.size/2}px;top:${-cardHeight/2}px;width:${tile.size}px;height:${cardHeight}px;transform:${tile.move}`} aria-hidden="true">
            <div class="carousel-frame" style={`height:${cardHeight}px;border-radius:${tile.i===0?'14px 0 0 14px':tile.i===tileCount-1?'0 14px 14px 0':'0'}`}>
              <img src={item.src} alt="" loading="lazy" decoding="async" draggable="false" />
              <span class="carousel-shade"></span>
            </div>
          </div>)}
        </div>)}
      </div></div></div></div>

      <div class="gallery-caption" aria-live="polite"><span class="gallery-caption__title" data-title>{items[0].title}</span><span class="gallery-caption__subtitle" data-subtitle>{items[0].subtitle}</span><span class="gallery-caption__count"><span data-current>01</span><i>/</i>{String(count).padStart(2,'0')}</span></div>
      <div class="gallery-controls" aria-label="Gallery controls"><button type="button" data-prev aria-label="Previous gallery image">←</button><button type="button" data-next aria-label="Next gallery image">→</button></div>
      <p class="gallery-hint">Drag to explore · Click a frame to focus</p>
    </div>
    <div class="gallery-meta" aria-hidden="true"><span>SGH / 01</span><span>Spaces · People · Care</span></div>
  </div>
</section>

<script>
  const initGallery=()=>{
    const root=document.querySelector('[data-gallery-carousel]'); if(!root||root.dataset.initialized)return; root.dataset.initialized='true';
    const cards=[...root.querySelectorAll('[data-card-index]')], ring=root.querySelector('.carousel-ring'), stage=root.querySelector('.carousel-stage'), camera=root.querySelector('.carousel-camera');
    const current=root.querySelector('[data-current]'), title=root.querySelector('[data-title]'), subtitle=root.querySelector('[data-subtitle]'), radius=Number(root.dataset.radius), step=360/cards.length;
    const data=[['Care spaces','Designed around comfort'],['Patient rooms','Calm. Clean. Considered.'],['Clinical care','Experience meets precision'],['Our team','People behind the care'],['Siddaganga','A place for better health'],['Consultation','Listening comes first'],['Technology','Built for better decisions'],['Precision','Every detail matters'],['Expertise','Care with confidence'],['Inside SGH','A closer look']];
    const reduce=window.matchMedia?.('(prefers-reduced-motion: reduce)').matches??false;
    const state={angle:0,velocity:0,target:null,hover:false,drag:false,press:null,last:0,raf:0,active:0,fit:1,pointer:{inside:false,x:0,y:0},hold:0};
    const clamp=(v,a,b)=>Math.min(b,Math.max(a,v)),wrap=v=>(((v+180)%360)+360)%360-180;
    const wake=()=>{if(!state.raf&&!document.hidden)state.raf=requestAnimationFrame(frame)};
    const measure=()=>{const r=root.getBoundingClientRect();if(!r.width||!r.height)return;state.fit=Math.min(1,(r.height*.9)/269.23077);stage.style.perspective=`${radius}px`;stage.style.transform=`translate3d(0,0,0) scale(${state.fit})`};
    const render=()=>{const yaw=state.pointer.inside?state.pointer.x*.21*9:0,pitch=state.pointer.inside?-state.pointer.y*.21*6:0;camera.style.transform=`translate3d(0,0,${radius-1}px) rotateX(${pitch}deg) rotateY(${yaw}deg)`;ring.style.transform=`rotateY(${state.angle}deg)`;cards.forEach((card,i)=>{const base=i*step,facing=Math.cos(wrap(base+state.angle)*Math.PI/180);card.style.transform=`rotateY(${base}deg) translateZ(${-radius}px)`;card.style.setProperty('--depth',(0.55*Math.pow((1-facing)/2,1.25)).toFixed(3));card.style.zIndex=String(Math.round((1+facing)*100))});const active=((Math.round(-state.angle/step)%cards.length)+cards.length)%cards.length;if(active!==state.active){state.active=active;current.textContent=String(active+1).padStart(2,'0');title.textContent=data[active][0];subtitle.textContent=data[active][1]}root.dataset.ready=''};
    const focus=i=>{const target=-i*step;state.target=target+360*Math.round((state.angle-target)/360);state.hold=performance.now()+2800;wake()},stepBy=d=>focus((state.active+d+cards.length)%cards.length);
    const advance=(dt,now)=>{const paused=state.hover||state.drag||now<state.hold;if(state.target!==null){const damping=2*Math.sqrt(118);state.velocity+=(118*(state.target-state.angle)-damping*state.velocity)*dt;state.angle+=state.velocity*dt;if(Math.abs(state.target-state.angle)<.004&&Math.abs(state.velocity)<.03){state.angle=state.target;state.velocity=0;state.target=null}return true}if(!paused&&!reduce){const cruise=-14,tau=1.68;state.velocity+=(cruise-state.velocity)*(1-Math.exp(-dt/tau));state.angle+=state.velocity*dt;return true}return Math.abs(state.velocity)>.01};
    const frame=now=>{state.raf=0;const dt=state.last?Math.min((now-state.last)/1000,.05):1/60;state.last=now;const busy=advance(dt,now);render();if(busy&&!document.hidden)state.raf=requestAnimationFrame(frame);else state.last=0};
    const updatePointer=e=>{const r=root.getBoundingClientRect();state.pointer.x=clamp(((e.clientX-r.left)/r.width)*2-1,-1,1);state.pointer.y=clamp(((e.clientY-r.top)/r.height)*2-1,-1,1)};
    root.addEventListener('pointerdown',e=>{if(e.button===0)state.press={id:e.pointerId,x:e.clientX,angle:state.angle,moved:false}});
    root.addEventListener('pointermove',e=>{if(e.pointerType==='mouse'){state.pointer.inside=true;updatePointer(e)}const p=state.press;if(!p||p.id!==e.pointerId)return wake();const dx=e.clientX-p.x;if(!p.moved){if(Math.abs(dx)<5)return;p.moved=true;state.drag=true;state.target=null;try{root.setPointerCapture(e.pointerId)}catch{}}state.angle=p.angle-dx*(180/(Math.PI*radius*state.fit));wake()});
    root.addEventListener('pointerup',e=>{const p=state.press;if(!p||p.id!==e.pointerId)return;state.press=null;if(!p.moved)return;state.drag=false;state.target=Math.round(state.angle/step)*step;state.hold=performance.now()+1800;wake()});
    root.addEventListener('pointercancel',()=>{state.press=null;state.drag=false});
    root.addEventListener('pointerenter',e=>{if(e.pointerType==='mouse')state.hover=true}); root.addEventListener('pointerleave',e=>{if(e.pointerType==='mouse'){state.hover=false;state.pointer.inside=false;wake()}});
    root.addEventListener('click',e=>{const card=e.target.closest('[data-card-index]');if(card&&!state.drag)focus(Number(card.dataset.cardIndex))});
    root.addEventListener('keydown',e=>{if(e.key==='ArrowRight')stepBy(1);else if(e.key==='ArrowLeft')stepBy(-1);else if(e.key==='Home')focus(0);else if(e.key==='End')focus(cards.length-1);else return;e.preventDefault()});
    root.querySelector('[data-prev]')?.addEventListener('click',()=>stepBy(-1)); root.querySelector('[data-next]')?.addEventListener('click',()=>stepBy(1));
    new ResizeObserver(()=>{measure();wake()}).observe(root); new IntersectionObserver(([entry])=>{if(entry.isIntersecting)wake();else{cancelAnimationFrame(state.raf);state.raf=0;state.last=0}}).observe(root);
    measure();render();wake();
  };
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',initGallery,{once:true});else initGallery();
</script>

<style>
  .gallery-section{--blue:#2878ed;--ink:#111a2b;--muted:#74839a;width:100%;height:100svh;min-height:680px;overflow:hidden;background:#edf2ff;color:var(--ink);font-family:var(--font-body)}
  .gallery-inner{position:relative;width:100%;height:100%;overflow:hidden;border-radius:24px;box-sizing:border-box}.gallery-heading{position:absolute;left:5.5%;top:12%;z-index:20}.gallery-eyebrow{margin:0 0 15px;color:#8ca0bb;font-size:11px;letter-spacing:.03em}.gallery-heading h2{margin:0;font-family:var(--font-display);font-size:clamp(38px,4.4vw,66px);line-height:.9;letter-spacing:-.065em;font-weight:400}.gallery-heading h2 strong{font-weight:700}.gallery-description{margin:22px 0 0;color:var(--muted);font-size:12px;line-height:1.45}
  .circular-carousel{position:absolute;inset:4% 2.5% 5% 27%;overflow:hidden;outline:none;touch-action:pan-y;user-select:none;-webkit-user-select:none;cursor:grab}.circular-carousel:focus-visible{box-shadow:inset 0 0 0 2px rgba(40,120,237,.35);border-radius:24px}.carousel-view{position:absolute;inset:0}.carousel-stage{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;opacity:0;transition:opacity .45s ease}.circular-carousel[data-ready] .carousel-stage{opacity:1}.carousel-camera,.carousel-ring,.carousel-card{width:0;height:0;transform-style:preserve-3d}.carousel-camera{position:relative}.carousel-ring,.carousel-card{position:absolute;left:0;top:0}.carousel-tile{position:absolute;backface-visibility:hidden;-webkit-backface-visibility:hidden}.carousel-frame{position:absolute;left:0;top:0;width:100%;overflow:hidden;background:#dceaff}.carousel-frame img{position:absolute;left:0;top:0;width:210px;height:269.23077px;max-width:none;object-fit:cover;display:block;pointer-events:none;user-select:none;-webkit-user-drag:none}.carousel-shade{position:absolute;inset:0;background:#edf2ff;opacity:var(--depth,0);pointer-events:none;transition:opacity .18s ease}
  .gallery-caption{position:absolute;left:50%;bottom:10%;transform:translateX(-50%);z-index:30;display:grid;justify-items:center;gap:4px;min-width:170px;text-align:center;pointer-events:none}.gallery-caption__title{font-family:var(--font-display);font-size:18px;font-weight:600;letter-spacing:-.035em}.gallery-caption__subtitle{color:#8190a6;font-size:9px}.gallery-caption__count{display:inline-flex;gap:5px;margin-top:5px;color:#9aa7ba;font-size:9px;letter-spacing:.08em}.gallery-caption__count i{font-style:normal;opacity:.55}.gallery-controls{position:absolute;right:6%;bottom:10%;z-index:40;display:flex;gap:10px}.gallery-controls button{width:34px;height:34px;padding:0;border-radius:50%;border:1px solid var(--blue);display:grid;place-items:center;cursor:pointer;font:inherit;font-size:15px}.gallery-controls button:first-child{background:transparent;color:var(--blue)}.gallery-controls button:last-child{background:var(--blue);color:#fff}.gallery-hint{position:absolute;right:5.8%;top:12%;margin:0;color:#9aa8bb;font-size:9px;letter-spacing:.08em;text-transform:uppercase}.gallery-meta{position:absolute;left:5.5%;right:5.5%;bottom:4.5%;display:flex;justify-content:space-between;color:#a5b1c2;font-size:8px;letter-spacing:.12em;text-transform:uppercase}
  @media(max-width:900px){.gallery-heading{top:9%;left:5%}.gallery-heading h2{font-size:clamp(36px,5.4vw,54px)}.circular-carousel{inset:5% 0 7% 24%}.gallery-hint{right:5%;top:9%}}
  @media(max-width:640px){.gallery-section{min-height:700px}.gallery-inner{border-radius:0}.gallery-heading{top:8%;left:6%}.gallery-heading h2{font-size:clamp(39px,12vw,58px)}.gallery-description{margin-top:15px;font-size:11px}.circular-carousel{inset:26% -8% 16% -8%}.gallery-caption{bottom:10%}.gallery-controls{left:50%;right:auto;bottom:4.5%;transform:translateX(-50%)}.gallery-hint{left:6%;right:auto;top:23%}.gallery-meta{left:6%;right:6%;bottom:1.7%}}
  @media(prefers-reduced-motion:reduce){.carousel-stage,.carousel-shade,.gallery-controls button{transition:none}}
</style>
