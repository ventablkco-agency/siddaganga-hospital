---
interface Props {
  href?: string;
  label?: string;
  newTab?: boolean;
  variant?: 'dark' | 'blue' | 'light';
}

const {
  href = '#',
  label = 'Book Appointment',
  newTab = false,
  variant = 'dark',
} = Astro.props;
---

<a
  class={`icon-slide-button icon-slide-button--${variant}`}
  href={href}
  target={newTab ? '_blank' : undefined}
  rel={newTab ? 'noopener noreferrer' : undefined}
  aria-label={label}
>
  <span class="icon-slide-button__fill" aria-hidden="true"></span>
  <span class="icon-slide-button__label">{label}</span>
  <span class="icon-slide-button__icon" aria-hidden="true">
    <svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M3 8H12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
      <path d="M8.5 4.5L12 8L8.5 11.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </span>
</a>

<style>
  .icon-slide-button {
    --button-bg: #0d1015;
    --button-hover: #1769d1;
    --button-text: #ffffff;
    --button-icon: #0d1015;
    --button-icon-bg: #ffffff;

    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 8px 0 23px;
    overflow: hidden;
    border-radius: 999px;
    background: var(--button-bg);
    color: var(--button-text);
    text-decoration: none;
    box-shadow: 0 13px 28px rgba(17, 19, 23, .13);
    isolation: isolate;
    transition: transform .4s cubic-bezier(.44, 0, .56, 1), box-shadow .4s cubic-bezier(.44, 0, .56, 1);
  }

  .icon-slide-button--blue {
    --button-bg: #1769d1;
    --button-hover: #0d1015;
  }

  .icon-slide-button--light {
    --button-bg: #ffffff;
    --button-hover: #1769d1;
    --button-text: #10151c;
    --button-icon: #ffffff;
    --button-icon-bg: #10151c;
  }

  .icon-slide-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 17px 34px rgba(17, 19, 23, .17);
  }

  .icon-slide-button:active {
    transform: scale(.97);
  }

  .icon-slide-button__fill {
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: var(--button-hover);
    transform: scale(0);
    transform-origin: center;
    opacity: 0;
    transition: transform .4s cubic-bezier(.44, 0, .56, 1), opacity .4s cubic-bezier(.44, 0, .56, 1);
  }

  .icon-slide-button:hover .icon-slide-button__fill,
  .icon-slide-button:focus-visible .icon-slide-button__fill {
    transform: scale(1);
    opacity: 1;
  }

  .icon-slide-button__label {
    position: relative;
    z-index: 2;
    padding: 15px 0;
    font-size: 12px;
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
    transition: transform .4s cubic-bezier(.44, 0, .56, 1), color .4s cubic-bezier(.44, 0, .56, 1);
  }

  .icon-slide-button__icon {
    position: relative;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    margin-left: 20px;
    flex: 0 0 32px;
    overflow: hidden;
    border-radius: 50%;
    background: var(--button-icon-bg);
    color: var(--button-icon);
    transform: translateX(12px);
    opacity: 0;
    transition: transform .4s cubic-bezier(.44, 0, .56, 1), opacity .4s cubic-bezier(.44, 0, .56, 1), background .4s ease, color .4s ease;
  }

  .icon-slide-button__icon svg {
    width: 16px;
    height: 16px;
    transform: translateX(-7px);
    transition: transform .4s cubic-bezier(.44, 0, .56, 1);
  }

  .icon-slide-button:hover .icon-slide-button__icon,
  .icon-slide-button:focus-visible .icon-slide-button__icon {
    transform: translateX(0);
    opacity: 1;
  }

  .icon-slide-button:hover .icon-slide-button__icon svg,
  .icon-slide-button:focus-visible .icon-slide-button__icon svg {
    transform: translateX(0);
  }

  .icon-slide-button:hover .icon-slide-button__label,
  .icon-slide-button:focus-visible .icon-slide-button__label {
    transform: translateX(-2px);
  }

  .icon-slide-button:focus-visible {
    outline: 2px solid #1769d1;
    outline-offset: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .icon-slide-button,
    .icon-slide-button__fill,
    .icon-slide-button__label,
    .icon-slide-button__icon,
    .icon-slide-button__icon svg {
      transition: none;
    }
  }
</style>
