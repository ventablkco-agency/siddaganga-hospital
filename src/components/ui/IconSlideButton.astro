---
interface Props {
  href?: string;
  label?: string;
  newTab?: boolean;
  variant?: 'dark' | 'blue' | 'light';
}

const {
  href = '#',
  label = 'Book Appointment',
  newTab = false,
  variant = 'blue',
} = Astro.props;
---

<a
  class={`icon-slide-button icon-slide-button--${variant}`}
  href={href}
  target={newTab ? '_blank' : undefined}
  rel={newTab ? 'noopener noreferrer' : undefined}
  aria-label={label}
>
  <span class="icon-slide-button__label">{label}</span>
  <span class="icon-slide-button__icon" aria-hidden="true">
    <svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M3 8H12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
      <path d="M8.5 4.5L12 8L8.5 11.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </span>
</a>

<style>
  .icon-slide-button {
    --button-bg: #1769d1;
    --button-hover: #0d1015;
    --button-text: #ffffff;
    --button-icon: #1769d1;
    --button-icon-bg: #ffffff;

    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 56px;
    padding: 0 7px 0 26px;
    overflow: hidden;
    border-radius: 999px;
    background: var(--button-bg);
    color: var(--button-text);
    text-decoration: none;
    box-shadow: 0 14px 32px rgba(23, 105, 209, .18);
    isolation: isolate;
    transition: transform .45s cubic-bezier(.22, 1, .36, 1), box-shadow .45s cubic-bezier(.22, 1, .36, 1), background .45s ease;
  }

  .icon-slide-button::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: var(--button-hover);
    transform: translateX(-105%);
    transition: transform .55s cubic-bezier(.22, 1, .36, 1);
  }

  .icon-slide-button--dark {
    --button-bg: #0d1015;
    --button-hover: #1769d1;
    --button-icon: #0d1015;
    --button-icon-bg: #ffffff;
  }

  .icon-slide-button--light {
    --button-bg: #ffffff;
    --button-hover: #1769d1;
    --button-text: #10151c;
    --button-icon: #ffffff;
    --button-icon-bg: #10151c;
    box-shadow: 0 14px 32px rgba(18, 40, 66, .1);
  }

  .icon-slide-button:hover,
  .icon-slide-button:focus-visible {
    transform: translateY(-2px);
    box-shadow: 0 18px 38px rgba(23, 105, 209, .24);
  }

  .icon-slide-button:hover::before,
  .icon-slide-button:focus-visible::before {
    transform: translateX(0);
  }

  .icon-slide-button:active {
    transform: translateY(0) scale(.98);
  }

  .icon-slide-button__label {
    position: relative;
    z-index: 2;
    padding: 17px 0;
    font-size: 13px;
    font-weight: 600;
    line-height: 1;
    letter-spacing: -.01em;
    white-space: nowrap;
    transition: transform .45s cubic-bezier(.22, 1, .36, 1), color .35s ease;
  }

  .icon-slide-button__icon {
    position: relative;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    margin-left: 22px;
    flex: 0 0 42px;
    border-radius: 50%;
    background: var(--button-icon-bg);
    color: var(--button-icon);
    transform: translateX(0);
    transition: transform .45s cubic-bezier(.22, 1, .36, 1), background .35s ease, color .35s ease;
  }

  .icon-slide-button__icon svg {
    width: 17px;
    height: 17px;
    transition: transform .45s cubic-bezier(.22, 1, .36, 1);
  }

  .icon-slide-button:hover .icon-slide-button__label,
  .icon-slide-button:focus-visible .icon-slide-button__label {
    transform: translateX(-2px);
  }

  .icon-slide-button:hover .icon-slide-button__icon,
  .icon-slide-button:focus-visible .icon-slide-button__icon {
    transform: translateX(-1px) scale(1.04);
  }

  .icon-slide-button:hover .icon-slide-button__icon svg,
  .icon-slide-button:focus-visible .icon-slide-button__icon svg {
    transform: translateX(2px);
  }

  .icon-slide-button:focus-visible {
    outline: 2px solid #1769d1;
    outline-offset: 4px;
  }

  @media (max-width: 760px) {
    .icon-slide-button {
      min-height: 52px;
      padding-left: 22px;
    }

    .icon-slide-button__icon {
      width: 38px;
      height: 38px;
      flex-basis: 38px;
      margin-left: 18px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .icon-slide-button,
    .icon-slide-button::before,
    .icon-slide-button__label,
    .icon-slide-button__icon,
    .icon-slide-button__icon svg {
      transition: none;
    }
  }
</style>
