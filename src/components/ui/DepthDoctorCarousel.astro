---
interface Doctor {
  name: string;
  role: string;
  qualification: string;
}

interface Props {
  items: Doctor[];
}

const { items } = Astro.props;
---

<div class="depth-carousel" data-depth-carousel tabindex="0" aria-label="Our doctors">
  <div class="depth-stage" data-depth-stage>
    {items.map((doctor, index) => (
      <article
        class:list={['depth-card', index === 0 && 'is-active']}
        data-depth-card
        data-index={index}
        aria-hidden={index !== 0}
      >
        <div class="depth-photo">
          <div class="photo-orbit" aria-hidden="true"></div>
          <div class="photo-placeholder">
            <span>SGH</span>
            <small>Doctor portrait</small>
          </div>
          <span class="depth-number">0{index + 1}</span>
        </div>
        <div class="depth-info">
          <p class="depth-role">{doctor.role}</p>
          <h3>{doctor.name}</h3>
          <p class="depth-qualification">{doctor.qualification}</p>
        </div>
      </article>
    ))}
  </div>

  <div class="depth-controls" aria-label="Doctor carousel controls">
    <button type="button" data-depth-prev aria-label="Previous doctor">←</button>
    <span data-depth-count>01 / {String(items.length).padStart(2, '0')}</span>
    <button type="button" data-depth-next aria-label="Next doctor">→</button>
  </div>
</div>

<script>
  const initDepthDoctorCarousel = () => {
    document.querySelectorAll('[data-depth-carousel]').forEach((root) => {
      const cards = Array.from(root.querySelectorAll('[data-depth-card]'));
      const prev = root.querySelector('[data-depth-prev]');
      const next = root.querySelector('[data-depth-next]');
      const count = root.querySelector('[data-depth-count]');
      let active = 0;

      if (!cards.length) return;

      const render = () => {
        cards.forEach((card, index) => {
          const raw = (index - active + cards.length) % cards.length;
          const depth = raw;
          card.classList.remove('depth-0', 'depth-1', 'depth-2', 'depth-3', 'depth-hidden');
          card.classList.add(depth <= 3 ? `depth-${depth}` : 'depth-hidden');
          card.setAttribute('aria-hidden', depth === 0 ? 'false' : 'true');
        });
        if (count) count.textContent = `${String(active + 1).padStart(2, '0')} / ${String(cards.length).padStart(2, '0')}`;
      };

      const go = (direction) => {
        active = (active + direction + cards.length) % cards.length;
        render();
      };

      prev?.addEventListener('click', () => go(-1));
      next?.addEventListener('click', () => go(1));
      root.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowLeft') go(-1);
        if (event.key === 'ArrowRight') go(1);
      });

      let pointerStartX = 0;
      root.addEventListener('pointerdown', (event) => { pointerStartX = event.clientX; });
      root.addEventListener('pointerup', (event) => {
        const delta = event.clientX - pointerStartX;
        if (Math.abs(delta) > 45) go(delta < 0 ? 1 : -1);
      });

      render();
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initDepthDoctorCarousel, { once: true });
  } else {
    initDepthDoctorCarousel();
  }
</script>

<style>
  .depth-carousel {
    --blue: #2878ed;
    --ink: #101a2b;
    --muted: #71839d;
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 300px;
    outline: none;
    perspective: 1400px;
    touch-action: pan-y;
  }

  .depth-stage {
    position: absolute;
    inset: 0 0 48px;
    transform-style: preserve-3d;
  }

  .depth-card {
    position: absolute;
    top: 0;
    right: 0;
    width: min(300px, 43%);
    height: min(380px, 100%);
    min-height: 280px;
    border-radius: 18px;
    overflow: hidden;
    background: #fff;
    border: 1px solid rgba(255,255,255,.95);
    box-shadow: 0 22px 55px rgba(44, 73, 117, .14);
    transform-origin: right center;
    transform-style: preserve-3d;
    transition: transform .7s cubic-bezier(.22,1,.36,1), opacity .7s ease, filter .7s ease;
    will-change: transform, opacity;
  }

  .depth-0 { transform: translate3d(0, 0, 0) rotateY(0deg); opacity: 1; filter: none; z-index: 4; }
  .depth-1 { transform: translate3d(-18%, -1%, -220px) rotateY(-22deg); opacity: .92; filter: brightness(.91) blur(1px); z-index: 3; }
  .depth-2 { transform: translate3d(-36%, -2%, -440px) rotateY(-44deg); opacity: .68; filter: brightness(.76) blur(3px); z-index: 2; }
  .depth-3 { transform: translate3d(-54%, -3%, -660px) rotateY(-66deg); opacity: .38; filter: brightness(.62) blur(5px); z-index: 1; }
  .depth-hidden { transform: translate3d(-68%, -4%, -880px) rotateY(-78deg); opacity: 0; pointer-events: none; z-index: 0; }

  .depth-photo {
    position: absolute;
    inset: 0 0 29% 0;
    overflow: hidden;
    background:
      radial-gradient(circle at 72% 25%, rgba(40,120,237,.18), transparent 34%),
      linear-gradient(145deg, #f8fbff 0%, #dce9fb 100%);
  }

  .photo-orbit {
    position: absolute;
    width: 190px;
    height: 190px;
    right: -60px;
    top: -58px;
    border-radius: 50%;
    border: 1px solid rgba(40,120,237,.18);
    box-shadow: 0 0 0 28px rgba(40,120,237,.035), 0 0 0 58px rgba(40,120,237,.025);
  }

  .photo-placeholder {
    position: absolute;
    inset: 25px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
    color: #8da0b9;
  }

  .photo-placeholder span { color: var(--blue); font-size: 42px; font-weight: 700; letter-spacing: -.07em; line-height: 1; }
  .photo-placeholder small { margin-top: 6px; font-size: 8px; text-transform: uppercase; letter-spacing: .14em; }
  .depth-number { position: absolute; top: 18px; left: 18px; color: #2878ed; font-size: 12px; font-weight: 700; letter-spacing: .08em; }

  .depth-info {
    position: absolute;
    left: 10px;
    right: 10px;
    bottom: 10px;
    min-height: 25%;
    padding: 14px 15px;
    border-radius: 12px;
    background: rgba(255,255,255,.96);
    box-sizing: border-box;
  }

  .depth-role { margin: 0 0 5px; color: #8ca0bb; font-size: 8px; line-height: 1.2; }
  .depth-info h3 { margin: 0; color: var(--ink); font-family: var(--font-display); font-size: clamp(16px, 1.55vw, 22px); line-height: 1.02; letter-spacing: -.045em; }
  .depth-qualification { margin: 5px 0 0; color: #667992; font-size: 8px; line-height: 1.2; }

  .depth-controls {
    position: absolute;
    right: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    gap: 10px;
    color: #8091aa;
    font-size: 9px;
    letter-spacing: .08em;
  }

  .depth-controls button {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 1px solid rgba(40,120,237,.55);
    background: rgba(255,255,255,.7);
    color: var(--blue);
    cursor: pointer;
    display: grid;
    place-items: center;
    font: inherit;
    transition: transform .25s ease, background .25s ease;
  }

  .depth-controls button:hover { transform: translateY(-2px); background: #fff; }

  @media (max-width: 900px) {
    .depth-card { width: min(260px, 52%); }
    .depth-1 { transform: translate3d(-17%, -1%, -190px) rotateY(-22deg); }
    .depth-2 { transform: translate3d(-34%, -2%, -380px) rotateY(-44deg); }
    .depth-3 { transform: translate3d(-51%, -3%, -570px) rotateY(-66deg); }
  }

  @media (max-width: 640px) {
    .depth-carousel { min-height: 310px; height: 100%; }
    .depth-stage { inset: 0 0 42px; }
    .depth-card { top: 0; right: auto; left: 50%; width: min(245px, 76vw); height: 270px; min-height: 0; transform-origin: center center; }
    .depth-0 { transform: translate3d(-50%, 0, 0) rotateY(0deg); }
    .depth-1 { transform: translate3d(-24%, 4%, -150px) rotateY(-18deg) scale(.92); }
    .depth-2 { transform: translate3d(1%, 8%, -300px) rotateY(-35deg) scale(.84); }
    .depth-3 { transform: translate3d(25%, 12%, -450px) rotateY(-52deg) scale(.76); }
    .depth-hidden { transform: translate3d(40%, 15%, -600px) rotateY(-65deg) scale(.7); }
    .depth-photo { inset-bottom: 29%; }
    .depth-controls { right: 50%; transform: translateX(50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .depth-card, .depth-controls button { transition: none; }
  }
</style>
