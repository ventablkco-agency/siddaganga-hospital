---
import Icon from '../icons/Icon.astro';
const currentPath = Astro.url.pathname;

const links = [
  { label: 'About', href: '/about' },
  { label: 'Services', href: '/services' },
  { label: 'Doctors', href: '/doctors' },
  { label: 'Contact', href: '/contact' },
];
---

<header class="header">
  <a class="brand" href="/" aria-label="Siddaganga Hospital home">
    <img src="/assets/brand/siddaganga-hospital.svg" alt="Siddaganga Hospital" />
  </a>

  <nav class="desktop-nav" aria-label="Primary navigation">
    {links.map((link) => (
      <a href={link.href} class:list={{ active: currentPath === link.href }} aria-current={currentPath === link.href ? 'page' : undefined}>{link.label}</a>
    ))}
  </nav>

  <div class="header-actions">
    <a class="location-link" href="https://maps.app.goo.gl/QFri8RggV5JmZVpe9" target="_blank" rel="noreferrer" aria-label="Open Siddaganga Hospital location in Google Maps">
      <Icon name="location" size={18} strokeWidth={1.6} />
      <span>Ranebennur, Karnataka<br />581115</span>
    </a>
    <button class="menu-trigger" type="button" data-menu-toggle aria-label="Open menu" aria-expanded="false"><span></span><span></span><span></span></button>
  </div>
</header>

<style>
.header{position:fixed;inset:16px 0 auto;z-index:1500;height:88px;padding:0 clamp(28px,4vw,68px);display:flex;align-items:center;box-sizing:border-box;transform:translateY(0);transition:transform .42s cubic-bezier(.22,1,.36,1);will-change:transform}.header.header--hidden{transform:translateY(-130%)}.brand{display:block;width:clamp(128px,9.5vw,154px);flex:0 0 auto}.brand img{display:block;width:100%;height:auto}.desktop-nav{position:absolute;left:50%;transform:translateX(-50%);display:flex;align-items:center;gap:4px;padding:5px;border:1px solid rgba(15,30,50,.055);border-radius:999px;background:rgba(255,255,255,.58);backdrop-filter:blur(16px);box-shadow:0 10px 35px rgba(26,54,88,.045)}.desktop-nav a{min-width:92px;padding:13px 18px;border-radius:999px;color:#152238;text-align:center;font-size:12px;font-weight:500;transition:color .25s ease,background .25s ease,transform .25s ease}.desktop-nav a:hover,.desktop-nav a.active{color:#0c63ce;background:#fff;transform:translateY(-1px)}.header-actions{margin-left:auto;display:flex;align-items:center;gap:10px}.location-link{display:inline-flex;align-items:center;gap:9px;margin-right:4px;padding:0;border:0;border-radius:0;background:transparent!important;box-shadow:none!important;color:#0a0d14!important;-webkit-text-fill-color:#0a0d14;font-size:10px;line-height:1.35;letter-spacing:.01em;text-decoration:none;transition:color .25s ease,transform .25s ease,-webkit-text-fill-color .25s ease}.location-link:hover,.location-link:focus-visible,.location-link:active{background:transparent!important;box-shadow:none!important;color:#fff!important;-webkit-text-fill-color:#fff;text-decoration:none;transform:translateY(-1px)}.location-link svg{flex:0 0 auto}.location-link:hover svg,.location-link:focus-visible svg,.location-link:active svg{color:#fff!important}.menu-trigger{border:0;cursor:pointer;box-shadow:0 12px 30px rgba(10,13,20,.14);width:58px;height:58px;border-radius:50%;display:grid;place-content:center;background:#0a0d14;gap:5px}.menu-trigger span{display:block;width:19px;height:1.5px;background:#fff;transition:transform .35s ease,opacity .2s ease}.menu-trigger.is-open span:nth-child(1){transform:translateY(6.5px) rotate(45deg)}.menu-trigger.is-open span:nth-child(2){opacity:0}.menu-trigger.is-open span:nth-child(3){transform:translateY(-6.5px) rotate(-45deg)}
@media(max-width:1180px){.location-link{display:none}.desktop-nav a{min-width:auto;padding-inline:14px}}@media(max-width:760px){.header{inset:8px 0 auto;height:66px;padding:0 20px}.brand{width:116px}.desktop-nav{display:none}.menu-trigger{width:48px;height:48px}}
</style>

<script>
  const header = document.querySelector('.header');
  const trigger = document.querySelector('[data-menu-toggle]');
  const menu = document.querySelector('[data-menu]');
  const closeButtons = document.querySelectorAll('[data-menu-close], [data-menu-link]');
  const setMenu = (open: boolean) => { if (!trigger || !menu) return; trigger.classList.toggle('is-open', open); trigger.setAttribute('aria-expanded', String(open)); trigger.setAttribute('aria-label', open ? 'Close menu' : 'Open menu'); menu.classList.toggle('is-open', open); menu.setAttribute('aria-hidden', String(!open)); header?.classList.remove('header--hidden'); document.body.style.overflow = open ? 'hidden' : ''; };
  trigger?.addEventListener('click', () => setMenu(!menu?.classList.contains('is-open')));
  closeButtons.forEach((button) => button.addEventListener('click', () => setMenu(false)));
  document.addEventListener('keydown', (event) => { if (event.key === 'Escape') setMenu(false); });
  let lastScrollY = window.scrollY; let ticking = false;
  const updateHeaderVisibility = () => { if (!header) return; const currentY = window.scrollY; const menuOpen = menu?.classList.contains('is-open'); if (currentY <= 24 || menuOpen) header.classList.remove('header--hidden'); else if (currentY > lastScrollY + 4) header.classList.add('header--hidden'); else if (currentY < lastScrollY - 4) header.classList.remove('header--hidden'); lastScrollY = currentY; ticking = false; };
  window.addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(updateHeaderVisibility); } }, { passive: true });
</script>
