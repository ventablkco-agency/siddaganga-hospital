<header class="header">
  <a class="brand" href="#home" aria-label="Siddaganga Hospital home">
    <img src="/assets/brand/siddaganga-hospital.svg" alt="Siddaganga Hospital" />
  </a>

  <nav class="desktop-nav" aria-label="Primary navigation">
    <a href="#about">About</a>
    <a href="#services">Services</a>
    <a href="#doctors">Doctors</a>
    <a href="#contact">Contact</a>
  </nav>

  <div class="header-actions">
    <button class="search-button" type="button" aria-label="Search">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 5 5"></path></svg>
    </button>

    <button class="language-button" type="button" aria-label="Change language">
      <span>EN</span>
      <span class="language-divider"></span>
      <span>ಕನ್ನಡ</span>
    </button>

    <button class="menu-trigger" type="button" data-menu-toggle aria-label="Open menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<style>
.header {
  position: absolute;
  inset: 0 0 auto;
  z-index: 30;
  height: 104px;
  padding: 0 clamp(28px, 4vw, 68px);
  display: flex;
  align-items: center;
}

.brand {
  display: block;
  width: clamp(128px, 9.5vw, 154px);
  flex: 0 0 auto;
}

.brand img { display: block; width: 100%; height: auto; }

.desktop-nav {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  gap: 4px;
  padding: 5px;
  border: 1px solid rgba(15, 30, 50, .055);
  border-radius: 999px;
  background: rgba(255, 255, 255, .58);
  backdrop-filter: blur(16px);
  box-shadow: 0 10px 35px rgba(26, 54, 88, .045);
}

.desktop-nav a {
  min-width: 92px;
  padding: 13px 18px;
  border-radius: 999px;
  color: #152238;
  text-align: center;
  font-size: 12px;
  font-weight: 500;
  transition: color .25s ease, background .25s ease, transform .25s ease;
}

.desktop-nav a:hover {
  color: #0c63ce;
  background: #fff;
  transform: translateY(-1px);
}

.header-actions {
  margin-left: auto;
  display: flex;
  align-items: center;
  gap: 10px;
}

.search-button,
.language-button,
.menu-trigger {
  border: 1px solid rgba(20, 35, 55, .08);
  cursor: pointer;
  box-shadow: 0 8px 25px rgba(30, 58, 89, .055);
}

.search-button {
  width: 50px;
  height: 50px;
  border-radius: 50%;
  display: grid;
  place-content: center;
  background: rgba(255, 255, 255, .76);
  backdrop-filter: blur(12px);
}

.search-button svg {
  width: 18px;
  height: 18px;
  fill: none;
  stroke: #17253a;
  stroke-width: 1.7;
  stroke-linecap: round;
}

.language-button {
  min-width: 112px;
  height: 50px;
  padding: 0 17px;
  border-radius: 999px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 9px;
  color: #17253a;
  background: rgba(255, 255, 255, .76);
  backdrop-filter: blur(12px);
  font-family: inherit;
  font-size: 11px;
  font-weight: 600;
  transition: color .25s ease, background .25s ease, transform .25s ease;
}

.language-button:hover {
  color: #0c63ce;
  background: #fff;
  transform: translateY(-1px);
}

.language-divider {
  width: 1px;
  height: 15px;
  background: rgba(23, 37, 58, .18);
}

.menu-trigger {
  width: 58px;
  height: 58px;
  border: 0;
  border-radius: 50%;
  display: grid;
  place-content: center;
  background: #0a0d14;
  gap: 5px;
  box-shadow: 0 12px 30px rgba(10, 13, 20, .14);
}

.menu-trigger span {
  display: block;
  width: 19px;
  height: 1.5px;
  background: #fff;
  transition: transform .35s ease, opacity .2s ease;
}

.menu-trigger.is-open span:nth-child(1) { transform: translateY(6.5px) rotate(45deg); }
.menu-trigger.is-open span:nth-child(2) { opacity: 0; }
.menu-trigger.is-open span:nth-child(3) { transform: translateY(-6.5px) rotate(-45deg); }

@media (max-width: 1100px) {
  .desktop-nav a { min-width: auto; padding-inline: 14px; }
}

@media (max-width: 760px) {
  .header { height: 82px; padding: 0 20px; }
  .brand { width: 116px; }
  .desktop-nav { display: none; }
  .search-button,
  .language-button { display: none; }
  .menu-trigger { width: 48px; height: 48px; }
}
</style>

<script>
  const trigger = document.querySelector('[data-menu-toggle]');
  const menu = document.querySelector('[data-menu]');
  const closeButtons = document.querySelectorAll('[data-menu-close], [data-menu-link]');

  const setMenu = (open: boolean) => {
    if (!trigger || !menu) return;
    trigger.classList.toggle('is-open', open);
    trigger.setAttribute('aria-expanded', String(open));
    trigger.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    menu.classList.toggle('is-open', open);
    menu.setAttribute('aria-hidden', String(!open));
    document.body.style.overflow = open ? 'hidden' : '';
  };

  trigger?.addEventListener('click', () => setMenu(!menu?.classList.contains('is-open')));
  closeButtons.forEach((button) => button.addEventListener('click', () => setMenu(false)));
  document.addEventListener('keydown', (event) => { if (event.key === 'Escape') setMenu(false); });
</script>
