---
import {
  Activity, Ambulance, ArrowDown, ArrowLeft, ArrowRight, ArrowUpRight, Baby,
  CalendarDays, CheckCircle2, Clock3, Droplet, Ear, FlaskConical, GraduationCap,
  HeartPulse, Mail, MapPin, Menu, Microscope, MousePointer2, Pill, Phone, Quote,
  ScanLine, Scissors, Siren, Star, Stethoscope, Users, X,
} from 'lucide-astro';

interface Props { name: string; size?: number | string; strokeWidth?: number; label?: string; class?: string; }
const { name, size = 20, strokeWidth = 1.8, label, class: className } = Astro.props;
const common = { size, strokeWidth, class: className, 'aria-hidden': label ? undefined : true, 'aria-label': label };
const socialAttrs = { width: size, height: size, class: className, 'aria-hidden': label ? undefined : true, 'aria-label': label };
---
{ name === 'activity' && <Activity {...common} /> }
{ name === 'ambulance' && <Ambulance {...common} /> }
{ name === 'arrow-down' && <ArrowDown {...common} /> }
{ name === 'arrow-left' && <ArrowLeft {...common} /> }
{ name === 'arrow-right' && <ArrowRight {...common} /> }
{ name === 'external-link' && <ArrowUpRight {...common} /> }
{ name === 'baby' && <Baby {...common} /> }
{ name === 'calendar' && <CalendarDays {...common} /> }
{ name === 'check-circle' && <CheckCircle2 {...common} /> }
{ name === 'clock' && <Clock3 {...common} /> }
{ name === 'diabetes' && <Droplet {...common} /> }
{ name === 'ent' && <Ear {...common} /> }
{ name === 'laboratory' && <FlaskConical {...common} /> }
{ name === 'qualification' && <GraduationCap {...common} /> }
{ name === 'cardiology' && <HeartPulse {...common} /> }
{ name === 'email' && <Mail {...common} /> }
{ name === 'location' && <MapPin {...common} /> }
{ name === 'menu' && <Menu {...common} /> }
{ name === 'diagnostics' && <Microscope {...common} /> }
{ name === 'drag' && <MousePointer2 {...common} /> }
{ name === 'pharmacy' && <Pill {...common} /> }
{ name === 'phone' && <Phone {...common} /> }
{ name === 'quote' && <Quote {...common} /> }
{ name === 'xray' && <ScanLine {...common} /> }
{ name === 'surgery' && <Scissors {...common} /> }
{ name === 'emergency' && <Siren {...common} /> }
{ name === 'star' && <Star {...common} /> }
{ name === 'medicine' && <Stethoscope {...common} /> }
{ name === 'users' && <Users {...common} /> }
{ name === 'close' && <X {...common} /> }
{ name === 'instagram' && <svg {...socialAttrs} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="4" /><circle cx="12" cy="12" r="3.5" /><circle cx="17.2" cy="6.8" r=".9" fill="currentColor" stroke="none" /></svg> }
{ name === 'facebook' && <svg {...socialAttrs} viewBox="0 0 24 24" fill="currentColor"><path d="M13.5 21v-8h2.7l.4-3h-3.1V8.1c0-.9.3-1.6 1.7-1.6h1.8V3.8c-.3 0-1.4-.1-2.6-.1-2.6 0-4.3 1.6-4.3 4.4V10H7.4v3h2.7v8h3.4Z" /></svg> }
{ name === 'whatsapp' && <svg {...socialAttrs} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3.2a8.7 8.7 0 0 0-7.5 13l-1 3.6 3.7-1A8.8 8.8 0 1 0 12 3.2Z" /><path d="M9.2 8.7c-.2.2-.6.7-.6 1.5s.6 1.8.7 1.9c.1.1 1.2 2 3.1 2.8.5.2.9.3 1.2.3.5.1.9.1 1.2-.3.2-.3.4-.8.4-1.1 0-.2-.1-.3-.3-.4l-1.3-.6c-.2-.1-.3-.1-.5.1l-.6.7c-.1.1-.2.2-.4.1-.2-.1-.8-.3-1.5-.9-.6-.5-1-1.2-1.1-1.4-.1-.2 0-.3.1-.4l.4-.5c.1-.1.1-.3.2-.4 0-.1 0-.2-.1-.4l-.5-1.2c-.1-.3-.3-.3-.5-.3h-.4Z" /></svg> }
