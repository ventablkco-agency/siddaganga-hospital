---
import '../styles/tokens.css';
import '../styles/typography.css';
import '../styles/palette.css';
import '../styles/hero-responsive.css';
import '../styles/gallery-gap-fix.css';
import SiteShell from '../components/layout/SiteShell.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = 'Siddaganga Hospital · Ranebennur',
  description = 'Siddaganga Hospital · Ranebennur — specialist care, advanced diagnostics and 24×7 emergency support.',
  image,
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#EBF0FE" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Siddaganga Hospital" />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400..600&family=Manrope:wght@400..800&family=Noto+Sans+Kannada:wght@400..700&display=swap" />
  </head>
  <body>
    <SiteShell>
      <slot />
    </SiteShell>
    <script>
      document.querySelectorAll<HTMLImageElement>('.service-image').forEach((img) => {
        img.addEventListener('error', () => {
          if (img.dataset.fallbackApplied) return;
          img.dataset.fallbackApplied = 'true';
          const webpPath = img.getAttribute('src') || '';
          const fallbackPath = webpPath.replace(/\.webp$/i, '.svg');
          if (fallbackPath !== webpPath) img.src = fallbackPath;
        }, { once: true });
      });
    </script>
  </body>
</html>