---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import MedicalTicker from '../components/sections/MedicalTicker.astro';
import SectionTwo from '../components/sections/SectionTwo.astro';
import SectionThree from '../components/sections/SectionThree.astro';
import SectionFour from '../components/sections/SectionFour.astro';
import SectionFive from '../components/sections/SectionFive.astro';
import HospitalGallery from '../components/sections/HospitalGallery.astro';
import SectionSix from '../components/sections/SectionSix.astro';
---

<Layout>
  <main>
    <Hero />

    <section class="section-two-flow" aria-label="Siddaganga Hospital introduction">
      <MedicalTicker />
      <SectionTwo />
    </section>

    <SectionThree />
    <SectionFour />
    <SectionFive />
    <HospitalGallery />
    <SectionSix />
  </main>
</Layout>

<style>
  .section-two-flow {
    min-height: 82svh;
    height: auto;
    display: grid;
    grid-template-rows: 78px minmax(0, 1fr);
    overflow: hidden;
    background: #eef7ff;
  }

  @media (max-width: 760px) {
    .section-two-flow {
      min-height: auto;
      grid-template-rows: 64px auto;
      overflow: visible;
    }
  }
</style>
