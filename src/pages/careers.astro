---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Careers · Siddaganga Hospital" description="Explore career opportunities at Siddaganga Hospital, Ranebennur.">
  <main class="careers-page">
    <section class="careers-hero" aria-labelledby="careers-title">
      <span class="eyebrow">{ Join Siddaganga }</span>
      <h1 id="careers-title">Build a career<br /><strong>that cares.</strong></h1>
      <p>Great healthcare is built by people who bring expertise, empathy, and responsibility to every patient. We are building a team that believes the same.</p>
      <a class="career-cta" href="mailto:siddagangahospitalrnr@gmail.com?subject=Career%20Enquiry%20-%20Siddaganga%20Hospital">Send your profile <span>↗</span></a>
    </section>

    <section class="careers-content" aria-label="Careers information">
      <div class="content-intro">
        <span class="eyebrow">{ Work with us }</span>
        <h2>People first.<br /><strong>Always.</strong></h2>
      </div>
      <div class="content-copy">
        <p>We welcome qualified healthcare professionals, clinical support teams, and hospital operations talent who want to contribute to thoughtful, patient-first care in Ranebennur.</p>
        <p>We do not currently publish individual vacancies on this page. If you would like to be considered for a future opportunity, send your CV and a short introduction to our team.</p>
        <div class="career-contact">
          <span>CAREER ENQUIRIES</span>
          <a href="mailto:siddagangahospitalrnr@gmail.com">siddagangahospitalrnr@gmail.com</a>
          <a href="tel:+919591799099">+91 95917 99099</a>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
.careers-page{background:#f7f9fc;color:#101a2b;min-height:100svh}.careers-hero{position:relative;min-height:72svh;display:flex;flex-direction:column;justify-content:center;padding:clamp(110px,14vw,180px) clamp(24px,8vw,120px) clamp(80px,9vw,120px);box-sizing:border-box;overflow:hidden;background:#ebf0fe}.careers-hero:after{content:'';position:absolute;width:48vw;height:48vw;right:-15vw;bottom:-28vw;border-radius:50%;background:radial-gradient(circle,rgba(23,100,245,.2),rgba(23,100,245,0) 70%);pointer-events:none}.eyebrow{position:relative;z-index:1;color:#7f94b4;font-size:12px;font-weight:600;letter-spacing:.09em}.careers-hero h1{position:relative;z-index:1;margin:20px 0 22px;max-width:900px;font-family:var(--font-display);font-size:clamp(64px,9vw,132px);line-height:.88;letter-spacing:-.075em;font-weight:700}.careers-hero h1 strong{font-weight:400}.careers-hero>p{position:relative;z-index:1;max-width:590px;margin:0 0 30px;color:#667891;font-size:16px;line-height:1.55}.career-cta{position:relative;z-index:1;display:inline-flex;align-items:center;justify-content:space-between;gap:30px;width:max-content;padding:14px 18px 14px 20px;border-radius:999px;background:#1764f5;color:#fff;text-decoration:none;font-size:13px;font-weight:600;box-shadow:0 12px 30px rgba(23,100,245,.2)}.career-cta span{font-size:18px}.careers-content{max-width:1280px;margin:0 auto;padding:clamp(80px,10vw,140px) clamp(24px,6vw,80px);display:grid;grid-template-columns:1fr 1.1fr;gap:clamp(45px,9vw,130px)}.content-intro h2{margin:18px 0 0;font-family:var(--font-display);font-size:clamp(48px,6vw,82px);line-height:.9;letter-spacing:-.065em}.content-intro h2 strong{font-weight:400}.content-copy{max-width:620px;color:#60718a;font-size:15px;line-height:1.7}.content-copy p{margin:0 0 20px}.career-contact{margin-top:40px;padding-top:20px;border-top:1px solid #dce4f0;display:flex;flex-direction:column;gap:8px}.career-contact span{margin-bottom:4px;color:#8b9bb1;font-size:10px;letter-spacing:.1em;font-weight:700}.career-contact a{color:#1764f5;text-decoration:none;font-size:14px;font-weight:600}.career-contact a:hover{text-decoration:underline}
@media(max-width:760px){.careers-hero{min-height:auto;padding:120px 24px 78px}.careers-hero h1{font-size:clamp(58px,15vw,92px)}.careers-hero>p{font-size:14px}.careers-content{grid-template-columns:1fr;gap:42px;padding:76px 24px 100px}.content-copy{font-size:14px}.career-contact{margin-top:32px}}
@media(max-width:390px){.careers-hero{padding-inline:20px}.careers-hero h1{font-size:54px}.careers-hero>p{font-size:13px}.career-cta{width:100%;box-sizing:border-box}.careers-content{padding-inline:20px}}
</style>
